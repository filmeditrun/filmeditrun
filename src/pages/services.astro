---
// =====================================================================
// SERVICES PAGE (Page copy in src/content/pages/services.json;
// Service items in src/content/services/*.json)
// =====================================================================
import Layout from '../layouts/Layout.astro';
import servicesPage from '../content/pages/services.json';

interface ServiceCard {
  order: string;
  slug?: string;
  title: string;
  description: string;
  tag: string;
  link: string;
  displayAs?: "local-video" | "link-video" | "image" | "gradient" | "none" | string;
  localVideoPath?: string;
  cloudVideoUrl?: string;
  imagePath?: string;
  heroGradientDirection?: string;
  heroGradientColor1?: string;
  heroGradientColor2?: string;
  deliverables?: Array<{
    tag?: string;
    title: string;
    description?: string;
  }>;
}

const serviceFiles = import.meta.glob<ServiceCard>("../content/services/*.json", {
  eager: true,
  import: "default",
});

const services = Object.values(serviceFiles)
  .map((s) => ({ ...s, id: s.order }))
  .sort((a, b) => a.order.localeCompare(b.order, undefined, { numeric: true }));

const defaultWatermarks = [
  "/cambridge/stage-wide.webp",
  "/work/onlocation.webp",
  "/og-image.jpg",
  "/work/handheld.webp",
  "/work/onlocation.webp",
  "/work/handheld.webp",
];

// Maximum cards shown on initial load (2 rows of 3 columns = 6 cards)
const INITIAL_LIMIT = 6;
const hasMore = services.length > INITIAL_LIMIT;

// Process section content from services.json
const processTag = servicesPage.processTag || "Workflow Architecture";
const processHeading = servicesPage.processHeading || "The Production Process.";
const processDescription = servicesPage.processDescription || "A disciplined, four-stage pipeline designed to eliminate on-site friction, protect tight corporate deadlines, and deliver broadcast-grade visuals every time.";
const processSteps = servicesPage.processSteps || [];

// Bottom CTA content from services.json
const ctaTag = servicesPage.ctaTag || "READY FOR THE NEXT TAKE?";
const ctaHeading = servicesPage.ctaHeading || "Have an Upcoming Event or Production Brief?";
const ctaText = servicesPage.ctaText || "Tell us about your event dates, venue location, or creative ideas. We deliver a tailored technical production proposal within 24 hours.";
const ctaButtonLabel = servicesPage.ctaButtonLabel || "Start Project Brief";
const ctaButtonLink = servicesPage.ctaButtonLink || "/contact";
// =====================================================================
---

<Layout title={servicesPage.seoTitle} description={servicesPage.description}>
  
  <!-- Header Section -->
  <header class="max-w-7xl mx-auto px-6 pt-12 pb-16 text-center md:text-left">
    <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold block mb-3">{servicesPage.headerTag}</span>
    <h1 class="text-4xl md:text-6xl font-black tracking-tight text-white mb-4">{servicesPage.heading}</h1>
    <p class="text-neutral-400 max-w-xl text-lg leading-relaxed mx-auto md:mx-0 font-light">{servicesPage.description}</p>
  </header>

  <!-- 3-Column Bento Services Grid Section (Text Above, Widescreen Media Below) -->
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <!-- Zero-JS Pure CSS Expansion Controller -->
    {hasMore && (
      <input 
        type="checkbox" 
        id="expand-services" 
        class="peer sr-only" 
        aria-label="Expand all services"
      />
    )}

    <!-- Top Utility Bar: Services Dropdown (Aligned above Card 03) -->
    <div class="flex items-center justify-end pb-6 mb-6 border-b border-neutral-800/60 relative z-40">
      <!-- Zero-JS Services Dropdown (<details>) -->
      <div class="relative">
        <details class="group/dropdown relative">
          <summary class="list-none [&::-webkit-details-marker]:hidden inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full text-xs uppercase font-mono tracking-wider font-semibold bg-neutral-900/90 hover:bg-neutral-850 text-neutral-300 border border-neutral-800 hover:border-amber-500/50 hover:text-white transition-all duration-200 cursor-pointer select-none shadow-md">
            <span>Explore our Services</span>
            <svg class="w-3.5 h-3.5 text-amber-500 transition-transform duration-200 group-open/dropdown:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>

          <!-- Dropdown Flyout Panel -->
          <div class="absolute right-0 top-full mt-2.5 w-72 sm:w-84 rounded-2xl bg-[#0c0c11]/95 border border-neutral-800/90 backdrop-blur-2xl shadow-2xl z-50 p-2 overflow-hidden">
            <div class="px-3.5 py-2.5 border-b border-neutral-800/80 text-[10px] uppercase font-mono tracking-widest text-neutral-400 flex items-center justify-between">
              <span>Full Service Roster</span>
              <span class="text-amber-500 font-semibold">Direct Jump</span>
            </div>
            
            <div class="py-1.5 max-h-84 overflow-y-auto divide-y divide-neutral-900/60">
              {services.map((service, idx) => (
                <a
                  href={service.link}
                  class="group/item flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-neutral-900/90 transition-colors"
                >
                  <div class="flex items-center gap-3 min-w-0 pr-3">
                    <span class="text-[11px] font-mono font-bold text-amber-500/70 group-hover/item:text-amber-400 shrink-0">
                      {String(idx + 1).padStart(2, '0')}
                    </span>
                    <span class="text-sm font-medium text-neutral-200 group-hover/item:text-white truncate">
                      {service.title}
                    </span>
                  </div>
                  <span class="text-xs text-neutral-500 group-hover/item:text-amber-400 group-hover/item:translate-x-0.5 transition-all shrink-0">
                    &rarr;
                  </span>
                </a>
              ))}
            </div>
          </div>
        </details>
      </div>
    </div>

    <div id="services-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      
      {services.map((service, index) => (
        <a 
          href={service.link} 
          class:list={[
            "group relative flex flex-col justify-between rounded-2xl border border-neutral-800 bg-neutral-900/60 p-7 sm:p-8 transition-all duration-300 hover:border-amber-500/50 hover:shadow-2xl hover:shadow-amber-500/5 hover:-translate-y-1.5 overflow-hidden",
            index >= INITIAL_LIMIT && "service-card-extra"
          ]}
        >
          <!-- Ambient Watermark & Atmospheric Glow Layer -->
          <div class="absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
            <!-- Cinema Photo Watermark (Full Natural Color) -->
            <img 
              src={service.imagePath && service.imagePath !== "/og-image.jpg" ? service.imagePath : defaultWatermarks[index % defaultWatermarks.length]} 
              alt="" 
              loading="lazy" 
              decoding="async" 
              class="w-full h-full object-cover contrast-110 opacity-25 group-hover:opacity-40 group-hover:scale-105 transition-all duration-700 ease-out" 
            />
            <!-- Theme-Adaptive Scrim Mask: Solid behind typography, opening up toward the top-right -->
            <div class="absolute inset-0 bg-gradient-to-tr from-neutral-950 via-neutral-950/80 to-neutral-950/40"></div>
          </div>

          <!-- Card Content (Elevated above watermark) -->
          <div class="relative z-10 flex flex-col justify-between h-full">
            <div>
              <!-- Tag Pill (No numbers) -->
              <div class="flex items-center justify-between gap-4 mb-4">
                <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-[10px] font-mono uppercase tracking-widest text-amber-400 font-medium">
                  {service.tag}
                </span>
              </div>

              <!-- Service Title -->
              <h2 class="text-xl sm:text-2xl font-black text-white group-hover:text-amber-400 transition-colors tracking-tight leading-snug mb-3">
                {service.title}
              </h2>

              <!-- Service Description -->
              <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
                {service.description}
              </p>
            </div>

            <!-- Bottom Action Prompt -->
            <div class="pt-6 mt-6 border-t border-white/10 flex items-center justify-between text-xs font-mono text-neutral-400 group-hover:text-amber-400 transition-colors">
              <span>Explore Service</span>
              <span class="group-hover:translate-x-1.5 transition-transform font-bold">&rarr;</span>
            </div>
          </div>
        </a>
      ))}

    </div>

    {/* Part 1 Option 1: Zero-JS CSS Expand Label for Services beyond 6 */}
    {hasMore && (
      <div class="expand-btn-container mt-12 text-center">
        <label
          for="expand-services"
          class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full text-xs uppercase font-mono tracking-widest font-semibold bg-neutral-900 text-neutral-300 border border-neutral-800 hover:border-amber-500/50 hover:text-white hover:bg-neutral-850 transition-all duration-300 shadow-lg cursor-pointer select-none"
        >
          <span class="btn-label-more inline-flex items-center gap-2">
            Explore All Services ({services.length})
            <span class="text-amber-500 font-bold">&darr;</span>
          </span>
          <span class="btn-label-less hidden items-center gap-2">
            Show Less
            <span class="text-amber-500 font-bold">&uarr;</span>
          </span>
        </label>
      </div>
    )}
  </section>

  <!-- ============================================================== -->
  <!-- MID-PAGE FULL-BLEED PARALLAX IMMERSION BREAK (Option 1)        -->
  <!-- ============================================================== -->
  <section 
    data-cinema-darkroom
    class="relative w-full py-20 sm:py-28 lg:py-36 bg-scroll lg:bg-fixed bg-center bg-cover select-none text-white overflow-hidden"
    style="background-image: url('/work/onlocation.webp');"
  >
    <!-- Dark Cinema Scrim Overlay -->
    <div class="absolute inset-0 bg-black/75 pointer-events-none" aria-hidden="true"></div>

    <!-- Protected Darkroom Content Wrapper (Preserves pure white text in all 3 color grades) -->
    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center bg-transparent">
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1] mb-6 text-white keep-white">
        Zero on-site friction. <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-amber-500">Broadcast-grade delivery.</span>
      </h2>
      <p class="text-neutral-200 text-base sm:text-lg lg:text-xl font-light max-w-2xl mx-auto leading-relaxed keep-white">
        From discreet executive interviews to multi-stage conference productions across Cambridge, London, and the UK.
      </p>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- PRODUCTION PROCESS (HOW IT WORKS) - CONTRAST STUDIO STAGE      -->
  <!-- ============================================================== -->
  {processSteps && processSteps.length > 0 && (
    <section class="relative w-full py-20 sm:py-28 border-y border-neutral-800/80 bg-neutral-900/40 overflow-hidden">
      <!-- Ambient Studio Atmosphere Mesh -->
      <div class="absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[350px] bg-amber-500/5 rounded-full blur-[120px]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(232,197,71,0.06),transparent)]"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-6">
        <!-- Section Header -->
        <div class="text-center md:text-left mb-16 sm:mb-20">
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold block mb-3">
            {processTag}
          </span>
          <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-4">
            {processHeading}
          </h2>
          <p class="text-neutral-400 max-w-2xl text-base sm:text-lg leading-relaxed font-light mx-auto md:mx-0">
            {processDescription}
          </p>
        </div>

        <!-- Horizontal Timeline Rail (Clean Nodes - No Timecodes) -->
        <div class="relative">
          <!-- Connecting Rail Line (Desktop: Horizontal) -->
          <div 
            class="hidden lg:block absolute top-7 left-12 right-12 h-0.5 bg-gradient-to-r from-neutral-800 via-amber-500/40 to-neutral-800 z-0 pointer-events-none" 
            aria-hidden="true"
          />

          <!-- Step Grid (1 col mobile, 2 cols tablet, 4 cols desktop) -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-6 relative z-10">
            {processSteps.map((step) => (
              <div class="group relative flex flex-col bg-neutral-950/70 hover:bg-neutral-950/95 border border-neutral-800/80 hover:border-amber-500/50 rounded-2xl p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-amber-500/10 backdrop-blur-sm">
                
                <!-- Top Node & Stage Tag -->
                <div class="flex items-center justify-between mb-6">
                  <!-- Step Number Node -->
                  <div class="w-14 h-14 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-center font-mono font-bold text-amber-400 text-lg shadow-inner group-hover:border-amber-500/60 group-hover:text-amber-300 transition-all duration-300">
                    {step.step}
                  </div>

                  <!-- Stage Category Pill -->
                  <span class="text-[11px] uppercase tracking-wider font-mono text-neutral-400 font-medium bg-neutral-900/80 border border-neutral-800/80 px-2.5 py-1 rounded-md">
                    {step.tag}
                  </span>
                </div>

                <!-- Step Title -->
                <h3 class="text-lg sm:text-xl font-bold text-white mb-3 tracking-tight group-hover:text-amber-400 transition-colors duration-300">
                  {step.title}
                </h3>

                <!-- Step Description -->
                <p class="text-neutral-400 text-sm leading-relaxed font-light">
                  {step.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ============================================================== -->
  <!-- HIGH-CONVERTING BOTTOM STUDIO COMMISSION DOCK                  -->
  <!-- ============================================================== -->
  <section class="relative py-20 sm:py-28 overflow-hidden bg-neutral-950 border-t border-neutral-900">
    <!-- Ambient gold glow backdrop -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-140 h-70 bg-amber-500/10 rounded-full blur-[140px] pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      
      <!-- Top Slate Tag -->
      <div class="inline-flex items-center gap-2 mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
          {ctaTag}
        </span>
      </div>

      <!-- Headline -->
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-6 leading-tight">
        {ctaHeading}
      </h2>

      <!-- Description -->
      <p class="text-base sm:text-lg text-neutral-400 font-light leading-relaxed max-w-2xl mx-auto mb-10">
        {ctaText}
      </p>

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={ctaButtonLink}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-mono font-bold text-sm uppercase tracking-wider hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xl shadow-amber-500/10"
        >
          <span>{ctaButtonLabel}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>

        <a
          href="/work"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl border border-neutral-800 bg-neutral-900/60 text-neutral-300 font-mono text-sm tracking-wider hover:text-white hover:border-neutral-700 hover:bg-neutral-900 transition-all"
        >
          <span>Explore Selected Work</span>
        </a>
      </div>

      <!-- Studio Dispatch Locations Footer -->
      <div class="mt-12 pt-8 border-t border-neutral-900/80 flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-xs font-mono text-neutral-500">
        <span>● London Base</span>
        <span>● Cambridge Studio</span>
        <span>● UK-Wide & Global Dispatch</span>
      </div>

    </div>
  </section>

</Layout>

<style>
  /* ============================================================== */
  /* ZERO-JS CSS EXPANSION CONTROLLER                               */
  /* ============================================================== */
  .service-card-extra {
    display: none;
  }

  #expand-services:checked ~ #services-grid .service-card-extra {
    display: flex;
  }

  #expand-services:checked ~ .expand-btn-container .btn-label-more {
    display: none;
  }

  #expand-services:checked ~ .expand-btn-container .btn-label-less {
    display: inline-flex;
  }
</style>
