---
// =====================================================================
// SERVICES PAGE (Page copy in src/content/pages/services.json;
// Service items in src/content/services/*.json)
// =====================================================================
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaSection from '../components/CtaSection.astro';
import servicesPage from '../content/pages/services.json';

interface ServiceCard {
  order: string;
  slug?: string;
  title: string;
  description: string;
  tag: string;
  link: string;
  // Bento Card Visuals
  cardDisplayAs?: "image" | "video" | "gradient" | "solid" | string;
  cardImage?: string;
  cardVideoPath?: string;
  cardSolidColor?: string;
  cardGradientDirection?: string;
  cardGradientColor1?: string;
  cardGradientColor2?: string;
  cardTextContrast?: "auto" | "light" | "dark" | string;
  // Subpage Hero Visuals
  heroDisplayAs?: "image" | "video" | "gradient" | "solid" | "none" | string;
  heroImage?: string;
  heroVideoPath?: string;
  heroSolidColor?: string;
  heroGradientDirection?: string;
  heroGradientColor1?: string;
  heroGradientColor2?: string;
  heroTextContrast?: "auto" | "light" | "dark" | string;
  // Legacy compatibility fallbacks
  displayAs?: string;
  localVideoPath?: string;
  cloudVideoUrl?: string;
  imagePath?: string;
  deliverables?: Array<{
    tag?: string;
    title: string;
    description?: string;
  }>;
}

const serviceFiles = import.meta.glob<ServiceCard>("../content/services/*.json", {
  eager: true,
  import: "default",
});

const services = Object.values(serviceFiles)
  .map((s) => ({ ...s, id: s.order }))
  .sort((a, b) => a.order.localeCompare(b.order, undefined, { numeric: true }));

// Maximum cards shown on initial load (2 rows of 3 columns = 6 cards)
const INITIAL_LIMIT = 6;
const hasMore = services.length > INITIAL_LIMIT;

// Process section content from services.json
const processTag = servicesPage.processTag || "Workflow Architecture";
const processHeading = servicesPage.processHeading || "The Production Process.";
const processDescription = servicesPage.processDescription || "A disciplined, four-stage pipeline designed to eliminate on-site friction, protect tight corporate deadlines, and deliver broadcast-grade visuals every time.";
const processSteps = servicesPage.processSteps || [];

// Bottom CTA content from services.json
const ctaTag = servicesPage.ctaTag || "READY FOR THE NEXT TAKE?";
const ctaHeading = servicesPage.ctaHeading || "Have an Upcoming Event or Production Brief?";
const ctaText = servicesPage.ctaText || "Tell us about your event dates, venue location, or creative ideas. We deliver a tailored technical production proposal within 24 hours.";
const ctaButtonLabel = servicesPage.ctaButtonLabel || "Start Project Brief";
const ctaButtonLink = servicesPage.ctaButtonLink || "/contact";

// Asterisk gradient parser
const parseHeading = (text: string) => {
  if (!text) return "";
  return text.replace(/\*(.*?)\*/g, '<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">$1</span>');
};

// parseHeadingWithLine: Solid Text with Animated Gradient Underline (used on in-page sections)
const parseHeadingWithLine = (text: string) => {
  if (!text) return "";
  if (text.includes('*')) {
    return text.replace(/\*(.*?)\*/g, '<span class="animated-accent-underline">$1</span>');
  }
  return text;
};

const displayAs = (servicesPage as any).displayAs || "local-video";
const isVideo = displayAs === "video" || displayAs === "local-video";
const isImage = displayAs === "image";
const isGradient = displayAs === "gradient";
const isSolid = displayAs === "solid";

const localVideoPath = (servicesPage as any).localVideoPath || "/showreel.mp4";
const imagePath = (servicesPage as any).imagePath || "/cambridge/stage-wide.webp";
const heroSolidColor = (servicesPage as any).heroSolidColor || "#09090c";
const heroGradientDirection = (servicesPage as any).heroGradientDirection || "to bottom right";
const heroGradientColor1 = (servicesPage as any).heroGradientColor1 || "#180d2b";
const heroGradientColor2 = (servicesPage as any).heroGradientColor2 || "#09090c";
const isRadial = heroGradientDirection === "radial";
const gradientStyle = isRadial
  ? `background: radial-gradient(circle at center, ${heroGradientColor1} 0%, ${heroGradientColor2} 100%);`
  : `background: linear-gradient(${heroGradientDirection}, ${heroGradientColor1} 0%, ${heroGradientColor2} 100%);`;
// =====================================================================
---

<Layout 
  title={servicesPage.seoTitle} 
  description={(servicesPage as any).seoDescription || servicesPage.description}
  fullBleed={true}
>
  
  <!-- ============================================================== -->
  <!-- 1. CINEMATIC HERO BANNER (Standardized Service Page Architecture) -->
  <!-- ============================================================== -->
  <header data-cinema-darkroom class="relative w-full pt-28 pb-14 sm:pt-36 sm:pb-24 lg:pt-40 lg:pb-28 sm:min-h-[600px] lg:min-h-[640px] flex flex-col justify-center overflow-hidden border-b border-white/10 select-none">
    
    <!-- Video / Photo Media Backdrop Layer (Clear, vibrant background) -->
    <div class="absolute inset-0 z-0 bg-neutral-950 pointer-events-none overflow-hidden">
      <!-- Master Cinematic ND Filter (Guaranteed AA Contrast Across Video Feeds) -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/60 to-black/90 z-10 pointer-events-none" aria-hidden="true"></div>

      <!-- Ambient Amber Spotlight Glow at Top Center -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[40rem] sm:w-[56rem] h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none z-10" aria-hidden="true"></div>

      {/* Video Background */}
      {isVideo && (
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={imagePath}
          class="absolute inset-0 w-full h-full object-cover opacity-90 sm:opacity-95 z-0"
        >
          <source src={localVideoPath} type="video/mp4" />
        </video>
      )}

      {/* Static Image Background */}
      {isImage && imagePath && (
        <img
          src={imagePath}
          alt="FilmEditRun Services"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover opacity-80 sm:opacity-85 z-0"
        />
      )}

      {/* Dual-Tone Gradient Background */}
      {isGradient && (
        <div
          class="absolute inset-0 w-full h-full z-0"
          style={gradientStyle}
          aria-hidden="true"
        />
      )}

      {/* Solid Color Background */}
      {isSolid && (
        <div
          class="absolute inset-0 w-full h-full z-0"
          style={`background-color: ${heroSolidColor};`}
          aria-hidden="true"
        />
      )}
    </div>

    <!-- Main Banner Content -->
    <div class="relative z-20 max-w-6xl mx-auto px-6 w-full">
      
      <!-- Eyebrow Category Tag (Site-Wide Standard) -->
      <div class="inline-flex items-center gap-2 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
          {servicesPage.headerTag || "SERVICES"}
        </span>
      </div>

      <!-- Large Title with Asterisk Gradient Support -->
      <h1 
        class="text-4xl sm:text-6xl lg:text-7xl font-black text-white keep-white tracking-tight leading-[1.08] mb-6 max-w-4xl text-balance"
        set:html={parseHeading(servicesPage.heading)}
      />

      <!-- Hero Lead Hook / Value Proposition -->
      <p class="text-base sm:text-lg lg:text-xl text-neutral-300 font-normal leading-relaxed tracking-[-0.01em] max-w-2xl mb-8">
        {servicesPage.description}
      </p>

      <!-- Primary Action -->
      <div>
        <a
          href="/contact"
          class="inline-block bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold px-8 py-3.5 rounded-xl text-base transition-all shadow-xl shadow-amber-500/20 hover:scale-[1.02] text-center"
        >
          Start Project Brief &rarr;
        </a>
      </div>

    </div>

  </header>

  <!-- 3-Column Bento Services Grid Section (Text Above, Widescreen Media Below) -->
  <section id="services-roster" class="max-w-7xl mx-auto px-6 pt-12 sm:pt-16 pb-24">
    <!-- Zero-JS Pure CSS Expansion Controller -->
    {hasMore && (
      <input 
        type="checkbox" 
        id="expand-services" 
        class="peer sr-only" 
        aria-label="Expand all services"
      />
    )}

    <!-- Top Utility Bar: Services Dropdown (Aligned above Card 03) -->
    <div class="flex items-center justify-end pb-6 mb-6 border-b border-neutral-800/60 relative z-40">
      <!-- Zero-JS Services Dropdown (<details>) -->
      <div class="relative">
        <details class="group/dropdown relative">
          <summary class="list-none [&::-webkit-details-marker]:hidden inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full text-xs uppercase font-mono tracking-wider font-semibold bg-neutral-900/90 hover:bg-neutral-850 text-neutral-300 border border-neutral-800 hover:border-amber-500/50 hover:text-white transition-all duration-200 cursor-pointer select-none shadow-md">
            <span>Explore our Services</span>
            <svg class="w-3.5 h-3.5 text-amber-500 transition-transform duration-200 group-open/dropdown:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>

          <!-- Dropdown Flyout Panel -->
          <div class="absolute right-0 top-full mt-2.5 w-72 sm:w-84 rounded-2xl bg-[#0c0c11]/95 border border-neutral-800/90 backdrop-blur-2xl shadow-2xl z-50 p-2 overflow-hidden">
            <div class="px-3.5 py-2.5 border-b border-neutral-800/80 text-[10px] uppercase font-mono tracking-widest text-neutral-400 flex items-center justify-between">
              <span>Full Service Roster</span>
              <span class="text-amber-500 font-semibold">Direct Jump</span>
            </div>
            
            <div class="py-1.5 max-h-84 overflow-y-auto divide-y divide-neutral-900/60">
              {services.map((service, idx) => (
                <a
                  href={service.link}
                  class="group/item flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-neutral-900/90 transition-colors"
                >
                  <div class="flex items-center gap-3 min-w-0 pr-3">
                    <span class="text-[11px] font-mono font-bold text-amber-500/70 group-hover/item:text-amber-400 shrink-0">
                      {String(idx + 1).padStart(2, '0')}
                    </span>
                    <span class="text-sm font-medium text-neutral-200 group-hover/item:text-white truncate">
                      {service.title}
                    </span>
                  </div>
                  <span class="text-xs text-neutral-500 group-hover/item:text-amber-400 group-hover/item:translate-x-0.5 transition-all shrink-0">
                    &rarr;
                  </span>
                </a>
              ))}
            </div>
          </div>
        </details>
      </div>
    </div>

    <div id="services-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {services.map((service, index) => (
        <ServiceCard 
          service={service} 
          index={index} 
          headingLevel="h2"
          class={index >= INITIAL_LIMIT ? "service-card-extra" : undefined}
        />
      ))}
    </div>

    {/* Part 1 Option 1: Zero-JS CSS Expand Label for Services beyond 6 */}
    {hasMore && (
      <div class="expand-btn-container mt-12 text-center">
        <label
          for="expand-services"
          class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full text-xs uppercase font-mono tracking-widest font-semibold bg-neutral-900 text-neutral-300 border border-neutral-800 hover:border-amber-500/50 hover:text-white hover:bg-neutral-850 transition-all duration-300 shadow-lg cursor-pointer select-none"
        >
          <span class="btn-label-more inline-flex items-center gap-2">
            Explore All Services ({services.length})
            <span class="text-amber-500 font-bold">&darr;</span>
          </span>
          <span class="btn-label-less hidden items-center gap-2">
            Show Less
            <span class="text-amber-500 font-bold">&uarr;</span>
          </span>
        </label>
      </div>
    )}
  </section>

  <!-- ============================================================== -->
  <!-- MID-PAGE FULL-BLEED PARALLAX IMMERSION BREAK                   -->
  <!-- ============================================================== -->
  <section 
    data-cinema-darkroom
    class="relative w-full py-24 sm:py-32 lg:py-40 bg-scroll lg:bg-fixed bg-center bg-cover select-none text-white overflow-hidden"
    style="background-image: url('/work/onlocation.webp');"
  >
    <!-- Dark Cinema Scrim Overlay -->
    <div class="absolute inset-0 bg-black/75 pointer-events-none" aria-hidden="true"></div>

    <!-- Protected Darkroom Content Wrapper (Preserves pure white text in all 3 color grades) -->
    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center bg-transparent">
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1] text-white keep-white">
        Precision with <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">passion.</span>
      </h2>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- PRODUCTION PROCESS (HOW IT WORKS) - 4-STAGE METHODOLOGY        -->
  <!-- ============================================================== -->
  {processSteps && processSteps.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 py-20 sm:py-28">
      
      <!-- Section Header with Direct Timeline Briefing Button -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 sm:mb-16 border-b border-line pb-8">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
              {processTag}
            </span>
          </div>
          <h2 
            class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight"
            set:html={parseHeadingWithLine(processHeading)}
          />
          <p class="text-neutral-400 text-sm sm:text-base max-w-xl mt-3 font-light leading-relaxed">
            {processDescription}
          </p>
        </div>
        <div class="shrink-0">
          <a 
            href="/contact" 
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/5 border border-line hover:border-amber-500/50 hover:bg-white/10 text-xs font-mono tracking-wider uppercase text-white transition-all duration-200 group shadow-lg"
          >
            <span>Discuss Your Timeline →</span>
          </a>
        </div>
      </div>

      <!-- Horizontal Timeline Rail (Clean Nodes - No Timecodes) -->
      <div class="relative">
        <!-- Connecting Rail Line (Desktop: Horizontal) -->
        <div 
          class="hidden lg:block absolute top-7 left-12 right-12 h-0.5 bg-gradient-to-r from-neutral-800 via-amber-500/40 to-neutral-800 z-0 pointer-events-none" 
          aria-hidden="true"
        />

        <!-- Step Grid (1 col mobile, 2 cols tablet, 4 cols desktop) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-6 relative z-10">
          {processSteps.map((step) => (
            <div class="group relative flex flex-col bg-neutral-950/70 hover:bg-neutral-950/95 border border-neutral-800/80 hover:border-amber-500/50 rounded-2xl p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-amber-500/10 backdrop-blur-sm">
              
              <!-- Top Node & Stage Tag -->
              <div class="flex items-center justify-between mb-6">
                <!-- Step Number Node -->
                <div class="w-14 h-14 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-center font-mono font-bold text-amber-400 text-lg shadow-inner group-hover:border-amber-500/60 group-hover:text-amber-300 transition-all duration-300">
                  {step.step}
                </div>

                <!-- Stage Category Pill -->
                <span class="text-[11px] uppercase tracking-wider font-mono text-neutral-400 font-medium bg-neutral-900/80 border border-neutral-800/80 px-2.5 py-1 rounded-md">
                  {step.tag}
                </span>
              </div>

              <!-- Step Title -->
              <h3 class="text-lg sm:text-xl font-bold text-white mb-3 tracking-tight group-hover:text-amber-400 transition-colors duration-300">
                {step.title}
              </h3>

              <!-- Step Description -->
              <p class="text-neutral-400 text-sm leading-relaxed font-light">
                {step.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============================================================== -->
  <!-- HIGH-CONVERTING BOTTOM STUDIO COMMISSION DOCK                  -->
  <!-- ============================================================== -->
  <CtaSection
    tag={ctaTag}
    heading={ctaHeading}
    description={ctaText}
    primaryButtonLabel={`${ctaButtonLabel} →`}
    primaryButtonLink={ctaButtonLink}
    trustSignals={[
      "Transparent Project Scope",
      "Direct Filmmaker Collaboration",
      "Cambridge & London Hubs"
    ]}
  />

</Layout>

<style>
  /* ============================================================== */
  /* ZERO-JS CSS EXPANSION CONTROLLER                               */
  /* ============================================================== */
  .service-card-extra {
    display: none;
  }

  #expand-services:checked ~ #services-grid .service-card-extra {
    display: block;
  }

  #expand-services:checked ~ .expand-btn-container .btn-label-more {
    display: none;
  }

  #expand-services:checked ~ .expand-btn-container .btn-label-less {
    display: inline-flex;
  }
</style>
