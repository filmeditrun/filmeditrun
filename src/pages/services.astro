---
// =====================================================================
// SERVICES PAGE (Page copy in src/content/pages/services.json;
// Service items in src/content/services/*.json)
// =====================================================================
import Layout from '../layouts/Layout.astro';
import servicesPage from '../content/pages/services.json';

interface ServiceCard {
  order: string;
  title: string;
  description: string;
  tag: string;
  link: string;
  displayAs?: "local-video" | "link-video" | "image" | "none";
  localVideoPath?: string;
  cloudVideoUrl?: string;
  imagePath?: string;
}

const serviceFiles = import.meta.glob<ServiceCard>("../content/services/*.json", {
  eager: true,
  import: "default",
});

const services = Object.values(serviceFiles)
  .map((s) => ({ ...s, id: s.order }))
  .sort((a, b) => a.order.localeCompare(b.order, undefined, { numeric: true }));
// =====================================================================
---

<Layout title={servicesPage.seoTitle} description={servicesPage.description}>
  
  <!-- Header Section -->
  <header class="max-w-7xl mx-auto px-6 pt-12 pb-16 text-center md:text-left">
    <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold block mb-3">{servicesPage.headerTag}</span>
    <h1 class="text-4xl md:text-6xl font-black tracking-tight text-white mb-4">{servicesPage.heading}</h1>
    <p class="text-neutral-400 max-w-xl text-lg leading-relaxed mx-auto md:mx-0">{servicesPage.description}</p>
  </header>

  <!-- 2-Column Clean Grid Section -->
  <section class="max-w-7xl mx-auto px-6 pb-28">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
      
      {services.map((service) => (
        <a 
          href={service.link} 
          class="group flex flex-col rounded-2xl border border-neutral-800 bg-neutral-900 overflow-hidden transition-all duration-300 hover:border-amber-500/50 hover:shadow-2xl hover:shadow-amber-500/5 hover:-translate-y-1.5"
        >
          <!-- Top Media Showcase Container -->
          {service.displayAs && (service.displayAs as string) !== "none" && (service.imagePath || service.localVideoPath || service.cloudVideoUrl) && (
            <div class="relative w-full aspect-16/10 overflow-hidden bg-black select-none border-b border-neutral-800/80">
              
              {/* OPTION 1 & 2: DEFERRED VIDEO LOOP SETUP (LOCAL OR CLOUD) */}
              {(service.displayAs === "local-video" || service.displayAs === "link-video") && (
                <video
                  loop
                  muted
                  playsinline
                  preload="none"
                  poster={service.imagePath}
                  data-video-src={service.displayAs === "local-video" ? service.localVideoPath : service.cloudVideoUrl}
                  class="service-preview-video w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-out"
                >
                </video>
              )}

              {/* OPTION 3: PLAIN IMAGE SETUP */}
              {service.displayAs === "image" && service.imagePath && (
                <img
                  src={service.imagePath}
                  alt={service.title}
                  loading="lazy"
                  class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-out"
                />
              )}

              <!-- Corner Roseram Arrow -->
              <div class="absolute top-4 right-4 pointer-events-none z-10">
                <span class="text-neutral-300 group-hover:text-amber-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300 text-sm leading-none bg-neutral-950/75 backdrop-blur-md w-8 h-8 rounded-full border border-white/10 flex items-center justify-center shadow-lg">
                  &nearr;
                </span>
              </div>
            </div>
          )}

          <!-- Bottom Text Container -->
          <div class="flex-1 flex flex-col justify-between p-6 sm:p-8">
            <div>
              <h3 class="text-2xl sm:text-3xl font-bold text-white mb-3 tracking-tight group-hover:text-amber-400 transition-colors duration-300 leading-snug">
                {service.title}
              </h3>
              <p class="text-neutral-400 text-sm sm:text-base leading-relaxed line-clamp-3 font-light mb-6">
                {service.description}
              </p>
            </div>

            <!-- Bottom Action Row -->
            <div class="pt-4 flex items-center justify-between border-t border-neutral-800/80 text-xs font-mono text-neutral-400 group-hover:text-amber-400 transition-colors duration-300">
              <span class="font-medium">Explore Pipeline</span>
              <span class="transform group-hover:translate-x-1.5 transition-transform duration-300 text-sm" aria-hidden="true">&rarr;</span>
            </div>
          </div>
        </a>
      ))}

    </div>
  </section>
</Layout>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    const videos = document.querySelectorAll('video.service-preview-video');

    const loadVideo = (video: Element) => {
      const vid = video as HTMLVideoElement;
      const src = vid.dataset.videoSrc;
      if (src && !vid.src) {
        vid.src = src;
        vid.load();
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            loadVideo(video);
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { rootMargin: '100px 0px', threshold: 0.25 }
    );

    videos.forEach((video) => observer.observe(video));
  }
</script>
