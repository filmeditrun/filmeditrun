---
// =====================================================================
// SERVICES PAGE (Page copy in src/content/pages/services.json;
// Service items in src/content/services/*.json)
// =====================================================================
import Layout from '../layouts/Layout.astro';
import servicesPage from '../content/pages/services.json';

interface ServiceCard {
  order: string;
  title: string;
  description: string;
  tag: string;
  link: string;
  displayAs: "local-video" | "link-video" | "image";
  localVideoPath?: string;
  cloudVideoUrl?: string;
  imagePath: string;
}

const serviceFiles = import.meta.glob<ServiceCard>("../content/services/*.json", {
  eager: true,
  import: "default",
});

const services = Object.values(serviceFiles)
  .map((s) => ({ ...s, id: s.order }))
  .sort((a, b) => a.order.localeCompare(b.order, undefined, { numeric: true }));
// =====================================================================
---

<Layout title={servicesPage.seoTitle} description={servicesPage.description}>
  
  <!-- Header Section -->
  <header class="max-w-7xl mx-auto px-6 pt-12 pb-16 text-center md:text-left">
    <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold block mb-3">{servicesPage.headerTag}</span>
    <h1 class="text-4xl md:text-6xl font-black tracking-tight text-white mb-4">{servicesPage.heading}</h1>
    <p class="text-neutral-400 max-w-xl text-lg leading-relaxed mx-auto md:mx-0">{servicesPage.description}</p>
  </header>

  <!-- Uniform Clean Grid Section -->
  <section class="max-w-7xl mx-auto px-6 pb-28">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      {services.map((service) => (
        <a 
          href={service.link} 
          class="group relative rounded-2xl border border-neutral-800 bg-neutral-900 p-6 sm:p-8 flex flex-col justify-between min-h-[340px] sm:h-[380px] overflow-hidden transition-all duration-300 hover:border-amber-500/50 hover:shadow-2xl hover:shadow-amber-500/5 hover:-translate-y-1"
        >
          <!-- Automated Media Background Layer -->
          <div class="absolute inset-0 w-full h-full z-0 bg-black">
            <!-- Protective Text Contrast Overlay Layer -->
            <div class="absolute inset-0 w-full h-full z-10 bg-gradient-to-t from-neutral-950/95 via-neutral-950/70 to-neutral-950/40"></div>
            
            {/* OPTION 1 & 2: DEFERRED VIDEO LOOP SETUP (LOCAL OR CLOUD) */}
            {(service.displayAs === "local-video" || service.displayAs === "link-video") && (
              <video
                loop
                muted
                playsinline
                preload="none"
                poster={service.imagePath}
                data-video-src={service.displayAs === "local-video" ? service.localVideoPath : service.cloudVideoUrl}
                class="service-preview-video w-full h-full object-cover opacity-40 group-hover:opacity-60 group-hover:scale-105 transition-all duration-700"
              >
              </video>
            )}

            {/* OPTION 3: PLAIN IMAGE SETUP */}
            {service.displayAs === "image" && (
              <img src={service.imagePath} alt={service.title} loading="lazy" class="w-full h-full object-cover opacity-40 group-hover:opacity-60 group-hover:scale-105 transition-all duration-700" />
            )}
          </div>

          <!-- Top Tag Layer -->
          <div class="relative z-20 flex justify-between items-start">
            <span class="text-[11px] font-mono text-amber-500 uppercase tracking-widest bg-neutral-950/60 backdrop-blur px-3 py-1 rounded-full border border-neutral-800">
              {service.id} &bull; {service.tag}
            </span>
            <span class="text-neutral-500 group-hover:text-amber-400 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300">&nearr;</span>
          </div>

          <!-- Content Presentation Layer -->
          <div class="relative z-20 pointer-events-none w-full mt-12 sm:mt-0">
            <h3 class="text-xl md:text-2xl font-bold text-white mb-3 tracking-tight group-hover:text-amber-400 transition-colors">{service.title}</h3>
            <p class="text-neutral-400 text-sm leading-relaxed line-clamp-3 sm:line-clamp-2">{service.description}</p>
            <div class="pt-4 flex items-center gap-1.5 text-xs font-mono text-amber-500 font-medium group-hover:translate-x-1 transition-transform">
              <span>Explore Pipeline</span>
              <span>&rarr;</span>
            </div>
          </div>
        </a>
      ))}

    </div>
  </section>
</Layout>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    const videos = document.querySelectorAll<HTMLVideoElement>('video.service-preview-video');

    const loadVideo = (video: HTMLVideoElement) => {
      const src = video.dataset.videoSrc;
      if (src && !video.src) {
        video.src = src;
        video.load();
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            loadVideo(video);
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { rootMargin: '100px 0px', threshold: 0.25 }
    );

    videos.forEach((video) => observer.observe(video));
  }
</script>
