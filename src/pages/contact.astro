---
import Layout from '../layouts/Layout.astro';
import contact from '../content/pages/contact.json';

const seoTitle = contact.seoTitle || "Start Your Project | FilmEditRun";
const seoDescription = contact.seoDescription || "Tell us about your upcoming filming, editing, or creative project.";
const formEndpoint = contact.formEndpoint || "https://formtorch.com/f/YOUR_FORMTORCH_KEY";
const redirectUrl = contact.redirectUrl || "";
const enableTurnstile = Boolean(contact.enableTurnstile && contact.turnstileSiteKey);
const turnstileSiteKey = contact.turnstileSiteKey || "";

interface ServiceEntry {
  order?: string;
  title: string;
}

// Dynamically import all services from TinaCMS collection for 100% automated sync
const serviceFiles = import.meta.glob<ServiceEntry>('../content/services/*.json', {
  eager: true,
  import: 'default',
});

const dynamicServices = Object.values(serviceFiles)
  .sort((a, b) => (a.order || "").localeCompare(b.order || "", undefined, { numeric: true }))
  .map((s) => ({ label: s.title, value: s.title }));

const serviceOptions = dynamicServices.length > 0
  ? dynamicServices
  : (contact.serviceOptions && contact.serviceOptions.length > 0
      ? contact.serviceOptions
      : [
          { label: "Filming", value: "Filming" },
          { label: "Editing", value: "Editing" },
          { label: "Filming & Editing (Full Production)", value: "Filming and Editing" },
          { label: "Animation & Motion Design", value: "Animation and Motion Design" }
        ]);

const formSteps = [
  {
    id: "name",
    type: "text",
    tag: contact.step1Tag || "01 ➔ Introduce Yourself",
    title: contact.step1Title || "What is your first and surname? *",
    inputType: "text",
    nameAttr: "name",
    placeholder: contact.step1Placeholder || "Type your full name here...",
    required: true
  },
  {
    id: "service",
    type: "radio",
    tag: contact.step2Tag || "02 ➔ Project Requirement",
    title: contact.step2Title || "What service do you need? *",
    options: serviceOptions
  },
  {
    id: "email",
    type: "text",
    tag: contact.step3Tag || "03 ➔ Reachable Contact",
    title: contact.step3Title || "What is your contact email address? *",
    inputType: "email",
    nameAttr: "email",
    placeholder: contact.step3Placeholder || "name@company.com",
    required: true
  },
  {
    id: "message",
    type: "textarea",
    tag: contact.step4Tag || "04 ➔ Project Brief",
    title: contact.step4Title || "How can we help? *",
    helpText: (contact as any).step4HelpText || "",
    nameAttr: "message",
    placeholder: contact.step4Placeholder || "Tell us about your event, dates, or visual goals...",
    required: true
  },
  {
    id: "verification",
    type: "final",
    tag: contact.step5Tag || "05 ➔ Verification & Consent",
    title: contact.step5Title || "Final Step *",
    gdprText: contact.gdprText || "I consent to having this website store my submitted information so they can respond to my inquiry.",
    enableTurnstile,
    turnstileSiteKey,
    submitButtonLabel: contact.submitButtonLabel || "Submit Brief"
  }
];

// Asterisk gradient parser
const parseHeading = (text: string) => {
  if (!text) return "";
  return text.replace(/\*(.*?)\*/g, '<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">$1</span>');
};

const headerTag = (contact as any).headerTag || "Start A Brief";
const heading = (contact as any).heading || "Let's discuss your next *production.*";
const description = (contact as any).description || "Tell us about your upcoming dates, venue location, or visual goals. We deliver a clear technical production scope and transparent quote within 24 hours.";

const displayAs = (contact as any).displayAs || "gradient";
const localVideoPath = (contact as any).localVideoPath || "/showreel.mp4";
const imagePath = (contact as any).imagePath || "/og-image.jpg";
const heroSolidColor = (contact as any).heroSolidColor || "#09090c";
const heroGradientDirection = (contact as any).heroGradientDirection || "to bottom right";
const heroGradientColor1 = (contact as any).heroGradientColor1 || "#180d2b";
const heroGradientColor2 = (contact as any).heroGradientColor2 || "#09090c";
const isRadial = heroGradientDirection === "radial";
const gradientStyle = isRadial
  ? `background: radial-gradient(circle at center, ${heroGradientColor1} 0%, ${heroGradientColor2} 100%);`
  : `background: linear-gradient(${heroGradientDirection}, ${heroGradientColor1} 0%, ${heroGradientColor2} 100%);`;
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  fullBleed={true}
>
  {enableTurnstile && (
    <Fragment slot="head">
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    </Fragment>
  )}

  <!-- ============================================================== -->
  <!-- 1. CINEMATIC HERO BANNER (Standardized Hero Architecture)       -->
  <!-- ============================================================== -->
  <header data-cinema-darkroom class="relative w-full pt-32 pb-20 sm:pt-40 sm:pb-28 overflow-hidden border-b border-white/10 select-none">
    
    <!-- Media Backdrop Layer -->
    <div class="absolute inset-0 z-0 bg-neutral-950 pointer-events-none overflow-hidden">
      <!-- Master Cinematic ND Filter -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/60 to-black/90 z-10 pointer-events-none" aria-hidden="true"></div>

      <!-- Ambient Amber Spotlight Glow at Top Center -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[40rem] sm:w-[56rem] h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none z-10" aria-hidden="true"></div>

      {/* Video Background */}
      {(displayAs === "local-video" || displayAs === "video") && (
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={imagePath}
          class="absolute inset-0 w-full h-full object-cover opacity-90 sm:opacity-95 z-0"
        >
          <source src={localVideoPath} type="video/mp4" />
        </video>
      )}

      {/* Static Image Background */}
      {displayAs === "image" && imagePath && (
        <img
          src={imagePath}
          alt="FilmEditRun Contact"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover opacity-80 sm:opacity-85 z-0"
        />
      )}

      {/* Dual-Tone Gradient Background */}
      {displayAs === "gradient" && (
        <div
          class="absolute inset-0 w-full h-full z-0"
          style={gradientStyle}
          aria-hidden="true"
        />
      )}

      {/* Solid Color Background */}
      {displayAs === "solid" && (
        <div
          class="absolute inset-0 w-full h-full z-0"
          style={`background-color: ${heroSolidColor};`}
          aria-hidden="true"
        />
      )}
    </div>

    <!-- Main Banner Content (Centered Optical Alignment) -->
    <div class="relative z-20 max-w-4xl mx-auto px-6 text-center">
      
      <!-- Breadcrumb Navigation & Category Badge -->
      <nav aria-label="Breadcrumb" class="inline-flex items-center justify-center gap-2 text-xs font-mono tracking-wider text-neutral-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="text-neutral-600">/</span>
        <span class="text-amber-500 font-semibold">{headerTag}</span>
      </nav>

      <!-- Large Title with Asterisk Gradient Support -->
      <h1 
        class="text-4xl sm:text-6xl lg:text-7xl font-black text-white keep-white tracking-tight leading-[1.08] mb-6 mx-auto max-w-3xl"
        set:html={parseHeading(heading)}
      />

      <!-- Value Proposition / Introductory Paragraph -->
      <p class="text-base sm:text-lg lg:text-xl text-neutral-300 font-normal leading-relaxed max-w-2xl mx-auto mb-8">
        {description}
      </p>

      <!-- Primary Action -->
      <div class="flex justify-center">
        <a
          href="#brief-form"
          class="inline-block bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold px-8 py-3.5 rounded-xl text-base transition-all shadow-xl shadow-amber-500/20 hover:scale-[1.02] text-center"
        >
          Start Your Project Brief &darr;
        </a>
      </div>

    </div>

  </header>

  <!-- ============================================================== -->
  <!-- 2. INTERACTIVE BRIEF FORM (Pitch Obsidian Studio Stage)        -->
  <!-- ============================================================== -->
  <section 
    id="brief-form" 
    data-cinema-darkroom="true"
    class="relative w-full border-t border-white/10 contact-form-stage pt-12 sm:pt-16 pb-20 sm:pb-28 overflow-hidden select-none scroll-mt-6 sm:scroll-mt-8"
  >
    <!-- Top Hairline Amber Highlight Rule across Full Section Width -->
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-amber-400/80 to-transparent pointer-events-none z-20" aria-hidden="true"></div>
    <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-transparent via-amber-500/25 to-transparent blur-xs pointer-events-none z-20" aria-hidden="true"></div>

    <!-- White Studio Arc Spotlight Beam at Top Center -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[44rem] sm:w-[64rem] h-[26rem] contact-spotlight-beam pointer-events-none z-10" aria-hidden="true"></div>

    <!-- Centered Form Container (Cardless, Breathable) -->
    <div class="relative z-20 max-w-2xl mx-auto px-6">
      
      <!-- Visual Step Progress Bar -->
      <div class="w-full bg-white/10 h-1.5 rounded-full mb-8 overflow-hidden" aria-hidden="true">
        <div id="stepProgressBar" class="h-full bg-gradient-to-r from-amber-400 to-amber-600 transition-all duration-300 w-1/5 rounded-full"></div>
      </div>

      <!-- Stepped Form Component (100% original inputs, zero container box) -->
      <form id="typeform" action={formEndpoint} method="POST" class="w-full flex flex-col justify-between gap-6 sm:gap-8 select-text">
        <!-- Anti-Spam Honeypot (Invisible to humans, traps bots) -->
        <input type="text" name="_gotcha" style="display:none !important" tabindex="-1" autocomplete="off" />

        {redirectUrl && (
          <input type="hidden" name="_next" value={redirectUrl} />
        )}

        <div class="grid grid-cols-1 items-center min-h-[190px] sm:min-h-[220px]">
      
      {formSteps.map((step, index) => (
        <div class={`step col-start-1 row-start-1 transition-opacity duration-300 w-full flex flex-col justify-center ${index === 0 ? 'opacity-100 pointer-events-auto z-10' : 'opacity-0 pointer-events-none z-0'}`}>
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold mb-2 block">{step.tag}</span>
          <h2 class="text-2xl md:text-3xl font-bold text-white keep-white mb-4 sm:mb-6 pr-4 leading-tight">{step.title}</h2>

          {step.type === "text" && (
            <>
              <input 
                type={step.inputType} 
                name={step.nameAttr} 
                required={step.required} 
                placeholder={step.placeholder} 
                class="w-full bg-transparent border-b-2 border-neutral-700 focus:border-amber-500 text-xl md:text-3xl py-2 sm:py-3 outline-none text-white keep-white transition-colors placeholder:text-neutral-500" 
              />
              {step.nameAttr === 'name' && <p class="text-xs text-neutral-400 keep-white mt-3 font-mono hidden sm:block">Press ENTER or click Next</p>}
            </>
          )}

          {step.type === "radio" && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-3">
              {step.options.map((opt, optIdx) => (
                <label class="border border-neutral-800 rounded-xl p-3 sm:p-3.5 flex items-center gap-3 cursor-pointer hover:border-amber-500/50 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-500/10 bg-neutral-900/40 transition-colors">
                  <input type="radio" name="required_service" value={opt.value} required={optIdx === 0} class="accent-amber-500 w-5 h-5 flex-shrink-0" />
                  <span class="text-sm sm:text-base text-neutral-200 keep-white">{opt.label}</span>
                </label>
              ))}
            </div>
          )}

          {step.type === "textarea" && (
            <>
              {step.helpText && (
                <div class="mb-4 p-3.5 rounded-xl border border-amber-500/20 bg-amber-500/5 text-xs font-mono text-neutral-300 keep-white leading-relaxed flex items-start gap-2.5">
                  <span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 font-bold text-[10px] uppercase tracking-wider shrink-0">BRIEF TIP</span>
                  <span>{step.helpText}</span>
                </div>
              )}
              <textarea 
                name={step.nameAttr} 
                required={step.required} 
                rows="3" 
                placeholder={step.placeholder} 
                class="w-full bg-transparent border-b-2 border-neutral-700 focus:border-amber-500 text-lg md:text-2xl py-2 outline-none text-white keep-white transition-colors resize-none placeholder:text-neutral-500" 
              ></textarea>
            </>
          )}

          {step.type === "final" && (
            <div class="space-y-4">
              <label class="flex items-start gap-3 p-3 border border-neutral-800 rounded-xl bg-neutral-900/30 cursor-pointer hover:border-neutral-700 transition-colors">
                <input type="checkbox" name="gdpr_consent" required class="accent-amber-500 w-5 h-5 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-300 keep-white text-xs sm:text-sm leading-relaxed">
                  {step.gdprText.includes("Privacy Policy") ? (
                    <>
                      {step.gdprText.split("Privacy Policy")[0]}
                      <a href="/privacy" target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:text-amber-300 underline underline-offset-4 font-medium">Privacy Policy</a>
                      {step.gdprText.split("Privacy Policy").slice(1).join("Privacy Policy")}
                    </>
                  ) : (
                    step.gdprText
                  )}
                </span>
              </label>

              {step.enableTurnstile && step.turnstileSiteKey && (
                <div class="cf-turnstile scale-90 origin-left" data-theme="dark" data-sitekey={step.turnstileSiteKey}></div>
              )}

              <button type="submit" class="w-full sm:w-auto bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold px-8 py-3.5 rounded-xl text-base transition-colors shadow-xl shadow-amber-500/20 cursor-pointer">
                {step.submitButtonLabel}
              </button>
            </div>
          )}
        </div>
      ))}
      </div>

      <!-- Inline Mobile-Safe Step Controls & Progress Indicator -->
      <div class="flex items-center justify-between border-t border-white/10 pt-6">
        <span id="stepCounter" class="font-mono text-xs uppercase tracking-widest text-neutral-400 keep-white">
          Step 01 / 0{formSteps.length}
        </span>
        <div class="flex gap-3">
          <button type="button" id="prevBtn" class="bg-neutral-900 border border-neutral-800 text-neutral-400 hover:text-white px-4 py-3 rounded-xl opacity-50 cursor-not-allowed transition-all text-sm sm:text-base">
            ← Back
          </button>
          <button type="button" id="nextBtn" class="bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold px-6 py-3 rounded-xl transition-all text-sm sm:text-base cursor-pointer shadow-lg shadow-amber-500/15">
            Next →
          </button>
        </div>
      </div>
    </form>
  </div>
</section>
</Layout>

<style>
  /* 1. Base Stage Atmosphere: Pitch Obsidian Black (Zero gray haze) */
  .contact-form-stage {
    background-color: #000000;
    background-image: linear-gradient(to bottom, #040406 0%, #000000 100%);
  }

  /* 2. Top-Edge Stage Spotlight Beam: Pure Studio White Arc Lamp */
  .contact-spotlight-beam {
    background: radial-gradient(
      ellipse 55% 45% at 50% 0%, 
      rgba(255, 255, 255, 0.16) 0%, 
      rgba(255, 255, 255, 0.035) 40%, 
      transparent 70%
    );
  }

  /* -------------------------------------------------------------------------
     SUPERNOVA GRADE ADAPTATION: Electric Neon Rose & Magenta Flare
     ------------------------------------------------------------------------- */
  :global(:is(html[data-theme="supernova"], html:has(#theme-choice-supernova:checked))) .contact-form-stage {
    background-color: #000000 !important;
    background-image: linear-gradient(to bottom, #06020c 0%, #000000 100%) !important;
  }
  :global(:is(html[data-theme="supernova"], html:has(#theme-choice-supernova:checked))) .contact-spotlight-beam {
    background: radial-gradient(
      ellipse 55% 45% at 50% 0%, 
      rgba(244, 63, 94, 0.28) 0%, 
      rgba(139, 92, 246, 0.08) 40%, 
      transparent 70%
    ) !important;
  }
</style>

<!-- Multi-Step Interactivity (Safe for View Transitions) -->
<script>
  function initForm() {
    let currentStep = 0;
    const steps = document.querySelectorAll('.step');
    const nextBtn = document.getElementById('nextBtn');
    const prevBtn = document.getElementById('prevBtn');
    const stepCounter = document.getElementById('stepCounter');
    const form = document.getElementById('typeform');

    if (!form || steps.length === 0) return;

    function updateForm(shouldFocus = false) {
      steps.forEach((step, index) => {
        if (index === currentStep) {
          step.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
          step.classList.add('opacity-100', 'pointer-events-auto', 'z-10');
          if (shouldFocus) {
            const inputs = step.querySelectorAll('input[type="text"], input[type="email"], textarea') as NodeListOf<HTMLInputElement | HTMLTextAreaElement>;
            if (inputs.length > 0) inputs[0].focus();
          }
        } else {
          step.classList.remove('opacity-100', 'pointer-events-auto', 'z-10');
          step.classList.add('opacity-0', 'pointer-events-none', 'z-0');
        }
      });

      if (currentStep === 0) {
        prevBtn?.classList.add('opacity-50', 'cursor-not-allowed');
        (prevBtn as HTMLButtonElement).disabled = true;
      } else {
        prevBtn?.classList.remove('opacity-50', 'cursor-not-allowed');
        (prevBtn as HTMLButtonElement).disabled = false;
      }

      nextBtn?.classList.toggle('hidden', currentStep === steps.length - 1);

      if (stepCounter) {
        stepCounter.textContent = `Step 0${currentStep + 1} / 0${steps.length}`;
      }

      const progressBar = document.getElementById('stepProgressBar');
      if (progressBar) {
        progressBar.style.width = `${((currentStep + 1) / steps.length) * 100}%`;
      }
    }

    nextBtn?.addEventListener('click', () => {
      const activeFields = steps[currentStep].querySelectorAll('input, textarea');
      let isValid = true;
      
      activeFields.forEach(field => {
        if (!(field as HTMLInputElement).checkValidity()) {
          (field as HTMLInputElement).reportValidity();
          isValid = false;
        }
      });

      if (!isValid) return;

      if (currentStep < steps.length - 1) {
        currentStep++;
        updateForm(true);
        const formSection = document.getElementById('brief-form');
        if (formSection && window.innerWidth < 768) {
          formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });

    prevBtn?.addEventListener('click', () => {
      if (currentStep > 0) {
        currentStep--;
        updateForm(true);
        const formSection = document.getElementById('brief-form');
        if (formSection && window.innerWidth < 768) {
          formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });

    form.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.target as HTMLElement).tagName !== 'TEXTAREA' && currentStep < steps.length - 1) {
        e.preventDefault();
        nextBtn?.click();
      }
    });

    updateForm();
  }

  // Initialize on standard page load and Astro client router transitions
  initForm();
  document.addEventListener('astro:page-load', initForm);
</script>
