---
// =====================================================================
// EASY QUESTION MANAGER BLOCK
// To change, add, or remove questions, just edit this list below!
// =====================================================================
const formSteps = [
  {
    id: "name",
    type: "text",
    tag: "01 ➔ Introduce Yourself",
    title: "What is your first and surname? *",
    inputType: "text",
    nameAttr: "name",
    placeholder: "Type your full name here...",
    required: true
  },
  {
    id: "service",
    type: "radio",
    tag: "02 ➔ Project Requirement",
    title: "What service do you need? *",
    options: [
      { label: "Filming", value: "Filming" },
      { label: "Editing", value: "Editing" },
      { label: "Filming & Editing (Full Production)", value: "Filming and Editing" },
      { label: "Animation & Motion Design", value: "Animation and Motion Design" }
    ]
  },
  {
    id: "email",
    type: "text",
    tag: "03 ➔ Reachable Contact",
    title: "What is your contact email address? *",
    inputType: "email",
    nameAttr: "email",
    placeholder: "name@company.com",
    required: true
  },
  {
    id: "message",
    type: "textarea",
    tag: "04 ➔ Project Brief",
    title: "How can we help? *",
    nameAttr: "message",
    placeholder: "Tell us about your event, dates, or visual goals...",
    required: true
  },
  {
    id: "verification",
    type: "final",
    tag: "05 ➔ Verification & Consent",
    title: "Final Step *",
    gdprText: "I consent to having this website store my submitted information so they can respond to my inquiry.",
    turnstileSiteKey: "YOUR_TURNSTILE_SITE_KEY"
  }
];

// 1. CHOOSE GLOBAL LAYOUT TO PREVENT NAVIGATION COLLISION
import Layout from '../layouts/Layout.astro';
---

<Layout title="Start Your Project | FilmEditRun" description="Get a tailored media production brief response.">
  <Fragment slot="head">
    <!-- Keep third-party scripts scoped cleanly -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </Fragment>

  <!-- 2. STRETCHABLE COMPACT WRAPPER FOR SAFE MOBILE BOUNDS -->
  <div class="min-h-[calc(100dvh-5rem)] w-full flex items-center justify-center px-6 py-12 relative">
    
    <!-- Grid overlay container lets steps crossfade while respecting natural mobile height -->
    <form id="typeform" action="https://formtorch.com/f/YOUR_FORMTORCH_KEY" method="POST" class="w-full max-w-2xl flex flex-col justify-between gap-10">
      <div class="grid grid-cols-1 items-center min-h-[280px]">
      
      {formSteps.map((step, index) => (
        <div class={`step col-start-1 row-start-1 transition-opacity duration-300 w-full flex flex-col justify-center ${index === 0 ? 'opacity-100 pointer-events-auto z-10' : 'opacity-0 pointer-events-none z-0'}`}>
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold mb-2 block">{step.tag}</span>
          <h2 class="text-2xl md:text-4xl font-bold text-white mb-6 pr-4 leading-tight">{step.title}</h2>

          {step.type === "text" && (
            <>
              <input 
                type={step.inputType} 
                name={step.nameAttr} 
                required={step.required} 
                placeholder={step.placeholder} 
                class="w-full bg-transparent border-b-2 border-neutral-700 focus:border-amber-500 text-xl md:text-3xl py-3 outline-none text-white transition-colors" 
              />
              {step.nameAttr === 'name' && <p class="text-xs text-neutral-500 mt-4 font-mono hidden sm:block">Press ENTER or click Next</p>}
            </>
          )}

          {step.type === "radio" && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {step.options.map((opt, optIdx) => (
                <label class="border border-neutral-800 rounded-xl p-4 flex items-center gap-3 cursor-pointer hover:border-amber-500/50 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-500/10 bg-neutral-900/30 transition-colors">
                  <input type="radio" name="required_service" value={opt.value} required={optIdx === 0} class="accent-amber-500 w-5 h-5 flex-shrink-0" />
                  <span class="text-base sm:text-lg text-neutral-200">{opt.label}</span>
                </label>
              ))}
            </div>
          )}

          {step.type === "textarea" && (
            <textarea 
              name={step.nameAttr} 
              required={step.required} 
              rows="3" 
              placeholder={step.placeholder} 
              class="w-full bg-transparent border-b-2 border-neutral-700 focus:border-amber-500 text-lg md:text-2xl py-2 outline-none text-white transition-colors resize-none"
            ></textarea>
          )}

          {step.type === "final" && (
            <div class="space-y-4">
              <label class="flex items-start gap-3 p-3 border border-neutral-800 rounded-xl bg-neutral-900/20 cursor-pointer hover:border-neutral-700 transition-colors">
                <input type="checkbox" name="gdpr_consent" required class="accent-amber-500 w-5 h-5 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-400 text-xs sm:text-sm leading-relaxed">{step.gdprText}</span>
              </label>

              <div class="cf-turnstile scale-90 origin-left" data-theme="dark" data-sitekey={step.turnstileSiteKey}></div>

              <button type="submit" class="w-full sm:w-auto bg-amber-500 text-neutral-950 font-bold px-8 py-3.5 rounded-xl text-base hover:bg-amber-400 transition-colors shadow-xl shadow-amber-500/10">
                Submit Brief
              </button>
            </div>
          )}
        </div>
      ))}
      </div>

      <!-- Inline Mobile-Safe Step Controls & Progress Indicator -->
      <div class="flex items-center justify-between border-t border-neutral-900 pt-6">
        <span id="stepCounter" class="font-mono text-xs uppercase tracking-widest text-neutral-500">
          Step 01 / 0{formSteps.length}
        </span>
        <div class="flex gap-3">
          <button type="button" id="prevBtn" class="bg-neutral-900 border border-neutral-800 text-neutral-400 hover:text-white px-4 py-3 rounded-xl opacity-50 cursor-not-allowed transition-all text-sm sm:text-base">
            ← Back
          </button>
          <button type="button" id="nextBtn" class="bg-amber-500 text-neutral-950 font-bold px-6 py-3 rounded-xl hover:bg-amber-400 transition-all text-sm sm:text-base cursor-pointer">
            Next →
          </button>
        </div>
      </div>
    </form>
  </div>
</Layout>

<!-- Multi-Step Interactivity (Safe for View Transitions) -->
<script>
  function initForm() {
    let currentStep = 0;
    const steps = document.querySelectorAll('.step');
    const nextBtn = document.getElementById('nextBtn');
    const prevBtn = document.getElementById('prevBtn');
    const stepCounter = document.getElementById('stepCounter');
    const form = document.getElementById('typeform');

    if (!form || steps.length === 0) return;

    function updateForm(shouldFocus = false) {
      steps.forEach((step, index) => {
        if (index === currentStep) {
          step.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
          step.classList.add('opacity-100', 'pointer-events-auto', 'z-10');
          if (shouldFocus) {
            const inputs = step.querySelectorAll('input[type="text"], input[type="email"], textarea') as NodeListOf<HTMLInputElement | HTMLTextAreaElement>;
            if (inputs.length > 0) inputs[0].focus();
          }
        } else {
          step.classList.remove('opacity-100', 'pointer-events-auto', 'z-10');
          step.classList.add('opacity-0', 'pointer-events-none', 'z-0');
        }
      });

      if (currentStep === 0) {
        prevBtn?.classList.add('opacity-50', 'cursor-not-allowed');
        (prevBtn as HTMLButtonElement).disabled = true;
      } else {
        prevBtn?.classList.remove('opacity-50', 'cursor-not-allowed');
        (prevBtn as HTMLButtonElement).disabled = false;
      }

      nextBtn?.classList.toggle('hidden', currentStep === steps.length - 1);

      if (stepCounter) {
        stepCounter.textContent = `Step 0${currentStep + 1} / 0${steps.length}`;
      }
    }

    nextBtn?.addEventListener('click', () => {
      const activeFields = steps[currentStep].querySelectorAll('input, textarea');
      let isValid = true;
      
      activeFields.forEach(field => {
        if (!(field as HTMLInputElement).checkValidity()) {
          (field as HTMLInputElement).reportValidity();
          isValid = false;
        }
      });

      if (!isValid) return;

      if (currentStep < steps.length - 1) {
        currentStep++;
        updateForm(true);
      }
    });

    prevBtn?.addEventListener('click', () => {
      if (currentStep > 0) {
        currentStep--;
        updateForm(true);
      }
    });

    form.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.target as HTMLElement).tagName !== 'TEXTAREA' && currentStep < steps.length - 1) {
        e.preventDefault();
        nextBtn?.click();
      }
    });

    updateForm();
  }

  // Initialize on standard page load and Astro client router transitions
  initForm();
  document.addEventListener('astro:page-load', initForm);
</script>
