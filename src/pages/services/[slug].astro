---
import Layout from '../../layouts/Layout.astro';

export interface ServiceData {
  order: string;
  slug: string;
  title: string;
  tag: string;
  link: string;
  // Subpage Hero Visuals
  heroDisplayAs?: "image" | "video" | "gradient" | "solid" | "none" | string;
  heroImage?: string;
  heroVideoPath?: string;
  heroSolidColor?: string;
  heroGradientDirection?: string;
  heroGradientColor1?: string;
  heroGradientColor2?: string;
  heroTextContrast?: "auto" | "light" | "dark" | string;
  // Bento Card Visuals
  cardDisplayAs?: string;
  cardImage?: string;
  cardVideoPath?: string;
  cardSolidColor?: string;
  cardGradientDirection?: string;
  cardGradientColor1?: string;
  cardGradientColor2?: string;
  cardTextContrast?: "auto" | "light" | "dark" | string;
  // Legacy compatibility fallbacks
  displayAs?: string;
  localVideoPath?: string;
  cloudVideoUrl?: string;
  imagePath?: string;
  description: string;
  seoTitle: string;
  seoDescription: string;
  heroTag: string;
  heroHeading: string;
  heroLead: string;
  breakdownHeading?: string;
  breakdownBody?: string;
  deliverables?: Array<{ tag: string; title: string; description: string }>;
  ctaHeading: string;
  ctaDescription: string;
  ctaButtonLabel: string;
}

export async function getStaticPaths() {
  const serviceFiles = import.meta.glob<ServiceData>('../../content/services/*.json', {
    eager: true,
    import: 'default',
  });

  const allServices = Object.values(serviceFiles).sort((a, b) =>
    a.order.localeCompare(b.order, undefined, { numeric: true })
  );

  return allServices.map((service, index) => {
    const slug = service.slug || service.link?.replace(/^\/services\//, '').replace(/\/$/, '') || `service-${index + 1}`;
    return {
      params: { slug },
      props: {
        service,
        allServices,
      },
    };
  });
}

interface Props {
  service: ServiceData;
  allServices: ServiceData[];
}

const { service, allServices } = Astro.props;

// Filter out current service for cross-navigation
const otherServices = allServices.filter((s) => s.slug !== service.slug);

// Canonical and OpenGraph URL
const siteUrl = "https://filmeditrun.co.uk";
const canonicalUrl = `${siteUrl}${service.link}`;
const ogImage = service.imagePath?.startsWith("http") ? service.imagePath : `${siteUrl}${service.imagePath || "/og-image.jpg"}`;

// Structured JSON-LD Service Schema
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.title,
  "description": service.description,
  "url": canonicalUrl,
  "provider": {
    "@type": "ProfessionalService",
    "name": "FilmEditRun",
    "url": siteUrl,
    "logo": `${siteUrl}/logo.svg`,
    "areaServed": [
      { "@type": "City", "name": "London" },
      { "@type": "City", "name": "Cambridge" },
      { "@type": "Country", "name": "United Kingdom" }
    ],
    "serviceType": service.tag
  }
};

const parseHeading = (text: string) => {
  if (!text) return "";
  return text.replace(/\*(.*?)\*/g, '<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">$1</span>');
};

const defaultWatermarks = [
  "/cambridge/stage-wide.webp",
  "/work/onlocation.webp",
  "/og-image.jpg",
  "/work/handheld.webp",
  "/work/onlocation.webp",
  "/work/handheld.webp",
];

const heroMode = service.heroDisplayAs || service.displayAs || "video";
const isVideo = heroMode === "video" || heroMode === "local-video" || heroMode === "link-video";
const isImage = heroMode === "image";
const isGradient = heroMode === "gradient";
const isSolid = heroMode === "solid";

const heroImg = service.heroImage || (service.imagePath && service.imagePath !== "/og-image.jpg" ? service.imagePath : null) || defaultWatermarks[parseInt(service.order || "1", 10) % defaultWatermarks.length];
const heroVid = service.heroVideoPath || (service.displayAs === "link-video" ? (service.cloudVideoUrl || "/showreel.mp4") : (service.localVideoPath || "/showreel.mp4"));
const heroSolid = service.heroSolidColor || "#09090c";
const heroGradDir = service.heroGradientDirection || "to bottom right";
const heroGrad1 = service.heroGradientColor1 || "#180d2b";
const heroGrad2 = service.heroGradientColor2 || "#09090c";
const isRadial = heroGradDir === "radial";
const gradientStyle = isRadial
  ? `background: radial-gradient(circle at center, ${heroGrad1} 0%, ${heroGrad2} 100%);`
  : `background: linear-gradient(${heroGradDir}, ${heroGrad1} 0%, ${heroGrad2} 100%);`;

// Calculate relative perceptual luminance (ITU-R BT.709) to ensure perfect contrast across all color grades
function isColorLight(hexOrRgb?: string): boolean {
  if (!hexOrRgb) return false;
  const hex = hexOrRgb.trim();
  if (hex.startsWith('#')) {
    const clean = hex.replace('#', '');
    if (clean.length !== 3 && clean.length !== 6) return false;
    const r = clean.length === 3 ? parseInt(clean[0] + clean[0], 16) : parseInt(clean.substring(0, 2), 16);
    const g = clean.length === 3 ? parseInt(clean[1] + clean[1], 16) : parseInt(clean.substring(2, 4), 16);
    const b = clean.length === 3 ? parseInt(clean[2] + clean[2], 16) : parseInt(clean.substring(4, 6), 16);
    const luminance = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
    return luminance > 0.55;
  }
  return false;
}

// Determine if hero has a light background (auto-detected or manually chosen in TinaCMS)
let isHeroLight = false;
if (service.heroTextContrast === "dark") {
  isHeroLight = true;
} else if (service.heroTextContrast === "light") {
  isHeroLight = false;
} else {
  if (isSolid) {
    isHeroLight = isColorLight(heroSolid);
  } else if (isGradient) {
    isHeroLight = isColorLight(heroGrad1) && isColorLight(heroGrad2);
  }
}
---

<Layout
  title={service.seoTitle}
  description={service.seoDescription}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogType="article"
  jsonLd={jsonLd}
  fullBleed={true}
>

  <div class="w-full relative z-10 bg-ink min-h-screen">

    <!-- ============================================================== -->
    <!-- 1. CINEMATIC HERO BANNER (Standardized Studio Hero Banner)     -->
    <!-- ============================================================== -->
    <header 
      data-cinema-darkroom={!isHeroLight ? true : undefined} 
      class:list={[
        "relative w-full pt-32 pb-20 sm:pt-40 sm:pb-28 overflow-hidden border-b select-none",
        isHeroLight ? "border-black/10 bg-white" : "border-white/10"
      ]}
    >
      
      <!-- Video / Photo / Gradient / Solid Media Backdrop Layer -->
      <div class:list={["absolute inset-0 z-0 pointer-events-none overflow-hidden", isHeroLight ? "bg-white" : "bg-[#0c0c11]"]}>
        {isHeroLight ? (
          <div class="absolute inset-0 bg-gradient-to-b from-white/30 via-white/10 to-white/60 z-10 pointer-events-none" aria-hidden="true"></div>
        ) : (
          <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/60 to-black/90 z-10 pointer-events-none" aria-hidden="true"></div>
        )}

        {!isHeroLight && (
          <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[40rem] sm:w-[56rem] h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none z-10" aria-hidden="true"></div>
        )}

        {/* Video Background (High visibility, matching work page opacity) */}
        {isVideo && (
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={heroImg}
            class="absolute inset-0 w-full h-full object-cover opacity-90 sm:opacity-95 z-0"
          >
            <source src={heroVid} type="video/mp4" />
          </video>
        )}

        {/* Static Image Background */}
        {isImage && (
          <img
            src={heroImg}
            alt={service.title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover opacity-80 sm:opacity-85 z-0"
          />
        )}

        {/* Dual-Tone Gradient Background */}
        {isGradient && (
          <div
            class="absolute inset-0 w-full h-full z-0"
            style={gradientStyle}
            aria-hidden="true"
          />
        )}

        {/* Solid Color Background */}
        {isSolid && (
          <div
            class="absolute inset-0 w-full h-full z-0"
            style={`background-color: ${heroSolid};`}
            aria-hidden="true"
          />
        )}
      </div>

      <!-- Main Banner Content -->
      <div class="relative z-20 max-w-6xl mx-auto px-6">
        
        <!-- Breadcrumb Navigation -->
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-mono tracking-wider mb-6">
          <a href="/" class:list={["transition-colors", isHeroLight ? "text-[#4b5563] hover:text-[#09090b]" : "text-neutral-400 hover:text-white"]}>Home</a>
          <span class={isHeroLight ? "text-[#9ca3af]" : "text-neutral-600"}>/</span>
          <a href="/services" class:list={["transition-colors", isHeroLight ? "text-[#4b5563] hover:text-[#09090b]" : "text-neutral-400 hover:text-white"]}>Services</a>
          <span class={isHeroLight ? "text-[#9ca3af]" : "text-neutral-600"}>/</span>
          <span class:list={["font-semibold", isHeroLight ? "text-amber-600" : "text-amber-500"]}>{service.title}</span>
        </nav>

        <!-- Large Title -->
        <h1 
          class:list={[
            "text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[1.08] mb-6 max-w-4xl",
            isHeroLight ? "text-[#09090b]" : "text-white keep-white"
          ]}
          set:html={parseHeading(service.heroHeading || service.title)}
        />

        <!-- Value Proposition / Introductory Paragraph -->
        <p class:list={[
          "text-base sm:text-lg lg:text-xl font-normal leading-relaxed max-w-3xl mb-8",
          isHeroLight ? "text-[#374151]" : "text-neutral-300"
        ]}>
          {service.heroLead || service.description}
        </p>

        <!-- Primary Action -->
        <div>
          <a
            href="/contact"
            class="inline-block bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold px-8 py-3.5 rounded-xl text-base transition-all shadow-xl shadow-amber-500/20 hover:scale-[1.02] text-center"
          >
            Start a Project Brief &rarr;
          </a>
        </div>

      </div>

    </header>

    <!-- ============================================================== -->
    <!-- 2. APPROACH & CAPABILITIES (Sequential Editorial Flow)         -->
    <!-- ============================================================== -->
    <section class="max-w-6xl mx-auto px-6 py-24 sm:py-32">
      
      <!-- Top Tier: Approach Narrative (Left) & Production Still (Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        
        <!-- Left: Approach & Philosophy -->
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-mono uppercase tracking-widest text-amber-500 font-semibold block">
            {service.heroTag || service.tag || "Production Scope"}
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-[1.12]">
            {service.breakdownHeading || "Engineered for Precision & Impact."}
          </h2>
          <p class="text-neutral-300 text-base sm:text-lg leading-relaxed font-light">
            {service.breakdownBody || service.description}
          </p>
        </div>

        <!-- Right: Production Still / Reference Image -->
        {service.imagePath && (
          <div class="lg:col-span-6">
            <div class="relative w-full aspect-16/10 rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
              <img
                src={service.imagePath}
                alt={service.title}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
              />
              <div class="absolute inset-0 bg-linear-to-t from-neutral-950/40 via-transparent to-transparent pointer-events-none"></div>
            </div>
          </div>
        )}

      </div>

      <!-- Bottom Tier: 3 Core Capabilities Row -->
      {service.deliverables && service.deliverables.length > 0 && (
        <div class="border-t border-white/10 pt-16 sm:pt-20 mt-16 sm:mt-24">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
            {service.deliverables.slice(0, 3).map((item) => (
              <div class="space-y-3">
                <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
                  {item.title}
                </h3>
                <p class="text-neutral-400 text-sm sm:text-base leading-relaxed font-light">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      )}

    </section>

    <!-- ============================================================== -->
    <!-- 3. OTHER SERVICES NAVIGATION                                   -->
    <!-- ============================================================== -->
    <section class="max-w-6xl mx-auto px-6 mb-24 border-t border-white/10 pt-16">
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <h3 class="text-xs uppercase tracking-widest font-mono text-neutral-400">Additional Disciplines</h3>
        </div>
        <a href="/services" class="text-xs font-mono uppercase tracking-widest text-amber-500 hover:text-amber-400 transition-colors">
          View All Services &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {otherServices.map((other) => (
          <a
            href={other.link}
            class="group flex flex-col justify-between p-4 sm:p-5 rounded-xl border border-white/10 bg-neutral-900/40 hover:bg-neutral-900/80 hover:border-amber-500/50 transition-all duration-300 shadow-md hover:-translate-y-1"
          >
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-amber-400 block mb-2 font-medium">
                {other.tag}
              </span>
              <h4 class="text-sm font-bold text-white group-hover:text-amber-400 transition-colors mb-2 leading-snug">
                {other.title}
              </h4>
              <p class="text-neutral-400 text-xs leading-relaxed font-light line-clamp-3">
                {other.description}
              </p>
            </div>
            <div class="pt-3 mt-4 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-neutral-500 group-hover:text-amber-400 transition-colors">
              <span>Explore</span>
              <span class="group-hover:translate-x-1 transition-transform font-bold">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- 4. DIRECT CTA                                                  -->
    <!-- ============================================================== -->
    <section class="border-t border-white/10 py-24 sm:py-32 bg-neutral-950">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white mb-4">
          {service.ctaHeading || "Ready to Start Your Project?"}
        </h2>
        <p class="text-neutral-400 text-base sm:text-lg leading-relaxed mb-8 max-w-xl mx-auto">
          {service.ctaDescription || "Get in touch to discuss your project brief, timeline, and production requirements."}
        </p>
        <a
          href="/contact"
          class="inline-block bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold px-9 py-4 rounded-xl text-base transition-all shadow-lg shadow-amber-500/10 hover:scale-[1.02] text-center"
        >
          {service.ctaButtonLabel || "Start a Project Brief"} &rarr;
        </a>
      </div>
    </section>

  </div>
</Layout>

