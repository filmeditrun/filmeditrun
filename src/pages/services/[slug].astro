---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/CtaSection.astro';

export interface ServiceData {
  order: string;
  slug: string;
  title: string;
  tag: string;
  link: string;
  // Subpage Hero Visuals
  heroDisplayAs?: "image" | "video" | "gradient" | "solid" | "none" | string;
  heroImage?: string;
  heroVideoPath?: string;
  heroSolidColor?: string;
  heroGradientDirection?: string;
  heroGradientColor1?: string;
  heroGradientColor2?: string;
  heroTextContrast?: "auto" | "light" | "dark" | string;
  // Bento Card Visuals
  cardDisplayAs?: string;
  cardImage?: string;
  cardVideoPath?: string;
  cardSolidColor?: string;
  cardGradientDirection?: string;
  cardGradientColor1?: string;
  cardGradientColor2?: string;
  cardTextContrast?: "auto" | "light" | "dark" | string;
  // Legacy compatibility fallbacks
  displayAs?: string;
  localVideoPath?: string;
  cloudVideoUrl?: string;
  imagePath?: string;
  description: string;
  seoTitle: string;
  seoDescription: string;
  heroTag: string;
  heroHeading: string;
  heroLead: string;
  breakdownHeading?: string;
  breakdownBody?: string;
  deliverables?: Array<{ tag: string; title: string; description: string }>;
  ctaHeading: string;
  ctaDescription: string;
  ctaButtonLabel: string;
}

export async function getStaticPaths() {
  const serviceFiles = import.meta.glob<ServiceData>('../../content/services/*.json', {
    eager: true,
    import: 'default',
  });

  const allServices = Object.values(serviceFiles).sort((a, b) =>
    a.order.localeCompare(b.order, undefined, { numeric: true })
  );

  return allServices.map((service, index) => {
    const slug = service.slug || service.link?.replace(/^\/services\//, '').replace(/\/$/, '') || `service-${index + 1}`;
    return {
      params: { slug },
      props: {
        service,
        allServices,
      },
    };
  });
}

interface Props {
  service: ServiceData;
  allServices: ServiceData[];
}

const { service, allServices } = Astro.props;

// Filter out current service for cross-navigation
const otherServices = allServices.filter((s) => s.slug !== service.slug);

// Canonical and OpenGraph URL
const siteUrl = "https://filmeditrun.co.uk";
const canonicalUrl = `${siteUrl}${service.link}`;
const ogImage = service.imagePath?.startsWith("http") ? service.imagePath : `${siteUrl}${service.imagePath || "/og-image.jpg"}`;

// Structured JSON-LD Service Schema
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.title,
  "description": service.description,
  "url": canonicalUrl,
  "provider": {
    "@type": "ProfessionalService",
    "name": "FilmEditRun",
    "url": siteUrl,
    "logo": `${siteUrl}/logo.svg`,
    "areaServed": [
      { "@type": "City", "name": "London" },
      { "@type": "City", "name": "Cambridge" },
      { "@type": "Country", "name": "United Kingdom" }
    ],
    "serviceType": service.tag
  }
};

const parseHeading = (text: string) => {
  if (!text) return "";
  return text.replace(/\*(.*?)\*/g, '<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">$1</span>');
};

// parseHeadingWithLine: Solid Text with Animated Gradient Underline (used on in-page sections)
const parseHeadingWithLine = (text: string) => {
  if (!text) return "";
  if (text.includes('*')) {
    return text.replace(/\*(.*?)\*/g, '<span class="animated-accent-underline">$1</span>');
  }
  return text;
};

const defaultWatermarks = [
  "/cambridge/stage-wide.webp",
  "/work/onlocation.webp",
  "/og-image.jpg",
  "/work/handheld.webp",
  "/work/onlocation.webp",
  "/work/handheld.webp",
];

const heroMode = service.heroDisplayAs || service.displayAs || "video";
const isVideo = heroMode === "video" || heroMode === "local-video" || heroMode === "link-video";
const isImage = heroMode === "image";
const isGradient = heroMode === "gradient";
const isSolid = heroMode === "solid";

const heroImg = service.heroImage || (service.imagePath && service.imagePath !== "/og-image.jpg" ? service.imagePath : null) || defaultWatermarks[parseInt(service.order || "1", 10) % defaultWatermarks.length];
const heroVid = service.heroVideoPath || (service.displayAs === "link-video" ? (service.cloudVideoUrl || "/showreel.mp4") : (service.localVideoPath || "/showreel.mp4"));
const heroSolid = service.heroSolidColor || "#09090c";
const heroGradDir = service.heroGradientDirection || "to bottom right";
const heroGrad1 = service.heroGradientColor1 || "#180d2b";
const heroGrad2 = service.heroGradientColor2 || "#09090c";
const isRadial = heroGradDir === "radial";
const gradientStyle = isRadial
  ? `background: radial-gradient(circle at center, ${heroGrad1} 0%, ${heroGrad2} 100%);`
  : `background: linear-gradient(${heroGradDir}, ${heroGrad1} 0%, ${heroGrad2} 100%);`;

// Calculate relative perceptual luminance (ITU-R BT.709) to ensure perfect contrast across all color grades
function isColorLight(hexOrRgb?: string): boolean {
  if (!hexOrRgb) return false;
  const hex = hexOrRgb.trim();
  if (hex.startsWith('#')) {
    const clean = hex.replace('#', '');
    if (clean.length !== 3 && clean.length !== 6) return false;
    const r = clean.length === 3 ? parseInt(clean[0] + clean[0], 16) : parseInt(clean.substring(0, 2), 16);
    const g = clean.length === 3 ? parseInt(clean[1] + clean[1], 16) : parseInt(clean.substring(2, 4), 16);
    const b = clean.length === 3 ? parseInt(clean[2] + clean[2], 16) : parseInt(clean.substring(4, 6), 16);
    const luminance = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
    return luminance > 0.55;
  }
  return false;
}

// Determine if hero has a light background (auto-detected or manually chosen in TinaCMS)
let isHeroLight = false;
if (service.heroTextContrast === "dark") {
  isHeroLight = true;
} else if (service.heroTextContrast === "light") {
  isHeroLight = false;
} else {
  if (isSolid) {
    isHeroLight = isColorLight(heroSolid);
  } else if (isGradient) {
    isHeroLight = isColorLight(heroGrad1) && isColorLight(heroGrad2);
  }
}
---

<Layout
  title={service.seoTitle}
  description={service.seoDescription}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogType="article"
  jsonLd={jsonLd}
  fullBleed={true}
>

  <div class="w-full relative z-10 bg-ink min-h-screen">

    <!-- ============================================================== -->
    <!-- 1. CINEMATIC HERO BANNER (Standardized Studio Hero Banner)     -->
    <!-- ============================================================== -->
    <header 
      data-cinema-darkroom={!isHeroLight ? true : undefined} 
      class:list={[
        "relative w-full pt-32 pb-20 sm:pt-40 sm:pb-28 overflow-hidden border-b select-none",
        isHeroLight ? "border-black/10 bg-white" : "border-white/10"
      ]}
    >
      
      <!-- Video / Photo / Gradient / Solid Media Backdrop Layer -->
      <div class:list={["absolute inset-0 z-0 pointer-events-none overflow-hidden", isHeroLight ? "bg-white" : "bg-[#0c0c11]"]}>
        {isHeroLight ? (
          <div class="absolute inset-0 bg-gradient-to-b from-white/30 via-white/10 to-white/60 z-10 pointer-events-none" aria-hidden="true"></div>
        ) : (
          <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/60 to-black/90 z-10 pointer-events-none" aria-hidden="true"></div>
        )}

        {!isHeroLight && (
          <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[40rem] sm:w-[56rem] h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none z-10" aria-hidden="true"></div>
        )}

        {/* Video Background (High visibility, matching work page opacity) */}
        {isVideo && (
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={heroImg}
            class="absolute inset-0 w-full h-full object-cover opacity-90 sm:opacity-95 z-0"
          >
            <source src={heroVid} type="video/mp4" />
          </video>
        )}

        {/* Static Image Background */}
        {isImage && (
          <img
            src={heroImg}
            alt={service.title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover opacity-80 sm:opacity-85 z-0"
          />
        )}

        {/* Dual-Tone Gradient Background */}
        {isGradient && (
          <div
            class="absolute inset-0 w-full h-full z-0"
            style={gradientStyle}
            aria-hidden="true"
          />
        )}

        {/* Solid Color Background */}
        {isSolid && (
          <div
            class="absolute inset-0 w-full h-full z-0"
            style={`background-color: ${heroSolid};`}
            aria-hidden="true"
          />
        )}
      </div>

      <!-- Main Banner Content -->
      <div class="relative z-20 max-w-6xl mx-auto px-6">
        
        <!-- Breadcrumb Navigation -->
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-mono tracking-wider mb-6">
          <a href="/" class:list={["transition-colors", isHeroLight ? "text-[#4b5563] hover:text-[#09090b]" : "text-neutral-400 hover:text-white"]}>Home</a>
          <span class={isHeroLight ? "text-[#9ca3af]" : "text-neutral-600"}>/</span>
          <a href="/services" class:list={["transition-colors", isHeroLight ? "text-[#4b5563] hover:text-[#09090b]" : "text-neutral-400 hover:text-white"]}>Services</a>
          <span class={isHeroLight ? "text-[#9ca3af]" : "text-neutral-600"}>/</span>
          <span class:list={["font-semibold", isHeroLight ? "text-amber-600" : "text-amber-500"]}>{service.title}</span>
        </nav>

        <!-- Large Title -->
        <h1 
          class:list={[
            "text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[1.08] mb-6 max-w-4xl",
            isHeroLight ? "text-[#09090b]" : "text-white keep-white"
          ]}
          set:html={parseHeading(service.heroHeading || service.title)}
        />

        <!-- Value Proposition / Introductory Paragraph -->
        <p class:list={[
          "text-base sm:text-lg lg:text-xl font-normal leading-relaxed max-w-3xl mb-8",
          isHeroLight ? "text-[#374151]" : "text-neutral-300"
        ]}>
          {service.heroLead || service.description}
        </p>

        <!-- Primary Action -->
        <div>
          <a
            href="/contact"
            class="inline-block bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold px-8 py-3.5 rounded-xl text-base transition-all shadow-xl shadow-amber-500/20 hover:scale-[1.02] text-center"
          >
            Start a Project Brief &rarr;
          </a>
        </div>

      </div>

    </header>

    <!-- ============================================================== -->
    <!-- 2. APPROACH & PHILOSOPHY (Sequential Editorial Flow)           -->
    <!-- ============================================================== -->
    <section class="max-w-6xl mx-auto px-6 py-20 sm:py-28">
      
      <!-- Approach Narrative (Left) & Production Still (Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        
        <!-- Left: Approach & Philosophy -->
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-mono uppercase tracking-widest text-amber-500 font-semibold block">
            {service.heroTag || service.tag || "Production Scope"}
          </span>
          <h2 
            class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-[1.12]"
            set:html={parseHeadingWithLine(service.breakdownHeading || "Engineered for Precision & Impact.")}
          />
          <p class="text-neutral-300 text-base sm:text-lg leading-relaxed font-light">
            {service.breakdownBody || service.description}
          </p>
        </div>

        <!-- Right: Production Still / Reference Image -->
        {service.imagePath && (
          <div class="lg:col-span-6">
            <div class="relative w-full aspect-16/10 rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
              <img
                src={service.imagePath}
                alt={service.title}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
              />
              <div class="absolute inset-0 bg-linear-to-t from-neutral-950/40 via-transparent to-transparent pointer-events-none"></div>
            </div>
          </div>
        )}

      </div>

    </section>

    <!-- ============================================================== -->
    <!-- 3. DELIVERABLES (Architectural 3-Column Column Dividers)        -->
    <!-- ============================================================== -->
    {service.deliverables && service.deliverables.length > 0 && (
      <section class="deliverables-grid-band relative w-full py-20 sm:py-28 border-y transition-colors duration-300">
        <div class="max-w-6xl mx-auto px-6">
          <div class="grid grid-cols-1 md:grid-cols-3 relative">
            {service.deliverables.slice(0, 3).map((item, idx) => (
              <div class:list={[
                "group relative space-y-3 py-8 md:py-0 transition-colors duration-200",
                idx === 0 ? "md:pr-10 lg:pr-12 md:pl-0" : "",
                idx === 1 ? "md:px-10 lg:px-12" : "",
                idx === 2 ? "md:pl-10 lg:pl-12 md:pr-0" : "",
              ]}>
                <h3 class="deliverables-item-title text-xl sm:text-2xl font-bold tracking-tight leading-snug transition-colors duration-300">
                  {item.title}
                </h3>
                <p class="deliverables-item-desc text-sm sm:text-base leading-relaxed font-light transition-colors duration-300">
                  {item.description}
                </p>

                {/* Animated Accent Divider Line (Horizontal on mobile, Vertical on desktop) */}
                {idx < 2 && (
                  <div class="deliverables-animated-divider" aria-hidden="true">
                    <!-- Faint structural track for baseline architectural grid -->
                    <div class="deliverables-divider-track"></div>
                    <!-- Animated laser gradient line that draws smoothly on scroll -->
                    <div 
                      class:list={[
                        "deliverables-divider-laser animated-accent-line",
                        idx === 1 ? "deliverables-laser-delay" : ""
                      ]}
                    ></div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============================================================== -->
    <!-- 4. OTHER SERVICES NAVIGATION                                   -->
    <!-- ============================================================== -->
    <section class="max-w-6xl mx-auto px-6 pt-20 sm:pt-24 mb-24">
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <h3 class="text-xs uppercase tracking-widest font-mono text-neutral-400">Additional Services</h3>
        </div>
        <a href="/services" class="text-xs font-mono uppercase tracking-widest text-amber-500 hover:text-amber-400 transition-colors">
          View All Services &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {otherServices.map((other) => (
          <a
            href={other.link}
            class="group relative flex items-start justify-between gap-3 p-5 rounded-xl border border-line bg-neutral-900/40 hover:bg-neutral-900/80 hover:border-amber-500/50 transition-all duration-300 shadow-md hover:-translate-y-1 h-full"
          >
            <h4 class="text-sm font-bold text-white group-hover:text-amber-400 transition-colors leading-snug">
              {other.title}
            </h4>
            <span class="text-neutral-500 group-hover:text-amber-400 group-hover:translate-x-1 transition-all duration-200 text-sm font-bold shrink-0 mt-0.5" aria-hidden="true">
              &rarr;
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- 4. DIRECT CTA (Full-Bleed Architectural Atmosphere)            -->
    <!-- ============================================================== -->
    <CtaSection
      tag={service.tag || "Production Discipline"}
      heading={service.ctaHeading || "Ready to Start Your *Project*?"}
      description={service.ctaDescription || "Get in touch to discuss your project brief, timeline, and production requirements."}
      primaryButtonLabel={service.ctaButtonLabel?.includes("→") ? service.ctaButtonLabel : `${service.ctaButtonLabel || "Start a Project Brief"} →`}
      primaryButtonLink="/contact"
      trustSignals={[
        "24h Proposal Turnaround",
        "Direct Filmmaker Collaboration",
        "Cambridge & London Hubs"
      ]}
    />

  </div>
</Layout>

<style is:global>
  /* -------------------------------------------------------------------------
     DELIVERABLES SECTION GRADE ADAPTATION (Pure CSS Zero-JS)
     ------------------------------------------------------------------------- */
  /* Default: Dark Noir */
  .deliverables-grid-band {
    background-color: #0c0d14;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 24px 24px;
    border-color: rgba(255, 255, 255, 0.1);
  }
  .deliverables-item-title {
    color: #ffffff;
  }
  .deliverables-grid-band .group:hover .deliverables-item-title {
    color: #e8c547;
  }
  .deliverables-item-desc {
    color: #a3a3a3;
  }
  .deliverables-grid-band .group:hover .deliverables-item-desc {
    color: #e5e5e5;
  }

  /* High-Key Light Active: Crisp White Drafting Canvas with Obsidian Typography */
  :is(html[data-theme="high-key"], html:has(#theme-choice-high-key:checked)) .deliverables-grid-band {
    background-color: #ffffff !important;
    background-image: radial-gradient(rgba(0, 0, 0, 0.05) 1px, transparent 1px) !important;
    background-size: 24px 24px !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
  }
  :is(html[data-theme="high-key"], html:has(#theme-choice-high-key:checked)) .deliverables-item-title {
    color: #09090b !important;
  }
  :is(html[data-theme="high-key"], html:has(#theme-choice-high-key:checked)) .deliverables-grid-band .group:hover .deliverables-item-title {
    color: var(--highKeyAccent, #e11d48) !important;
  }
  :is(html[data-theme="high-key"], html:has(#theme-choice-high-key:checked)) .deliverables-item-desc {
    color: #52525b !important;
  }
  :is(html[data-theme="high-key"], html:has(#theme-choice-high-key:checked)) .deliverables-grid-band .group:hover .deliverables-item-desc {
    color: #09090b !important;
  }

  /* Supernova Active: Cyber-Noir Cosmic Obsidian with Neon Accents */
  :is(html[data-theme="supernova"], html:has(#theme-choice-supernova:checked)) .deliverables-grid-band {
    background-color: #0c061a !important;
    background-image: radial-gradient(rgba(244, 63, 94, 0.08) 1px, transparent 1px) !important;
    background-size: 24px 24px !important;
    border-color: rgba(244, 63, 94, 0.2) !important;
  }
  :is(html[data-theme="supernova"], html:has(#theme-choice-supernova:checked)) .deliverables-item-title {
    color: #ffffff !important;
  }
  :is(html[data-theme="supernova"], html:has(#theme-choice-supernova:checked)) .deliverables-grid-band .group:hover .deliverables-item-title {
    color: var(--supernovaAccent, #f43f5e) !important;
  }
  :is(html[data-theme="supernova"], html:has(#theme-choice-supernova:checked)) .deliverables-item-desc {
    color: #c4b5fd !important;
  }
  :is(html[data-theme="supernova"], html:has(#theme-choice-supernova:checked)) .deliverables-grid-band .group:hover .deliverables-item-desc {
    color: #fdf2f8 !important;
  }

  /* -------------------------------------------------------------------------
     ANIMATED ACCENT DIVIDER LINES (Top-to-Bottom Draw on Scroll)
     Uses the same dynamic gradient as animated-accent-underline
     ------------------------------------------------------------------------- */
  .deliverables-animated-divider {
    position: absolute;
    pointer-events: none;
    overflow: hidden;
    /* Mobile: Horizontal hairline at card bottom */
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
  }

  @media (min-width: 768px) {
    .deliverables-animated-divider {
      /* Desktop: Vertical hairline at right edge */
      bottom: 0;
      top: 0;
      right: 0;
      left: auto;
      width: 2px;
      height: auto;
    }
  }

  /* Underlying structural track (Subtle guide before animation) */
  .deliverables-divider-track {
    position: absolute;
    inset: 0;
    background-color: rgba(255, 255, 255, 0.08);
  }
  :is(html[data-theme="high-key"], html:has(#theme-choice-high-key:checked)) .deliverables-divider-track {
    background-color: rgba(0, 0, 0, 0.06);
  }
  :is(html[data-theme="supernova"], html:has(#theme-choice-supernova:checked)) .deliverables-divider-track {
    background-color: rgba(244, 63, 94, 0.15);
  }

  /* Vibrant Accent Laser Line (Draws into view) */
  .deliverables-divider-laser {
    position: absolute;
    inset: 0;
    /* Mobile: Horizontal gradient from left to right */
    background-image: linear-gradient(90deg, var(--color-amber-400), var(--color-amber-500), var(--color-amber-600));
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
  }
  .deliverables-divider-laser.is-visible {
    transform: scaleX(1);
  }

  @media (min-width: 768px) {
    .deliverables-divider-laser {
      /* Desktop: Vertical gradient from top to bottom */
      background-image: linear-gradient(180deg, var(--color-amber-400), var(--color-amber-500), var(--color-amber-600));
      transform-origin: top center;
      transform: scaleY(0);
      transition: transform 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
    }
    .deliverables-divider-laser.is-visible {
      transform: scaleY(1);
    }
    /* Stagger Line 2 slightly for an organic cascade */
    .deliverables-laser-delay {
      transition-delay: 0.3s;
    }
  }

  /* Subtle brightness lift on column hover */
  .group:hover .deliverables-divider-laser {
    filter: brightness(1.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .deliverables-divider-laser {
      transform: none !important;
      transition: none !important;
    }
  }
</style>

