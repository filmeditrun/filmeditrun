---
import Layout from '../layouts/Layout.astro';
import contact from '../content/pages/contact.json';
import seo from '../content/settings/seo.json';

const studioEmail = seo.email || "contact@filmeditrun.co.uk";
const studioPhone = seo.telephone || "+44 1223 926450";

const statusBadge = contact.thankYouStatusBadge || "Brief Dispatch Confirmed • 24hr Response";
const heading = contact.thankYouHeading || "We've received your project brief.";
const highlight = contact.thankYouHighlight || "project brief.";
const description = contact.thankYouDescription || "Thank you for getting in touch. Your requirements have been safely delivered to our production desk. We review every brief carefully and will get back to you with a tailored scope within 24 hours.";

const phase1Tag = contact.phase1Tag || "Phase 01 // Discovery";
const phase1Title = contact.phase1Title || "Review & Needs";
const phase1Desc = contact.phase1Desc || "We assess your target dates, creative requirements, filming locations, and turnaround expectations.";

const phase2Tag = contact.phase2Tag || "Phase 02 // Scoping";
const phase2Title = contact.phase2Title || "Proposal & Quote";
const phase2Desc = contact.phase2Desc || "We prepare a tailored production treatment with equipment specs, crew allocation, and clear itemized costing.";

const phase3Tag = contact.phase3Tag || "Phase 03 // Launch";
const phase3Title = contact.phase3Title || "Calendar Lock";
const phase3Desc = contact.phase3Desc || "Upon approval, dates are secured in our shoot calendar and pre-production commences immediately.";

const primaryBtnLabel = contact.thankYouPrimaryBtnLabel || "Explore Recent Work";
const primaryBtnLink = contact.thankYouPrimaryBtnLink || "/work";
const secondaryBtnLabel = contact.thankYouSecondaryBtnLabel || "Back to Homepage";
const secondaryBtnLink = contact.thankYouSecondaryBtnLink || "/";

// Helper to highlight gradient text in heading
let headingPrefix = heading;
let headingSuffix = "";
if (highlight && heading.includes(highlight)) {
  const parts = heading.split(highlight);
  headingPrefix = parts[0];
  headingSuffix = parts.slice(1).join(highlight);
}
---

<Layout 
  title="Brief Received | FilmEditRun" 
  description="Thank you for submitting your project brief. We review every brief carefully and respond with a tailored proposal within 24 hours."
>
  <main class="min-h-[calc(100dvh-5rem)] w-full flex items-center justify-center px-6 py-16 sm:py-24 relative overflow-hidden">
    
    <!-- Subtle Ambient Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-amber-500/5 rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="w-full max-w-3xl flex flex-col items-center text-center">
      
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-mono text-[11px] uppercase tracking-widest font-semibold mb-8">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>{statusBadge}</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight mb-6">
        {highlight && heading.includes(highlight) ? (
          <>
            {headingPrefix}<span class="bg-gradient-to-r from-amber-400 to-amber-500 bg-clip-text text-transparent">{highlight}</span>{headingSuffix}
          </>
        ) : (
          heading
        )}
      </h1>

      <!-- Intro Subtitle -->
      <p class="text-base sm:text-xl text-neutral-300 max-w-2xl leading-relaxed mb-12 font-light">
        {description}
      </p>

      <!-- 3-Step "What Happens Next" Production Rail -->
      <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-4 mb-12 text-left">
        
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl bg-neutral-900/40 border border-white/5 flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-amber-500 font-bold block mb-2">
              {phase1Tag}
            </span>
            <h2 class="text-lg font-bold text-white mb-2">{phase1Title}</h2>
            <p class="text-xs text-neutral-400 leading-relaxed">
              {phase1Desc}
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl bg-neutral-900/40 border border-white/5 flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-amber-500 font-bold block mb-2">
              {phase2Tag}
            </span>
            <h2 class="text-lg font-bold text-white mb-2">{phase2Title}</h2>
            <p class="text-xs text-neutral-400 leading-relaxed">
              {phase2Desc}
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl bg-neutral-900/40 border border-white/5 flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-amber-500 font-bold block mb-2">
              {phase3Tag}
            </span>
            <h2 class="text-lg font-bold text-white mb-2">{phase3Title}</h2>
            <p class="text-xs text-neutral-400 leading-relaxed">
              {phase3Desc}
            </p>
          </div>
        </div>

      </div>

      <!-- Action Navigation Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto mb-10">
        <a 
          href={primaryBtnLink} 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-mono font-bold text-sm uppercase tracking-wider hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xl shadow-amber-500/10"
        >
          <span>{primaryBtnLabel}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a 
          href={secondaryBtnLink} 
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl bg-neutral-900/80 hover:bg-neutral-800 text-neutral-300 hover:text-white font-mono text-sm uppercase tracking-wider border border-white/10 hover:border-white/20 transition-all"
        >
          {secondaryBtnLabel}
        </a>
      </div>

      <!-- Urgent Contact Callout -->
      <div class="pt-8 border-t border-neutral-900 w-full text-center">
        <p class="text-xs text-neutral-500 font-mono">
          Have immediate scripts, storyboards, or tight deadlines? 
          <a href={`mailto:${studioEmail}`} class="text-amber-500 hover:text-amber-400 underline underline-offset-4 ml-1">
            Email our desk directly
          </a>
          <span class="mx-2 text-neutral-700">•</span>
          <a href={`tel:${studioPhone.replace(/\s+/g, '')}`} class="text-neutral-400 hover:text-white transition-colors">
            {studioPhone}
          </a>
        </p>
      </div>

    </div>
  </main>
</Layout>
