---
// =====================================================================
// LONDON LANDING PAGE (Managed via TinaCMS in src/content/pages/london.json)
// =====================================================================
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import rawLondon from '../content/pages/london.json';

interface LondonData {
  seoTitle: string;
  seoDescription: string;
  canonicalURL?: string;
  heroTag?: string;
  heroHeadingPrefix?: string;
  heroHeadingHighlight?: string;
  heroSubtitle?: string;
  heroCtaLabel?: string;
  heroCtaLink?: string;
  displayAs?: "local-video" | "link-video" | "image" | "none";
  localVideoPath?: string;
  cloudVideoUrl?: string;
  imagePath?: string;
  expertiseTag?: string;
  expertiseHeading?: string;
  expertiseDescription?: string;
  expertiseBullets?: string[];
  cardTitle?: string;
  cardBody?: string;
  cardLinkLabel?: string;
  cardLinkHref?: string;
  lookbookTag?: string;
  lookbookHeroImage?: string;
  lookbookHeroBadge?: string;
  lookbookDetail1Image?: string;
  lookbookDetail1Badge?: string;
  lookbookDetail2Image?: string;
  lookbookDetail2Badge?: string;
  faqHeading?: string;
  faqs?: Array<{ question: string; answer: string }>;
  bottomCtaHeading?: string;
  bottomCtaBody?: string;
  bottomCtaLabel?: string;
  bottomCtaLink?: string;
}

const london = rawLondon as LondonData;

const displayAs = london.displayAs || "local-video";
const localVideoPath = london.localVideoPath || "/showreel.mp4";
const cloudVideoUrl = london.cloudVideoUrl || "";
const imagePath = london.imagePath || "/og-image.jpg";
const siteUrl = "https://filmeditrun.co.uk";
const ogImage = imagePath.startsWith("http") ? imagePath : `${siteUrl}${imagePath}`;
const expertiseBullets = london.expertiseBullets ?? [];
const faqs = london.faqs ?? [];
const lookbookTag = london.lookbookTag || "Field Dispatches // London";
const lookbookHeroImage = london.lookbookHeroImage || "/og-image.jpg";
const lookbookHeroBadge = london.lookbookHeroBadge || "ExCeL London • 4K Multi-Cam Stage";
const lookbookDetail1Image = london.lookbookDetail1Image || "/og-image.jpg";
const lookbookDetail1Badge = london.lookbookDetail1Badge || "City of London • Executive Profiles";
const lookbookDetail2Image = london.lookbookDetail2Image || "/og-image.jpg";
const lookbookDetail2Badge = london.lookbookDetail2Badge || "Kings Cross • Live Audio & Cinema Rigs";

const parseBadge = (badgeStr?: string) => {
  if (!badgeStr) return { tag: '', title: '' };
  const parts = badgeStr.split('•').map(s => s.trim());
  if (parts.length >= 2) {
    return { tag: parts[0], title: parts[1] };
  }
  return { tag: badgeStr, title: '' };
};

// Specific LocalBusiness, FAQPage & BreadcrumbList Schema for London
const londonSchemas: Record<string, any>[] = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "FilmEditRun London",
    "description": "Corporate video production and multi-camera event filming serving Central London, the City, and Greater London.",
    "url": "https://filmeditrun.co.uk/london/",
    "areaServed": [
      {
        "@type": "City",
        "name": "London"
      },
      {
        "@type": "AdministrativeArea",
        "name": "Greater London"
      }
    ],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "London",
      "addressRegion": "Greater London",
      "addressCountry": "GB"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "London Production Hub",
        "item": "https://filmeditrun.co.uk/london/"
      }
    ]
  }
];

if (faqs.length > 0) {
  londonSchemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  });
}
---

<Layout
  title={london.seoTitle}
  description={london.seoDescription}
  canonical={london.canonicalURL || "https://filmeditrun.co.uk/london/"}
  ogImage={ogImage}
  jsonLd={londonSchemas}
  fullBleed={true}
>

  <div class="w-full relative z-10 bg-ink min-h-screen">

    <!-- ============================================================== -->
    <!-- 1. CINEMATIC HERO BANNER (Matches Services Subpage Lighting)   -->
    <!-- ============================================================== -->
    <header data-cinema-darkroom class="relative w-full pt-28 pb-14 sm:pt-36 sm:pb-24 lg:pt-40 lg:pb-28 sm:min-h-[600px] lg:min-h-[640px] flex flex-col justify-center overflow-hidden border-b border-white/10 select-none">
      
      <!-- Video / Photo Media Backdrop Layer (Clear, vibrant background) -->
      <div class="absolute inset-0 z-0 bg-neutral-950 pointer-events-none overflow-hidden">
        <!-- Master Cinematic ND Filter (Guaranteed AA Contrast Across Video Feeds) -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/60 to-black/90 z-10 pointer-events-none" aria-hidden="true"></div>

        <!-- Ambient Amber Spotlight Glow at Top Center -->
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[40rem] sm:w-[56rem] h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none z-10" aria-hidden="true"></div>

        {/* Video Background (Local or Cloud) */}
        {(displayAs === "local-video" || displayAs === "link-video") && (
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={imagePath}
            class="absolute inset-0 w-full h-full object-cover opacity-90 sm:opacity-95 z-0"
          >
            <source
              src={displayAs === "local-video" ? localVideoPath : cloudVideoUrl}
              type="video/mp4"
            />
          </video>
        )}

        {/* Static Image Background */}
        {displayAs === "image" && (
          <img
            src={imagePath}
            alt={london.seoTitle}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover opacity-80 sm:opacity-85 z-0"
          />
        )}
      </div>

      <!-- Main Banner Content -->
      <div class="relative z-20 max-w-6xl mx-auto px-6 w-full">
        
        <!-- Studio Category Eyebrow Badge (TinaCMS Editable) -->
        <div class="mb-6">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-mono uppercase tracking-widest font-semibold backdrop-blur-md bg-amber-500/10 border border-amber-500/25 text-amber-400 shadow-sm shadow-amber-500/10 select-none">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
            </span>
            <span>{london.heroTag || "London Production Hub"}</span>
          </div>
        </div>

        <!-- Large Title with Asterisk Gradient Support -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white keep-white tracking-tight leading-[1.08] mb-6 max-w-4xl text-balance">
          {london.heroHeadingPrefix} <br class="hidden sm:inline" /><span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">{london.heroHeadingHighlight}</span>
        </h1>

        <!-- Hero Lead Hook / Value Proposition -->
        <p class="text-base sm:text-lg lg:text-xl text-neutral-300 font-normal leading-relaxed tracking-[-0.01em] max-w-2xl mb-8">
          {london.heroSubtitle}
        </p>

        <!-- Primary Action -->
        <div>
          <a
            href={london.heroCtaLink}
            class="inline-block bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold px-8 py-3.5 rounded-xl text-base transition-all shadow-xl shadow-amber-500/20 hover:scale-[1.02] text-center"
          >
            {london.heroCtaLabel} &rarr;
          </a>
        </div>

      </div>

    </header>

    <!-- Local Hub Context Section -->
    <section class="max-w-6xl mx-auto px-6 py-24 sm:py-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono block mb-2">{london.expertiseTag}</span>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-4 leading-tight">{london.expertiseHeading}</h2>
          <p class="text-neutral-400 leading-relaxed mb-6 font-light">
            {london.expertiseDescription}
          </p>
          {expertiseBullets.length > 0 && (
            <ul class="space-y-3 text-neutral-300 text-sm font-mono">
              {expertiseBullets.map((bullet) => (
                <li class="flex items-center gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0"></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div class="bg-neutral-900/80 border border-neutral-800 p-8 sm:p-10 rounded-2xl shadow-xl">
          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">{london.cardTitle}</h3>
          <p class="text-neutral-400 text-sm sm:text-base leading-relaxed mb-6 font-light">
            {london.cardBody}
          </p>
          <a href={london.cardLinkHref} class="group inline-flex items-center gap-2 text-amber-500 hover:text-amber-400 font-mono text-sm font-medium transition-colors">
            <span>{london.cardLinkLabel?.replace(/[➔→]\s*$/, '') || "View Selected Works"}</span>
            <span class="group-hover:translate-x-1 transition-transform font-bold">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
    <section class="max-w-6xl mx-auto px-6 py-16 sm:py-20 border-t border-neutral-900">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
          {lookbookTag}
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 sm:gap-6 items-stretch">
        <!-- Large Left Hero Frame (3 of 5 cols) -->
        <div 
          tabindex="0"
          class="lg:col-span-3 group relative rounded-xl sm:rounded-2xl overflow-hidden border border-neutral-800 bg-neutral-950 shadow-2xl transition-all duration-300 hover:border-amber-500/60 focus:border-amber-500/60 min-h-[300px] sm:min-h-[420px] cursor-pointer"
        >
          <img
            src={lookbookHeroImage}
            alt={lookbookHeroBadge}
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 group-focus:scale-105"
            loading="lazy"
          />

          <!-- Atmospheric Dark Scrim on Hover / Tap -->
          <div 
            class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300 ease-out" 
            aria-hidden="true"
          ></div>

          <!-- Content Revealed on Hover / Tap -->
          {lookbookHeroBadge && (() => {
            const { tag, title } = parseBadge(lookbookHeroBadge);
            return (
              <figcaption class="absolute inset-x-0 bottom-0 p-5 sm:p-7 pointer-events-none z-10 bg-transparent">
                <div class="transform translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-300 ease-out max-w-xl">
                  {tag && (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-amber-500/20 border border-amber-500/30 text-amber-400 text-xs font-mono uppercase tracking-wider font-semibold mb-2 backdrop-blur-md">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                      {tag}
                    </span>
                  )}
                  {title && (
                    <h3 class="text-xl sm:text-2xl font-bold text-white keep-white tracking-tight drop-shadow-md leading-tight">
                      {title}
                    </h3>
                  )}
                </div>
              </figcaption>
            );
          })()}
        </div>

        <!-- Stacked Right Detail Frames (2 of 5 cols) -->
        <div class="lg:col-span-2 flex flex-col gap-4 sm:gap-6">
          <div 
            tabindex="0"
            class="group relative rounded-xl sm:rounded-2xl overflow-hidden border border-neutral-800 bg-neutral-950 shadow-2xl transition-all duration-300 hover:border-amber-500/60 focus:border-amber-500/60 aspect-[16/10] sm:aspect-[16/9] flex-1 cursor-pointer"
          >
            <img
              src={lookbookDetail1Image}
              alt={lookbookDetail1Badge}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 group-focus:scale-105"
              loading="lazy"
            />

            <!-- Atmospheric Dark Scrim on Hover / Tap -->
            <div 
              class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300 ease-out" 
              aria-hidden="true"
            ></div>

            <!-- Content Revealed on Hover / Tap -->
            {lookbookDetail1Badge && (() => {
              const { tag, title } = parseBadge(lookbookDetail1Badge);
              return (
                <figcaption class="absolute inset-x-0 bottom-0 p-4 sm:p-5 pointer-events-none z-10 bg-transparent">
                  <div class="transform translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-300 ease-out">
                    {tag && (
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-amber-500/20 border border-amber-500/30 text-amber-400 text-[10px] sm:text-xs font-mono uppercase tracking-wider font-semibold mb-1.5 backdrop-blur-md">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                        {tag}
                      </span>
                    )}
                    {title && (
                      <h3 class="text-base sm:text-lg font-bold text-white keep-white tracking-tight drop-shadow-md leading-tight">
                        {title}
                      </h3>
                    )}
                  </div>
                </figcaption>
              );
            })()}
          </div>

          <div 
            tabindex="0"
            class="group relative rounded-xl sm:rounded-2xl overflow-hidden border border-neutral-800 bg-neutral-950 shadow-2xl transition-all duration-300 hover:border-amber-500/60 focus:border-amber-500/60 aspect-[16/10] sm:aspect-[16/9] flex-1 cursor-pointer"
          >
            <img
              src={lookbookDetail2Image}
              alt={lookbookDetail2Badge}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 group-focus:scale-105"
              loading="lazy"
            />

            <!-- Atmospheric Dark Scrim on Hover / Tap -->
            <div 
              class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300 ease-out" 
              aria-hidden="true"
            ></div>

            <!-- Content Revealed on Hover / Tap -->
            {lookbookDetail2Badge && (() => {
              const { tag, title } = parseBadge(lookbookDetail2Badge);
              return (
                <figcaption class="absolute inset-x-0 bottom-0 p-4 sm:p-5 pointer-events-none z-10 bg-transparent">
                  <div class="transform translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-300 ease-out">
                    {tag && (
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-amber-500/20 border border-amber-500/30 text-amber-400 text-[10px] sm:text-xs font-mono uppercase tracking-wider font-semibold mb-1.5 backdrop-blur-md">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                        {tag}
                      </span>
                    )}
                    {title && (
                      <h3 class="text-base sm:text-lg font-bold text-white keep-white tracking-tight drop-shadow-md leading-tight">
                        {title}
                      </h3>
                    )}
                  </div>
                </figcaption>
              );
            })()}
          </div>
        </div>
      </div>
    </section>

    <!-- London FAQ Section -->
    {faqs.length > 0 && (
      <section class="max-w-4xl mx-auto px-6 py-20 border-t border-neutral-900">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-white mb-10 text-center">{london.faqHeading}</h2>
        
        <div class="space-y-6">
          {faqs.map((faq) => (
            <div class="bg-neutral-900/50 border border-neutral-800 p-6 rounded-xl">
              <h3 class="text-lg font-semibold text-white mb-2">{faq.question}</h3>
              <p class="text-neutral-400 text-sm leading-relaxed font-light">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Bottom CTA -->
    <CtaSection
      tag="LONDON ON-LOCATION HUB"
      heading={london.bottomCtaHeading || "Planning a conference or shoot in *London?*"}
      description={london.bottomCtaBody}
      primaryButtonLabel={london.bottomCtaLabel || "Discuss Your London Project →"}
      primaryButtonLink={london.bottomCtaLink || "/contact"}
      secondaryButtonLabel="Explore Cambridge Hub →"
      secondaryButtonLink="/cambridge"
      trustSignals={[
        "Low-Profile On-Site Footprint",
        "Multi-Camera 4K Live Coverage",
        "Optional 24–48h Highlight Delivery"
      ]}
    />

  </div>
</Layout>

