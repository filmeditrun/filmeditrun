            <!-- Column 2: Core Services -->
            <div class="space-y-4">
                <h4 class="text-white font-bold uppercase text-sm tracking-wider">Core Services</h4>
                <ul class="space-y-2.5 text-sm text-mutedText font-medium">
                    <li><button onclick="switchView('services')" class="hover:text-accentBlue transition-colors">Commercial Filming</button></li>
                    <li><button onclick="switchView('services')" class="hover:text-accentBlue transition-colors">Offline/Online Editing</button></li>
                    <li><button onclick="switchView('services')" class="hover:text-accentBlue transition-colors">Hollywood Color</button></li>
