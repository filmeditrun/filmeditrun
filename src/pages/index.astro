    <script>
        function switchView(viewId) {
            const sections = document.querySelectorAll('.view-section');
            sections.forEach(sec => sec.classList.remove('active'));
            const target = document.getElementById('view-' + viewId);
            if (target) {
                target.classList.add('active');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
            const navLinks = document.querySelectorAll('.nav-link');
            navLinks.forEach(link => {
                link.classList.remove('text-accentBlue');
                link.classList.add('text-mutedText');
            });
            const activeNav = document.getElementById('nav-' + viewId);
            if (activeNav) {
                activeNav.classList.remove('text-mutedText');
                activeNav.classList.add('text-accentBlue');
            }
        }

        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        function openServiceModal(title, category, desc, turnaround, deliverable) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-category').innerText = category + ' • Sub-Page';
            document.getElementById('modal-description').innerText = desc;
            document.getElementById('modal-turnaround').innerText = turnaround;
            document.getElementById('modal-deliverable').innerText = deliverable;
            document.getElementById('modal-book-btn').setAttribute('onclick', `closeServiceModal(); selectServiceAndContact('${title}');`);
            const modal = document.getElementById('service-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeServiceModal() {
            const modal = document.getElementById('service-modal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }

        function selectServiceAndContact(serviceName) {
            switchView('contact');
            document.getElementById('input-service-selected').value = serviceName;
        }

        let currentStep = 1;
        function updateFormSteps() {
            const steps = document.querySelectorAll('.form-step');
            steps.forEach(step => {
                const stepNum = parseInt(step.getAttribute('data-step'));
                if (stepNum === currentStep) {
                    step.classList.remove('hidden');
                    step.classList.add('active');
                } else {
                    step.classList.add('hidden');
                    step.classList.remove('active');
                }
            });
            document.getElementById('form-progress').style.width = (currentStep * 25) + '%';
        }

        function nextStep(targetStep) {
            if (currentStep === 1 && (!document.getElementById('input-name').value || !document.getElementById('input-email').value)) {
                alert('Please enter your name and email.');
                return;
            }
            if (currentStep === 3) {
                document.getElementById('review-name').innerText = document.getElementById('input-name').value;
                document.getElementById('review-email').innerText = document.getElementById('input-email').value;
                document.getElementById('review-service').innerText = document.getElementById('input-service-selected').value;
            }
            currentStep = targetStep;
            updateFormSteps();
        }

        function prevStep(targetStep) {
            currentStep = targetStep;
            updateFormSteps();
        }

        function handleFormSubmit(event) {
            event.preventDefault();
            if (!document.getElementById('input-gdpr').checked) {
                alert('Please accept the GDPR checkbox.');
                return;
            }
            document.getElementById('multi-step-form').classList.add('hidden');
            document.getElementById('form-success').classList.remove('hidden');
        }

        function resetContactForm() {
            document.getElementById('multi-step-form').reset();
            document.getElementById('multi-step-form').classList.remove('hidden');
            document.getElementById('form-success').classList.add('hidden');
            currentStep = 1;
            updateFormSteps();
        }
    </script>
</body>
