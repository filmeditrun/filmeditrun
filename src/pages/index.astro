<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Filmeditrun.co.uk - Cinematic Creatives</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#0f1115',
                        darkCard: '#181b22',
                        accentBlue: '#00f0ff',
                        accentBlueHover: '#00c4d4',
                        mutedText: '#9ca3af'
                    },
                    fontFamily: {
                        dosis: ['Dosis', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts: Dosis -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dosis:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Dosis', sans-serif;
            background-color: #0f1115;
            color: #ffffff;
            overflow-x: hidden;
        }
        .glass-nav {
            background: rgba(15, 17, 21, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-card {
            background: rgba(24, 27, 34, 0.75);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-card:hover {
            border-color: rgba(0, 240, 255, 0.4);
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.15);
        }
        .glow-button {
            background: linear-gradient(135deg, #00f0ff 0%, #3b82f6 100%);
            transition: all 0.3s ease;
        }
        .glow-button:hover {
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.5);
            transform: translateY(-2px);
        }
        .view-section {
            display: none;
            opacity: 0;
            transition: opacity 0.4s ease-in-out;
        }
        .view-section.active {
            display: block;
            opacity: 1;
        }
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f1115;
        }
        ::-webkit-scrollbar-thumb {
            background: #272a35;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00f0ff;
        }
    </style>
</head>
<body class="bg-darkBg text-white antialiased selection:bg-accentBlue selection:text-black">

    <header class="fixed top-0 left-0 right-0 z-50 glass-nav transition-all duration-300">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <a href="#" onclick="switchView('home')" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-accentBlue to-blue-600 flex items-center justify-center text-darkBg font-bold text-xl shadow-lg group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-clapperboard"></i>
                </div>
                <div class="flex flex-col">
                    <span class="text-2xl font-extrabold tracking-wider uppercase">FILMEDIT<span class="text-accentBlue">RUN</span></span>
                    <span class="text-[10px] tracking-widest text-mutedText uppercase font-semibold">Cinematic Creatives</span>
                </div>
            </a>

            <nav class="hidden md:flex items-center gap-8 font-medium text-lg">
                <button onclick="switchView('home')" id="nav-home" class="nav-link text-accentBlue transition-colors hover:text-accentBlue">Home</button>
                <button onclick="switchView('services')" id="nav-services" class="nav-link text-mutedText hover:text-white transition-colors">Services</button>
                <button onclick="switchView('about')" id="nav-about" class="nav-link text-mutedText hover:text-white transition-colors">About Us</button>
                <button onclick="switchView('contact')" id="nav-contact" class="nav-link text-mutedText hover:text-white transition-colors">Contact</button>
            </nav>

            <div class="hidden md:block">
                <button onclick="switchView('contact')" class="glow-button px-6 py-2.5 rounded-xl font-bold text-darkBg tracking-wide">
                    Start Project
                </button>
            </div>

            <button onclick="toggleMobileMenu()" class="md:hidden text-2xl text-white focus:outline-none">
                <i class="fa-solid fa-bars" id="mobile-menu-icon"></i>
            </button>
        </div>

        <div id="mobile-menu" class="hidden md:hidden glass-card border-t border-white/10 px-6 py-6 space-y-4">
            <button onclick="switchView('home'); toggleMobileMenu();" class="block w-full text-left text-lg font-medium text-accentBlue py-2">Home</button>
            <button onclick="switchView('services'); toggleMobileMenu();" class="block w-full text-left text-lg font-medium text-white py-2">Services</button>
            <button onclick="switchView('about'); toggleMobileMenu();" class="block w-full text-left text-lg font-medium text-white py-2">About Us</button>
            <button onclick="switchView('contact'); toggleMobileMenu();" class="block w-full text-left text-lg font-medium text-white py-2">Contact</button>
            <button onclick="switchView('contact'); toggleMobileMenu();" class="w-full glow-button py-3 rounded-xl font-bold text-darkBg text-center">Start Project</button>
        </div>
    </header>

    <main class="pt-20">

        <!-- HOME VIEW -->
        <section id="view-home" class="view-section active">
            <div class="relative h-[calc(100vh-5rem)] min-h-[600px] flex items-center justify-center overflow-hidden">
                <div class="absolute inset-0 z-0 overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-t from-darkBg via-darkBg/60 to-black/40 z-10"></div>
                    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-blue-900/20 via-darkBg/80 to-darkBg z-0"></div>
                    <div class="absolute inset-0 opacity-40 bg-[url('https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?q=80&w=1920&auto=format&fit=crop')] bg-cover bg-center transform scale-105"></div>
                </div>

                <div class="relative z-20 max-w-5xl mx-auto px-6 text-center space-y-8">
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-card border border-accentBlue/30 text-accentBlue text-sm font-semibold tracking-wider uppercase">
                        <i class="fa-solid fa-video"></i> 4 Flagship Services • Media-Rich Asset Preview Blocks
                    </div>
                    <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tight uppercase leading-none">
                        Cinematic <span class="text-transparent bg-clip-text bg-gradient-to-r from-accentBlue to-blue-500">Creatives</span>
                    </h1>
                    <p class="max-w-2xl mx-auto text-xl md:text-2xl text-mutedText font-light">
                        Lightning-fast static performance. Start simple with 4 foundational services featuring associated video and photo reference assets.
                    </p>
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
                        <button onclick="switchView('services')" class="w-full sm:w-auto glow-button px-8 py-4 rounded-xl font-bold text-darkBg text-lg tracking-wide flex items-center justify-center gap-3">
                            <span>Explore 4 Core Services</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                        <button onclick="switchView('contact')" class="w-full sm:w-auto glass-card px-8 py-4 rounded-xl font-bold text-white text-lg tracking-wide hover:bg-white/15 transition-colors flex items-center justify-center gap-3">
                            <i class="fa-solid fa-envelope text-accentBlue"></i>
                            <span>Get Custom Quote</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- SERVICES VIEW -->
        <section id="view-services" class="view-section py-20 px-6 max-w-7xl mx-auto">
            <div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
                <span class="text-accentBlue font-bold tracking-widest uppercase text-sm">Starter Architecture</span>
                <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tight">Our Core Services (4 Offerings)</h2>
                <p class="text-mutedText text-lg">Each service includes an associated video or photo block showcasing real creative output.</p>
            </div>

            <div id="services-grid" class="space-y-8 max-w-5xl mx-auto">
                
                <!-- Service 1 -->
                <div class="service-card glass-card rounded-2xl p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center group border-accentBlue/30 shadow-[0_0_20px_rgba(0,240,255,0.1)]">
                    <div class="lg:col-span-7 space-y-4">
                        <div class="flex items-center justify-between">
                            <span class="px-3 py-1 rounded-full bg-accentBlue/20 text-accentBlue text-xs font-bold uppercase tracking-wider">Filming & Production</span>
                            <span class="text-xs text-mutedText font-semibold"><i class="fa-regular fa-clock mr-1"></i> 3-5 Days</span>
                        </div>
                        <h3 class="text-2xl md:text-3xl font-bold group-hover:text-accentBlue transition-colors">1. Commercial & Brand Filming</h3>
                        <p class="text-mutedText text-base">High-impact cinematic commercials tailored for TV and digital campaigns with full lighting and 8K camera packages.</p>
                        <div class="pt-4 flex items-center gap-4">
                            <button onclick="openServiceModal('Commercial & Brand Filming', 'Filming & Production', 'High-impact cinematic commercials tailored for TV and digital campaigns with full lighting and 8K camera packages.', '3-5 Days', '4K / 8K ProRes Raw')" class="text-accentBlue font-bold text-sm flex items-center gap-2 hover:underline">
                                <span>View Full Sub-Page</span> <i class="fa-solid fa-arrow-right"></i>
                            </button>
                            <button onclick="selectServiceAndContact('Commercial & Brand Filming')" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-accentBlue hover:text-darkBg text-xs font-bold transition-all">
                                Book Service
                            </button>
                        </div>
                    </div>
                    <div class="lg:col-span-5 relative group/media overflow-hidden rounded-xl border border-white/10 bg-black/40">
                        <div class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-md bg-black/70 backdrop-blur-md text-[10px] font-bold text-accentBlue uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fa-solid fa-video"></i> Associated Video Reel
                        </div>
                        <div class="h-48 md:h-56 bg-[url('https://images.unsplash.com/photo-1536240478700-b869070f9279?q=80&w=800&auto=format&fit=crop')] bg-cover bg-center transition-transform duration-500 group-hover/media:scale-105"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-4">
                            <span class="text-xs text-mutedText font-medium">Sample 8K Commercial Breakdown (0:45)</span>
                        </div>
                    </div>
                </div>

                <!-- Service 2 -->
                <div class="service-card glass-card rounded-2xl p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center group border-accentBlue/30 shadow-[0_0_20px_rgba(0,240,255,0.1)]">
                    <div class="lg:col-span-7 space-y-4">
                        <div class="flex items-center justify-between">
                            <span class="px-3 py-1 rounded-full bg-accentBlue/20 text-accentBlue text-xs font-bold uppercase tracking-wider">Post-Production</span>
                            <span class="text-xs text-mutedText font-semibold"><i class="fa-regular fa-clock mr-1"></i> 3-7 Days</span>
                        </div>
                        <h3 class="text-2xl md:text-3xl font-bold group-hover:text-accentBlue transition-colors">2. Offline & Online Editing</h3>
                        <p class="text-mutedText text-base">Precise timeline curation, narrative pacing, proxy workflows, and final conform in Premiere Pro and DaVinci Resolve.</p>
                        <div class="pt-4 flex items-center gap-4">
                            <button onclick="openServiceModal('Offline & Online Editing', 'Post-Production', 'Precise timeline curation, narrative pacing, proxy workflows, and final conform in Premiere Pro and DaVinci Resolve.', '3-7 Days', 'Premiere / Resolve XML')" class="text-accentBlue font-bold text-sm flex items-center gap-2 hover:underline">
                                <span>View Full Sub-Page</span> <i class="fa-solid fa-arrow-right"></i>
                            </button>
                            <button onclick="selectServiceAndContact('Offline & Online Editing')" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-accentBlue hover:text-darkBg text-xs font-bold transition-all">
                                Book Service
                            </button>
                        </div>
                    </div>
                    <div class="lg:col-span-5 relative group/media overflow-hidden rounded-xl border border-white/10 bg-black/40">
                        <div class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-md bg-black/70 backdrop-blur-md text-[10px] font-bold text-accentBlue uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fa-solid fa-photo-film"></i> Associated Timeline Photo
                        </div>
                        <div class="h-48 md:h-56 bg-[url('https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?q=80&w=800&auto=format&fit=crop')] bg-cover bg-center transition-transform duration-500 group-hover/media:scale-105"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-4">
                            <span class="text-xs text-mutedText font-medium">Multi-cam NLE Workflow & Conforming</span>
                        </div>
                    </div>
                </div>

                <!-- Service 3 -->
                <div class="service-card glass-card rounded-2xl p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center group border-accentBlue/30 shadow-[0_0_20px_rgba(0,240,255,0.1)]">
                    <div class="lg:col-span-7 space-y-4">
                        <div class="flex items-center justify-between">
                            <span class="px-3 py-1 rounded-full bg-accentBlue/20 text-accentBlue text-xs font-bold uppercase tracking-wider">Color & Sound</span>
                            <span class="text-xs text-mutedText font-semibold"><i class="fa-regular fa-clock mr-1"></i> 2-4 Days</span>
                        </div>
                        <h3 class="text-2xl md:text-3xl font-bold group-hover:text-accentBlue transition-colors">3. Hollywood Color Grading</h3>
                        <p class="text-mutedText text-base">DaVinci Resolve professional color grading, custom LUT creation, skin tone balancing, and cinematic mood styling.</p>
                        <div class="pt-4 flex items-center gap-4">
                            <button onclick="openServiceModal('Hollywood Color Grading', 'Color & Sound', 'DaVinci Resolve professional color grading, custom LUT creation, skin tone balancing, and cinematic mood styling.', '2-4 Days', 'HDR / Rec.709 Master')" class="text-accentBlue font-bold text-sm flex items-center gap-2 hover:underline">
                                <span>View Full Sub-Page</span> <i class="fa-solid fa-arrow-right"></i>
                            </button>
                            <button onclick="selectServiceAndContact('Hollywood Color Grading')" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-accentBlue hover:text-darkBg text-xs font-bold transition-all">
                                Book Service
                            </button>
                        </div>
                    </div>
                    <div class="lg:col-span-5 relative group/media overflow-hidden rounded-xl border border-white/10 bg-black/40">
                        <div class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-md bg-black/70 backdrop-blur-md text-[10px] font-bold text-accentBlue uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fa-solid fa-image"></i> Associated Before / After
                        </div>
                        <div class="h-48 md:h-56 bg-[url('https://images.unsplash.com/photo-1485846234645-a62644f84728?q=80&w=800&auto=format&fit=crop')] bg-cover bg-center transition-transform duration-500 group-hover/media:scale-105"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-4">
                            <span class="text-xs text-mutedText font-medium">DaVinci Resolve Node Grade Comparison</span>
                        </div>
                    </div>
                </div>

                <!-- Service 4 -->
                <div class="service-card glass-card rounded-2xl p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center group border-accentBlue/30 shadow-[0_0_20px_rgba(0,240,255,0.1)]">
                    <div class="lg:col-span-7 space-y-4">
                        <div class="flex items-center justify-between">
                            <span class="px-3 py-1 rounded-full bg-accentBlue/20 text-accentBlue text-xs font-bold uppercase tracking-wider">Color & Sound</span>
                            <span class="text-xs text-mutedText font-semibold"><i class="fa-regular fa-clock mr-1"></i> 3-5 Days</span>
                        </div>
                        <h3 class="text-2xl md:text-3xl font-bold group-hover:text-accentBlue transition-colors">4. Immersive Sound Design</h3>
                        <p class="text-mutedText text-base">Professional dialog cleanup, ADR, custom Foley sound effects, and Dolby Atmos cinematic sound mixing.</p>
                        <div class="pt-4 flex items-center gap-4">
                            <button onclick="openServiceModal('Immersive Sound Design', 'Color & Sound', 'Professional dialog cleanup, ADR, custom Foley sound effects, and Dolby Atmos cinematic sound mixing.', '3-5 Days', '5.1 / Dolby Atmos Mix')" class="text-accentBlue font-bold text-sm flex items-center gap-2 hover:underline">
                                <span>View Full Sub-Page</span> <i class="fa-solid fa-arrow-right"></i>
                            </button>
                            <button onclick="selectServiceAndContact('Immersive Sound Design')" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-accentBlue hover:text-darkBg text-xs font-bold transition-all">
                                Book Service
                            </button>
                        </div>
                    </div>
                    <div class="lg:col-span-5 relative group/media overflow-hidden rounded-xl border border-white/10 bg-black/40">
                        <div class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-md bg-black/70 backdrop-blur-md text-[10px] font-bold text-accentBlue uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fa-solid fa-headphones"></i> Associated Audio Waveform
                        </div>
                        <div class="h-48 md:h-56 bg-[url('https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?q=80&w=800&auto=format&fit=crop')] bg-cover bg-center transition-transform duration-500 group-hover/media:scale-105"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-4">
                            <span class="text-xs text-mutedText font-medium">Dolby Atmos 7.1.4 Mixing Session View</span>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- ABOUT VIEW -->
        <section id="view-about" class="view-section py-20 px-6 max-w-7xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
                <div class="space-y-6">
                    <span class="text-accentBlue font-bold tracking-widest uppercase text-sm">Cinematic Creatives Identity</span>
                    <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tight">Mastering the Art of Visual Storytelling</h2>
                    <p class="text-mutedText text-lg leading-relaxed">
                        Starting with 4 core services allows you to launch your static site instantly with zero clutter. As your studio expands, adding services takes seconds without restructuring your codebase.
                    </p>
                </div>
                <div class="relative">
                    <div class="absolute -inset-2 bg-gradient-to-r from-accentBlue to-blue-600 rounded-2xl blur-lg opacity-30"></div>
                    <div class="relative glass-card p-4 rounded-2xl overflow-hidden">
                        <div class="h-80 rounded-xl bg-[url('https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?q=80&w=1000&auto=format&fit=crop')] bg-cover bg-center"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CONTACT VIEW -->
        <section id="view-contact" class="view-section py-20 px-6 max-w-3xl mx-auto">
            <div class="text-center mb-12 space-y-3">
                <span class="text-accentBlue font-bold tracking-widest uppercase text-sm">Get In Touch</span>
                <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tight">Start Your Project</h2>
                <p class="text-mutedText">Complete our interactive brief below to connect with our creative team.</p>
            </div>

            <div class="glass-card rounded-2xl p-8 md:p-12 shadow-2xl relative">
                <div class="w-full bg-white/10 h-1.5 rounded-full mb-8 overflow-hidden">
                    <div id="form-progress" class="bg-accentBlue h-full transition-all duration-300 w-1/4"></div>
                </div>

                <form id="multi-step-form" onsubmit="handleFormSubmit(event)">
                    <div class="form-step active space-y-6" data-step="1">
                        <div class="space-y-2">
                            <span class="text-accentBlue text-sm font-bold tracking-widest uppercase">Step 01 / 04</span>
                            <h3 class="text-2xl md:text-3xl font-bold">What is your name and email?</h3>
                        </div>
                        <div class="space-y-4 pt-4">
                            <div>
                                <label class="block text-sm font-medium text-mutedText mb-2">Your Name *</label>
                                <input type="text" id="input-name" required placeholder="e.g. Alex Harrison" class="w-full bg-darkBg border border-white/10 rounded-xl px-4 py-3.5 text-white focus:outline-none focus:border-accentBlue">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-mutedText mb-2">Email Address *</label>
                                <input type="email" id="input-email" required placeholder="alex@company.com" class="w-full bg-darkBg border border-white/10 rounded-xl px-4 py-3.5 text-white focus:outline-none focus:border-accentBlue">
                            </div>
                        </div>
                        <div class="flex justify-end pt-6">
                            <button type="button" onclick="nextStep(2)" class="glow-button px-8 py-3.5 rounded-xl font-bold text-darkBg flex items-center gap-2">
                                <span>Next Step</span> <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-step hidden space-y-6" data-step="2">
                        <div class="space-y-2">
                            <span class="text-accentBlue text-sm font-bold tracking-widest uppercase">Step 02 / 04</span>
                            <h3 class="text-2xl md:text-3xl font-bold">What service do you need?</h3>
                        </div>
                        <div class="pt-4 space-y-4">
                            <label class="block text-sm font-medium text-mutedText mb-2">Selected Service *</label>
                            <input type="text" id="input-service-selected" value="Commercial & Brand Filming" class="w-full bg-darkBg border border-accentBlue rounded-xl px-4 py-3.5 text-accentBlue font-bold focus:outline-none">
                        </div>
                        <div class="flex justify-between pt-6">
                            <button type="button" onclick="prevStep(1)" class="glass-card px-6 py-3.5 rounded-xl font-bold text-white hover:bg-white/15">Back</button>
                            <button type="button" onclick="nextStep(3)" class="glow-button px-8 py-3.5 rounded-xl font-bold text-darkBg">Next Step</button>
                        </div>
                    </div>

                    <div class="form-step hidden space-y-6" data-step="3">
                        <div class="space-y-2">
                            <span class="text-accentBlue text-sm font-bold tracking-widest uppercase">Step 03 / 04</span>
                            <h3 class="text-2xl md:text-3xl font-bold">Tell us about your project brief</h3>
                        </div>
                        <div class="pt-4">
                            <textarea id="input-brief" rows="5" required placeholder="Describe your vision..." class="w-full bg-darkBg border border-white/10 rounded-xl p-4 text-white focus:outline-none focus:border-accentBlue resize-none"></textarea>
                        </div>
                        <div class="flex justify-between pt-6">
                            <button type="button" onclick="prevStep(2)" class="glass-card px-6 py-3.5 rounded-xl font-bold text-white">Back</button>
                            <button type="button" onclick="nextStep(4)" class="glow-button px-8 py-3.5 rounded-xl font-bold text-darkBg">Next Step</button>
                        </div>
                    </div>

                    <div class="form-step hidden space-y-6" data-step="4">
                        <div class="space-y-2">
                            <span class="text-accentBlue text-sm font-bold tracking-widest uppercase">Step 04 / 04</span>
                            <h3 class="text-2xl md:text-3xl font-bold">Final Review & Consent</h3>
                        </div>
                        <div class="pt-4 space-y-6">
                            <div class="glass-card p-4 rounded-xl space-y-2 text-sm text-mutedText">
                                <div class="flex justify-between"><strong class="text-white">Name:</strong> <span id="review-name">-</span></div>
                                <div class="flex justify-between"><strong class="text-white">Email:</strong> <span id="review-email">-</span></div>
                                <div class="flex justify-between"><strong class="text-white">Service:</strong> <span id="review-service">-</span></div>
                            </div>
                            <label class="flex items-start gap-3 cursor-pointer">
                                <input type="checkbox" id="input-gdpr" required class="mt-1 w-5 h-5 accent-accentBlue rounded bg-darkBg border-white/10">
                                <span class="text-sm text-mutedText">I consent to storing my data in accordance with GDPR. *</span>
                            </label>
                        </div>
                        <div class="flex justify-between pt-6">
                            <button type="button" onclick="prevStep(3)" class="glass-card px-6 py-3.5 rounded-xl font-bold text-white">Back</button>
                            <button type="submit" class="glow-button px-8 py-3.5 rounded-xl font-bold text-darkBg">Submit Brief</button>
                        </div>
                    </div>
                </form>

                <div id="form-success" class="hidden text-center py-12 space-y-6">
                    <div class="w-20 h-20 bg-accentBlue/20 text-accentBlue rounded-full flex items-center justify-center text-4xl mx-auto border border-accentBlue">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <h3 class="text-3xl font-extrabold uppercase">Brief Received Successfully!</h3>
                    <button onclick="resetContactForm()" class="glow-button px-8 py-3 rounded-xl font-bold text-darkBg">Send Another</button>
                </div>
            </div>
        </section>

    </main>

