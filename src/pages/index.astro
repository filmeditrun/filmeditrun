---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaSection from '../components/CtaSection.astro';
import home from '../content/pages/home.json';
import servicesPage from '../content/pages/services.json';
import cambridgePage from '../content/pages/cambridge.json';
import londonPage from '../content/pages/london.json';

// Helper for asterisk formatting:
// parseHeading: Amber Gradient Text (used on hero & full-bleed parallax breaks)
const parseHeading = (text: string) => {
  if (!text) return "";
  if (text.includes('*')) {
    return text.replace(/\*(.*?)\*/g, '<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600">$1</span>');
  }
  return text;
};

// parseHeadingWithLine: Solid Text with Animated Gradient Underline (used on in-page sections)
const parseHeadingWithLine = (text: string) => {
  if (!text) return "";
  if (text.includes('*')) {
    return text.replace(/\*(.*?)\*/g, '<span class="animated-accent-underline">$1</span>');
  }
  return text;
};

// 1. Dynamically import all 6 services from TinaCMS for the Capabilities Bento Grid
interface ServiceEntry {
  order: string;
  title: string;
  tag: string;
  description: string;
  link?: string;
  slug?: string;
  imagePath?: string;
}

const serviceFiles = import.meta.glob<ServiceEntry>('../content/services/*.json', {
  eager: true,
  import: 'default',
});

const services = Object.values(serviceFiles)
  .sort((a, b) => (a.order || "").localeCompare(b.order || "", undefined, { numeric: true }))
  .map((s) => ({
    ...s,
    href: s.link || `/services/${s.slug}`,
  }));

// 2. Four-stage production pipeline steps (dynamically pulled from services.json)
const processSteps = servicesPage.processSteps || [];

// Default telemetry metrics if not provided
const telemetryMetrics = (home as any).telemetryMetrics && (home as any).telemetryMetrics.length > 0
  ? (home as any).telemetryMetrics
  : [
      {
        value: "100%",
        label: "Independent Filmmakers",
        description: "Direct collaboration with experienced directors and camera operators. No agency bloat or markups."
      },
      {
        value: "48h",
        label: "Highlight Turnaround",
        description: "Rapid recap reels and press cutdowns delivered while event momentum is live."
      },
      {
        value: "2",
        label: "Operational Hubs",
        description: "Cambridge studio base and London on-location field crews filming UK-wide."
      },
      {
        value: "Web & Social",
        label: "Hero Films & Social Cutdowns",
        description: "Widescreen masters for your site alongside vertical cutdowns for social, complete with titled and untitled masters, plus subtitles."
      }
    ];
---

<Layout
  title={home.seoTitle}
  description={home.seoDescription}
  ogImage={home.heroPosterPath || "/og-image.jpg"}
  fullBleed={true}
>

  <!-- Cinematic Hero Section with Native Autoplay Video Background -->
  <header data-cinema-darkroom class="relative w-full min-h-[100dvh] pt-20 flex flex-col justify-between overflow-hidden">
    
    <!-- Video Container Wrapper (Guaranteed dark cinema contrast) -->
    <div class="absolute inset-0 w-full h-full z-0 bg-black pointer-events-none overflow-hidden" aria-hidden="true">
      <!-- Dark Cinematic Gradient Overlay Layer for Text Readability -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/60 to-black/90 z-10"></div>
      
      <!-- Native HTML5 Video Element with High-Contrast Fallback Poster -->
      <video 
        autoplay 
        muted 
        loop 
        playsinline 
        preload="metadata"
        poster={home.heroPosterPath || "/og-image.jpg"}
        class="absolute inset-0 w-full h-full object-cover opacity-80 z-0"
      >
        <source src={home.heroVideoPath} type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>

    <!-- Hero Copy Context -->
    <div class="relative z-20 max-w-4xl mx-auto px-6 my-auto py-16 text-center">
      <span class="text-[11px] sm:text-xs uppercase tracking-[0.2em] sm:tracking-[0.3em] text-amber-500 font-mono font-bold block mb-4">{home.locations}</span>
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white keep-white leading-[1.08] sm:leading-none mb-6">
        {home.heroHeadingPrefix} <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">{home.heroHeadingHighlight}</span>
      </h1>
      <p class="text-neutral-300 max-w-xl mx-auto text-base sm:text-lg md:text-xl leading-relaxed mb-10 keep-white">
        {home.tagline}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href={home.primaryCtaLink} class="w-full sm:w-auto bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold px-8 py-4 rounded-xl text-base transition-all shadow-xl shadow-amber-500/10 hover:scale-[1.02]">
          {home.primaryCtaLabel}
        </a>
        <a href={home.secondaryCtaLink} class="w-full sm:w-auto border border-white/20 bg-black/40 hover:bg-white/10 hover:border-white/40 backdrop-blur-md text-white font-medium px-8 py-4 rounded-xl text-base transition-all keep-white">
          {home.secondaryCtaLabel}
        </a>
      </div>
    </div>

    <!-- Cinematic Frame Spec Strip -->
    <div class="relative z-20 border-t border-white/10 bg-ink/60 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-6 py-4 flex flex-wrap items-center justify-center sm:justify-between gap-4 text-[11px] font-mono uppercase tracking-[0.2em] text-neutral-400">
        <span class="hidden sm:inline text-amber-500 font-bold normal-case tracking-normal">{home.brandName}</span>
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
          {home.expertiseList.map((item) => (
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-full bg-amber-500"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </header>

  <!-- ================================================================= -->
  <!-- 1. STUDIO TELEMETRY METRIC BAR (Arm 'By the Numbers' Architecture) -->
  <!-- ================================================================= -->
  <section class="relative border-b border-line bg-ink-soft/40 backdrop-blur-sm overflow-hidden select-none">
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-12 sm:py-16">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-8 divide-y sm:divide-y-0 sm:divide-x divide-line">
        {telemetryMetrics.map((metric: any, idx: number) => (
          <div class={`flex flex-col justify-between ${idx > 0 ? "pt-6 sm:pt-0 sm:pl-6 lg:pl-8" : ""}`}>
            <div>
              <span class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 block mb-2 font-sans">
                {metric.value}
              </span>
              <h3 class="text-xs uppercase tracking-widest text-white font-mono font-semibold mb-2">
                {metric.label}
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-light">
                {metric.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 2. STUDIO MANIFESTO (Full-Bleed Parallax Immersion)               -->
  <!-- ================================================================= -->
  <section 
    data-cinema-darkroom
    class="relative w-full py-20 sm:py-28 lg:py-36 bg-scroll lg:bg-fixed bg-center bg-cover select-none text-white overflow-hidden" 
    style={`background-image: url('${(home as any).introImage || "/work/onlocation.webp"}');`}
  >
    <!-- Dark Cinema Scrim Overlay -->
    <div class="absolute inset-0 bg-black/75 pointer-events-none" aria-hidden="true"></div>

    <!-- Centered Content (Protected Cinema Darkroom: Pure White in All Grades) -->
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center bg-transparent">
      <h2 
        class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight mb-6 keep-white" 
        set:html={parseHeading(home.introHeading || "A dedicated *on-location partner.*")} 
      />

      <p class="text-neutral-200 text-base sm:text-lg md:text-xl max-w-2xl mx-auto font-light leading-relaxed keep-white">
        {home.introBody}
      </p>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 2. PRODUCTION SERVICES (Arm Modular Architecture)                 -->
  <!-- ================================================================= -->
  <section class="max-w-7xl mx-auto px-6 pt-8 pb-24 sm:pb-32">
    
    <!-- Section Header with Direct View All Button and Carousel Controls -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-14 border-b border-line pb-8">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
            {(home as any).bentoTag || "Services"}
          </span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight" set:html={parseHeadingWithLine((home as any).bentoHeading || "Services *engineered to deliver.*")} />
        <p class="text-neutral-400 text-sm sm:text-base max-w-xl mt-3 font-light leading-relaxed">
          {(home as any).bentoDescription || "Six modular video production disciplines designed to eliminate on-site friction, protect tight corporate deadlines, and deliver broadcast-grade films every time."}
        </p>
      </div>

      <div class="shrink-0 flex items-center gap-3">
        <!-- Arm-Style Carousel Slider Controls (< and >) -->
        <div class="flex items-center gap-2">
          <button 
            id="services-prev" 
            type="button"
            aria-label="Previous services"
            class="w-10 h-10 rounded-xl bg-white/5 border border-line hover:border-amber-500/50 hover:bg-white/10 text-neutral-300 hover:text-white transition-all flex items-center justify-center cursor-pointer shadow-md active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button 
            id="services-next" 
            type="button"
            aria-label="Next services"
            class="w-10 h-10 rounded-xl bg-white/5 border border-line hover:border-amber-500/50 hover:bg-white/10 text-neutral-300 hover:text-white transition-all flex items-center justify-center cursor-pointer shadow-md active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

        <a 
          href={(home as any).bentoLinkHref || "/services"} 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/5 border border-line hover:border-amber-500/50 hover:bg-white/10 text-xs font-mono tracking-wider uppercase text-white transition-all duration-200 group shadow-lg"
        >
          <span>{(home as any).bentoLinkLabel || "Explore Services →"}</span>
        </a>
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- Arm-Style Horizontal Carousel Track (All 6 Services Visible)      -->
    <!-- ================================================================= -->
    <div 
      id="services-track"
      class="flex gap-4 sm:gap-5 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-4 pt-1 px-1 -mx-1 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]"
    >
      {services.map((service, index) => (
        <div class="w-[85vw] sm:w-[48vw] lg:w-[calc((100%-2.5rem)/3)] shrink-0 snap-start">
          <ServiceCard service={service} index={index} headingLevel="h3" />
        </div>
      ))}
    </div>

    <!-- Arm-Style Pagination Dots Underneath Track -->
    <div class="flex items-center justify-center gap-2 mt-6 sm:mt-8" aria-label="Services carousel pagination" id="services-dots">
      {services.map((_, idx) => (
        <button
          type="button"
          data-dot-index={idx}
          aria-label={`Go to service ${idx + 1}`}
          class={`h-1.5 transition-all duration-300 rounded-full cursor-pointer ${
            idx === 0 
              ? "w-8 bg-amber-400" 
              : "w-2.5 bg-white/20 hover:bg-white/40"
          }`}
        />
      ))}
    </div>

    <!-- Carousel Scroll Controller Script -->
    <script is:inline>
      const track = document.getElementById('services-track');
      const prevBtn = document.getElementById('services-prev');
      const nextBtn = document.getElementById('services-next');
      const dots = document.querySelectorAll('#services-dots button');
      const cards = track ? track.querySelectorAll(':scope > div') : [];

      function updateActiveDot(index) {
        dots.forEach((dot, i) => {
          if (i === index) {
            dot.className = "h-1.5 transition-all duration-300 rounded-full cursor-pointer w-8 bg-amber-400";
          } else {
            dot.className = "h-1.5 transition-all duration-300 rounded-full cursor-pointer w-2.5 bg-white/20 hover:bg-white/40";
          }
        });
      }

      if (track && prevBtn && nextBtn) {
        prevBtn.addEventListener('click', () => {
          track.scrollBy({ left: -(track.clientWidth * 0.95), behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', () => {
          track.scrollBy({ left: (track.clientWidth * 0.95), behavior: 'smooth' });
        });

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const idx = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
            if (cards[idx]) {
              cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
            }
          });
        });

        let scrollTimeout;
        track.addEventListener('scroll', () => {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            const scrollLeft = track.scrollLeft;
            let closestIdx = 0;
            let minDistance = Infinity;

            cards.forEach((card, i) => {
              const distance = Math.abs(card.offsetLeft - track.offsetLeft - scrollLeft);
              if (distance < minDistance) {
                minDistance = distance;
                closestIdx = i;
              }
            });

            updateActiveDot(closestIdx);
          }, 40);
        }, { passive: true });
      }
    </script>

  </section>

  <!-- ================================================================= -->
  <!-- 3. FULL-BLEED PARALLAX IMMERSION BREAK (Zero-JS Native Parallax) -->
  <!-- ================================================================= -->
  <section 
    data-cinema-darkroom
    class="relative w-full py-20 sm:py-28 lg:py-40 bg-scroll lg:bg-fixed bg-center bg-cover select-none text-white overflow-hidden" 
    style={`background-image: url('${(home as any).scaleImage || "/cambridge/stage-wide.webp"}');`}
  >
    <!-- Dark Cinema Scrim Overlay -->
    <div class="absolute inset-0 bg-black/70 pointer-events-none" aria-hidden="true"></div>

    <!-- Centered Content (Protected Cinema Darkroom: Pure White in All Grades) -->
    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center bg-transparent">
      <h2 
        class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight mb-6 keep-white" 
        set:html={parseHeading((home as any).scaleHeading || "Low-profile crews. *Plenary-scale capture.*")} 
      />

      <p class="text-neutral-200 text-base sm:text-lg max-w-2xl mx-auto font-light leading-relaxed keep-white">
        {(home as any).scaleDescription || "Operating with quiet discretion across plenary halls, research campuses, and corporate boardrooms. Broadcast cinema rigs, synchronized presentation capture, and redundant multi-camera audio without disrupting your schedule."}
      </p>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 4. PRODUCTION PIPELINE (Disciplined 4-Stage Methodology)          -->
  <!-- ================================================================= -->
  <section class="max-w-7xl mx-auto px-6 py-20 sm:py-28">
    
    <!-- Section Header with Direct Briefing Button -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 sm:mb-16 border-b border-line pb-8">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
            {(home as any).pipelineTag || "Production Pipeline"}
          </span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight" set:html={parseHeadingWithLine((home as any).pipelineHeading || "Calm execution. *Predictable excellence.*")} />
        <p class="text-neutral-400 text-sm sm:text-base max-w-xl mt-3 font-light leading-relaxed">
          {(home as any).pipelineDescription || "A disciplined four-stage pipeline designed to eliminate on-site friction, protect tight corporate deadlines, and deliver broadcast-grade films every time."}
        </p>
      </div>
      <div class="shrink-0">
        <a 
          href={(home as any).pipelineLinkHref || "/contact"} 
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/5 border border-line hover:border-amber-500/50 hover:bg-white/10 text-xs font-mono tracking-wider uppercase text-white transition-all duration-200 group shadow-lg"
        >
          <span>{(home as any).pipelineLinkLabel || "Discuss Your Timeline →"}</span>
        </a>
      </div>
    </div>

    <!-- 4-Stage Horizontal Process Rail (1 col mobile, 2 cols tablet, 4 cols desktop) -->
    <div class="relative">
      <!-- Connecting Rail Line (Desktop: Horizontal) -->
      <div 
        class="hidden lg:block absolute top-7 left-12 right-12 h-0.5 bg-gradient-to-r from-neutral-800 via-amber-500/40 to-neutral-800 z-0 pointer-events-none" 
        aria-hidden="true"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-6 relative z-10">
        {processSteps.map((step) => (
          <div class="group relative flex flex-col bg-neutral-950/70 hover:bg-neutral-950/95 border border-neutral-800/80 hover:border-amber-500/50 rounded-2xl p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-amber-500/10 backdrop-blur-sm">
            
            <!-- Top Node & Stage Tag -->
            <div class="flex items-center justify-between mb-6">
              <!-- Step Number Node -->
              <div class="w-14 h-14 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-center font-mono font-bold text-amber-400 text-lg shadow-inner group-hover:border-amber-500/60 group-hover:text-amber-300 transition-all duration-300">
                {step.step}
              </div>

              <!-- Stage Category Pill -->
              <span class="text-[11px] uppercase tracking-wider font-mono text-neutral-400 font-medium bg-neutral-900/80 border border-neutral-800/80 px-2.5 py-1 rounded-md">
                {step.tag}
              </span>
            </div>

            <!-- Step Title -->
            <h3 class="text-lg sm:text-xl font-bold text-white mb-3 tracking-tight group-hover:text-amber-400 transition-colors duration-300">
              {step.title}
            </h3>

            <!-- Step Description -->
            <p class="text-neutral-400 text-sm leading-relaxed font-light">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 5. WORK (Centered Editorial Bridge to Portfolio)                  -->
  <!-- ================================================================= -->
  <section class="max-w-4xl mx-auto px-6 py-20 sm:py-28 text-center border-t border-line">
    <div class="inline-flex items-center gap-2 mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
      <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
        {(home as any).workSpotlightTag || "Work"}
      </span>
    </div>
    
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight mb-4" set:html={parseHeading((home as any).workSpotlightHeading || "Selected Films & *Client Highlights*.")} />
    
    <p class="text-neutral-400 text-base sm:text-lg max-w-2xl mx-auto font-light leading-relaxed mb-8">
      {(home as any).workSpotlightDescription || "A curated archive of recent corporate conferences, brand documentaries, and location shoots."}
    </p>

    <div class="flex justify-center">
      <a 
        href={(home as any).workSpotlightLinkHref || "/work"} 
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/5 border border-line hover:border-amber-500/50 hover:bg-white/10 text-xs font-mono tracking-widest uppercase text-white transition-all duration-200 group shadow-lg"
      >
        <span>{(home as any).workSpotlightLinkLabel || "Explore Work →"}</span>
      </a>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 5. DUAL OPERATIONAL HUBS (Cambridge & London Single-Source)       -->
  <!-- ================================================================= -->
  <section class="max-w-7xl mx-auto px-6 py-20 sm:py-28 border-t border-line">
    
    <!-- Section Header -->
    <div class="mb-14 sm:mb-16 border-b border-line pb-8 text-center">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
          {(home as any).hubsTag || "Operational Locations"}
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight" set:html={parseHeadingWithLine((home as any).hubsHeading || "Based in *Cambridge.* On-location across *London.*")} />
      <p class="text-neutral-400 text-sm sm:text-base max-w-2xl mt-3 font-light leading-relaxed mx-auto">
        {(home as any).hubsDescription || "Operating from our Cambridge studio base, with agile field units deployed across London and nationwide. Single-source production designed for fast turnaround and seamless delivery."}
      </p>
    </div>

    <!-- Dual Hub Arm-Style Widescreen Figures -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      
      <!-- Hub 1: Cambridge Studio Base -->
      <a
        href="/cambridge"
        class="group relative block aspect-[16/10] rounded-xl overflow-hidden bg-neutral-950 border border-white/10 shadow-2xl transition-colors duration-300 hover:border-amber-500/70"
      >
        <!-- Photo with hover zoom -->
        <img 
          src={(cambridgePage as any).hubImage || "/cambridge/stage-wide.webp"} 
          alt="Cambridge Studio" 
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
        
        <!-- Base subtle scrim (keeps image bright at rest) -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent pointer-events-none transition-opacity duration-500"></div>

        <!-- Darkening hover overlay (for crisp text contrast on hover) -->
        <div class="absolute inset-0 bg-black/60 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        <!-- Figcaption content inside image -->
        <figcaption class="absolute inset-0 p-6 sm:p-8 flex flex-col justify-end pointer-events-none z-10">
          <!-- Bottom Headline & Explore Link -->
          <div class="transform transition-transform duration-300 group-hover:-translate-y-1">
            <h3 class="text-2xl sm:text-3xl font-black text-white keep-white tracking-tight mb-3 leading-tight drop-shadow-md">
              Cambridge Studio
            </h3>
            <span class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider font-bold text-neutral-300 group-hover:text-amber-400 transition-colors">
              <span>Explore</span>
              <span class="text-sm font-bold group-hover:translate-x-1.5 transition-transform">&rarr;</span>
            </span>
          </div>
        </figcaption>
      </a>

      <!-- Hub 2: London Field Unit -->
      <a
        href="/london"
        class="group relative block aspect-[16/10] rounded-xl overflow-hidden bg-neutral-950 border border-white/10 shadow-2xl transition-colors duration-300 hover:border-amber-500/70"
      >
        <!-- Photo with hover zoom -->
        <img 
          src={(londonPage as any).hubImage || "/work/onlocation.webp"} 
          alt="London Field Units" 
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          loading="lazy"
