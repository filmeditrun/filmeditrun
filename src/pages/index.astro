---
import Layout from '../layouts/Layout.astro';
import home from '../content/pages/home.json';
import servicesPage from '../content/pages/services.json';
import { projects } from '../data/projects';

// Helper for asterisk gradient formatting
const parseHeading = (text: string) => {
  if (!text) return "";
  if (text.includes('*')) {
    return text.replace(/\*(.*?)\*/g, '<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600">$1</span>');
  }
  return text;
};

// 1. Top 3 projects dynamically pulled from TinaCMS collection
const featuredProjects = projects.slice(0, 3);

// 2. Dynamically import all 6 services from TinaCMS for the Capabilities Bento Grid
interface ServiceEntry {
  order: string;
  title: string;
  tag: string;
  description: string;
  link?: string;
  slug?: string;
}

const serviceFiles = import.meta.glob<ServiceEntry>('../content/services/*.json', {
  eager: true,
  import: 'default',
});

const services = Object.values(serviceFiles)
  .sort((a, b) => (a.order || "").localeCompare(b.order || "", undefined, { numeric: true }))
  .map((s) => ({
    ...s,
    href: s.link || `/services/${s.slug}`,
  }));

// Asymmetrical 3-column Bento mapping (2+1, 1+2, 1+2 alternating rhythm)
const conferenceService = services.find((s) => s.href.includes('conference')) || services[1] || services[0];
const eventService = services.find((s) => s.href.includes('event')) || services[0];
const podcastService = services.find((s) => s.href.includes('podcast')) || services[4] || services[0];
const brandService = services.find((s) => s.href.includes('brand')) || services[5] || services[0];
const animationService = services.find((s) => s.href.includes('animation')) || services[2] || services[0];
const postService = services.find((s) => s.href.includes('post')) || services[3] || services[0];

const bentoItems = [
  { service: conferenceService, span: "lg:col-span-2", isAnchor: true },
  { service: eventService, span: "lg:col-span-1", isAnchor: false },
  { service: podcastService, span: "lg:col-span-1", isAnchor: false },
  { service: brandService, span: "lg:col-span-2", isAnchor: true },
  { service: animationService, span: "lg:col-span-1", isAnchor: false },
  { service: postService, span: "lg:col-span-2", isAnchor: true },
].filter((item) => Boolean(item.service && item.service.title));

// 3. Four-stage production pipeline steps (dynamically pulled from services.json)
const processSteps = servicesPage.processSteps || [];

// Default telemetry metrics if not provided
const telemetryMetrics = (home as any).telemetryMetrics && (home as any).telemetryMetrics.length > 0
  ? (home as any).telemetryMetrics
  : [
      {
        value: "100%",
        label: "Independent Filmmakers",
        description: "Direct collaboration with experienced directors and camera operators. No agency bloat or markups."
      },
      {
        value: "48h",
        label: "Highlight Turnaround",
        description: "Rapid recap reels and press cutdowns delivered while event momentum is live."
      },
      {
        value: "2",
        label: "Operational Hubs",
        description: "Cambridge studio base and London on-location field crews filming UK-wide."
      },
      {
        value: "Web & Social",
        label: "Hero Films & Social Cutdowns",
        description: "Widescreen masters for your site alongside vertical cutdowns for social, complete with titled and untitled masters, plus subtitles."
      }
    ];
---

<Layout
  title={home.seoTitle}
  description={home.seoDescription}
  ogImage={home.heroPosterPath || "/og-image.jpg"}
  fullBleed={true}
>

  <!-- Cinematic Hero Section with Native Autoplay Video Background -->
  <header data-cinema-darkroom class="relative w-full min-h-[100dvh] pt-20 flex flex-col justify-between overflow-hidden">
    
    <!-- Video Container Wrapper (Guaranteed dark cinema contrast) -->
    <div class="absolute inset-0 w-full h-full z-0 bg-black pointer-events-none overflow-hidden" aria-hidden="true">
      <!-- Dark Cinematic Gradient Overlay Layer for Text Readability -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/60 to-black/90 z-10"></div>
      
      <!-- Native HTML5 Video Element with High-Contrast Fallback Poster -->
      <video 
        autoplay 
        muted 
        loop 
        playsinline 
        preload="metadata"
        poster={home.heroPosterPath || "/og-image.jpg"}
        class="absolute inset-0 w-full h-full object-cover opacity-80 z-0"
      >
        <source src={home.heroVideoPath} type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>

    <!-- Hero Copy Context -->
    <div class="relative z-20 max-w-4xl mx-auto px-6 my-auto py-16 text-center">
      <span class="text-[11px] sm:text-xs uppercase tracking-[0.2em] sm:tracking-[0.3em] text-amber-500 font-mono font-bold block mb-4">{home.locations}</span>
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white keep-white leading-[1.08] sm:leading-none mb-6">
        {home.heroHeadingPrefix} <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">{home.heroHeadingHighlight}</span>
      </h1>
      <p class="text-neutral-300 max-w-xl mx-auto text-base sm:text-lg md:text-xl leading-relaxed mb-10 keep-white">
        {home.tagline}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href={home.primaryCtaLink} class="w-full sm:w-auto bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold px-8 py-4 rounded-xl text-base transition-all shadow-xl shadow-amber-500/10 hover:scale-[1.02]">
          {home.primaryCtaLabel}
        </a>
        <a href={home.secondaryCtaLink} class="w-full sm:w-auto border border-white/20 bg-black/40 hover:bg-white/10 hover:border-white/40 backdrop-blur-md text-white font-medium px-8 py-4 rounded-xl text-base transition-all keep-white">
          {home.secondaryCtaLabel}
        </a>
      </div>
    </div>

    <!-- Cinematic Frame Spec Strip -->
    <div class="relative z-20 border-t border-white/10 bg-ink/60 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-6 py-4 flex flex-wrap items-center justify-center sm:justify-between gap-4 text-[11px] font-mono uppercase tracking-[0.2em] text-neutral-400">
        <span class="hidden sm:inline text-amber-500 font-bold normal-case tracking-normal">{home.brandName}</span>
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
          {home.expertiseList.map((item) => (
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-full bg-amber-500"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </header>

  <!-- ================================================================= -->
  <!-- 1. STUDIO TELEMETRY METRIC BAR (Arm 'By the Numbers' Architecture) -->
  <!-- ================================================================= -->
  <section class="relative border-b border-line bg-ink-soft/40 backdrop-blur-sm overflow-hidden select-none">
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-12 sm:py-16">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-8 divide-y sm:divide-y-0 sm:divide-x divide-line">
        {telemetryMetrics.map((metric: any, idx: number) => (
          <div class={`flex flex-col justify-between ${idx > 0 ? "pt-6 sm:pt-0 sm:pl-6 lg:pl-8" : ""}`}>
            <div>
              <span class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 block mb-2 font-sans">
                {metric.value}
              </span>
              <h3 class="text-xs uppercase tracking-widest text-white font-mono font-semibold mb-2">
                {metric.label}
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-light">
                {metric.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fading Cinematic Divider -->
  <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-amber-500 to-transparent opacity-30"></div>

  <!-- Brief Introduction Section -->
  <section class="max-w-5xl mx-auto px-6 py-20 sm:py-28 text-center">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-white mb-6">{home.introHeading}</h2>
    <p class="text-neutral-400 text-base md:text-lg max-w-2xl mx-auto leading-relaxed mb-10">
      {home.introBody}
    </p>
    <div class="flex flex-wrap justify-center gap-6 font-mono text-xs uppercase tracking-widest">
      <a href={home.introPrimaryLinkHref} class="text-amber-500 hover:text-amber-400 transition-colors">
        {home.introPrimaryLinkLabel}
      </a>
      <a href={home.introSecondaryLinkHref} class="text-neutral-400 hover:text-white transition-colors">
        {home.introSecondaryLinkLabel}
      </a>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 2. PRODUCTION SERVICES BENTO GRID (Arm Modular Architecture)      -->
  <!-- ================================================================= -->
  <section class="max-w-7xl mx-auto px-6 py-20 sm:py-28 border-t border-line">
    
    <!-- Section Header with Direct View All Button -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-14 border-b border-line pb-8">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
            {(home as any).bentoTag || "Services"}
          </span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight" set:html={parseHeading((home as any).bentoHeading || "Engineered for *Impact & Engagement*.")} />
        <p class="text-neutral-400 text-sm sm:text-base max-w-xl mt-3 font-light leading-relaxed">
          {(home as any).bentoDescription || "Six modular video production disciplines designed to eliminate on-site friction, protect tight corporate deadlines, and deliver broadcast-grade films every time."}
        </p>
      </div>
      <div class="shrink-0">
        <a 
          href={(home as any).bentoLinkHref || "/services"} 
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/5 border border-line hover:border-amber-500/50 hover:bg-white/10 text-xs font-mono tracking-wider uppercase text-white transition-all duration-200 group shadow-lg"
        >
          <span>{(home as any).bentoLinkLabel || "Explore Services →"}</span>
        </a>
      </div>
    </div>

    <!-- Asymmetric 3-Column Bento Grid (2+1, 1+2, 1+2) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
      {bentoItems.map((item) => (
        <a
          href={item.service.href}
          class:list={[
            "group relative flex flex-col justify-between rounded-2xl border border-line bg-neutral-900/40 p-7 sm:p-9 hover:border-amber-500/60 hover:bg-neutral-900/70 transition-all duration-300 shadow-xl hover:-translate-y-1",
            item.span,
          ]}
        >
          <div>
            <!-- Category Tag Pill -->
            <div class="flex items-center justify-between gap-4 mb-4">
              <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-[10px] font-mono uppercase tracking-widest text-amber-400 font-medium">
                {item.service.tag}
              </span>
            </div>

            <!-- Heading -->
            <h3
              class:list={[
                "font-black text-white group-hover:text-amber-400 transition-colors tracking-tight leading-tight mb-3",
                item.isAnchor ? "text-2xl sm:text-3xl" : "text-xl sm:text-2xl",
              ]}
            >
              {item.service.title}
            </h3>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-light line-clamp-3">
              {item.service.description}
            </p>
          </div>

          <!-- Bottom Action Prompt -->
          <div class="pt-6 mt-6 border-t border-white/5 flex items-center justify-between text-xs font-mono text-neutral-400 group-hover:text-amber-400 transition-colors">
            <span>Explore Service</span>
            <span class="group-hover:translate-x-1.5 transition-transform font-bold">&rarr;</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom Architectural Directory Pathway Strip -->
    <div class="mt-8 pt-6 border-t border-line text-center">
      <a 
        href={(home as any).bentoLinkHref || "/services"} 
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/5 border border-line hover:border-amber-500/50 hover:bg-white/10 text-xs font-mono uppercase tracking-widest text-neutral-300 hover:text-white transition-all shadow-lg"
      >
        <span>{(home as any).bentoLinkLabel || "Explore Services →"}</span>
      </a>
    </div>

  </section>

  <!-- ================================================================= -->
  <!-- 3. SELECTED WORK IN FOCUS (Dynamic TinaCMS Project Showcase)       -->
  <!-- ================================================================= -->
  <section class="relative max-w-7xl mx-auto px-6 pb-24 sm:pb-32 overflow-hidden">
    <!-- Section Header with Direct View All Button -->
    <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-14 border-b border-line pb-8">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
            {(home as any).workSpotlightTag || "Selected Work"}
          </span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight" set:html={parseHeading((home as any).workSpotlightHeading || "Selected Films & *Client Highlights*.")} />
        <p class="text-neutral-400 text-sm sm:text-base max-w-xl mt-3 font-light leading-relaxed">
          {(home as any).workSpotlightDescription || "A glimpse into recent corporate conferences, brand documentaries, and location shoots."}
        </p>
      </div>
      <div class="shrink-0">
        <a 
          href={(home as any).workSpotlightLinkHref || "/work"} 
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/5 border border-line hover:border-amber-500/50 hover:bg-white/10 text-xs font-mono tracking-wider uppercase text-white transition-all duration-200 group shadow-lg"
        >
          <span>{(home as any).workSpotlightLinkLabel || "Explore Full Portfolio →"}</span>
        </a>
      </div>
    </div>

    <!-- 3-Column Flagship Cards Grid (100% Dynamically Fed from TinaCMS Projects) -->
    <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {featuredProjects.map((project) => (
        <a 
          href="/work" 
          class="group flex flex-col rounded-2xl bg-neutral-900/60 border border-line hover:border-amber-500/60 transition-all duration-300 overflow-hidden shadow-2xl hover:-translate-y-1"
        >
          <!-- 16:9 Thumbnail Frame with Smooth 700ms Hover Zoom -->
          <div class="relative w-full aspect-video overflow-hidden bg-neutral-950">
            <img 
              src={project.thumbnail || "/og-image.jpg"} 
              alt={project.title} 
              loading="lazy" 
              decoding="async" 
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
            
            <!-- Category / Client Tag -->
            <div class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-neutral-950/80 backdrop-blur-md border border-white/10 text-[10px] font-mono uppercase tracking-wider text-amber-400">
              {project.category || project.client}
            </div>

            <!-- Runtime Tag -->
            {project.runtime && (
              <div class="absolute bottom-3 right-3 px-2 py-0.5 rounded bg-black/80 backdrop-blur-md border border-white/10 text-[10px] font-mono text-neutral-300">
                {project.runtime}
              </div>
            )}
          </div>

          <!-- Content Details -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors mb-2 line-clamp-1">
                {project.title}
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-light line-clamp-2">
                {project.description}
              </p>
            </div>
            <div class="pt-4 mt-5 border-t border-white/5 flex items-center justify-between text-xs font-mono text-neutral-400 group-hover:text-amber-400 transition-colors">
              <span>Watch Film</span>
              <span class="group-hover:translate-x-1 transition-transform font-bold">&rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 4. PRODUCTION PIPELINE (Disciplined 4-Stage Methodology)          -->
  <!-- ================================================================= -->
  <section class="max-w-7xl mx-auto px-6 py-20 sm:py-28 border-t border-line">
    
    <!-- Section Header with Direct Briefing Button -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 sm:mb-16 border-b border-line pb-8">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
            {(home as any).pipelineTag || "Production Pipeline"}
          </span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight" set:html={parseHeading((home as any).pipelineHeading || "Calm execution. *Predictable excellence.*")} />
        <p class="text-neutral-400 text-sm sm:text-base max-w-xl mt-3 font-light leading-relaxed">
          {(home as any).pipelineDescription || "A disciplined four-stage pipeline designed to eliminate on-site friction, protect tight corporate deadlines, and deliver broadcast-grade films every time."}
        </p>
      </div>
      <div class="shrink-0">
        <a 
          href={(home as any).pipelineLinkHref || "/contact"} 
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/5 border border-line hover:border-amber-500/50 hover:bg-white/10 text-xs font-mono tracking-wider uppercase text-white transition-all duration-200 group shadow-lg"
        >
          <span>{(home as any).pipelineLinkLabel || "Discuss Your Timeline →"}</span>
        </a>
      </div>
    </div>

    <!-- 4-Stage Horizontal Process Rail (1 col mobile, 2 cols tablet, 4 cols desktop) -->
    <div class="relative">
      <!-- Connecting Rail Line (Desktop: Horizontal) -->
      <div 
        class="hidden lg:block absolute top-12 left-16 right-16 h-0.5 bg-gradient-to-r from-line via-amber-500/35 to-line z-0 pointer-events-none" 
        aria-hidden="true"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-6 relative z-10">
        {processSteps.map((step) => (
          <div class="group relative flex flex-col justify-between rounded-2xl border border-line bg-neutral-900/40 p-6 sm:p-7 hover:border-amber-500/60 hover:bg-neutral-900/70 transition-all duration-300 shadow-xl hover:-translate-y-1">
            <div>
              <!-- Top Node & Stage Tag -->
              <div class="flex items-center justify-between mb-6">
                <!-- Step Number Node -->
                <div class="w-12 h-12 rounded-xl bg-neutral-950 border border-line flex items-center justify-center font-mono font-bold text-amber-400 text-base shadow-inner group-hover:border-amber-500/60 group-hover:text-amber-300 transition-all duration-300">
                  {step.step}
                </div>

                <!-- Stage Category Pill -->
                <span class="text-[10px] uppercase tracking-wider font-mono text-neutral-400 font-medium bg-white/5 border border-white/10 px-2.5 py-1 rounded-md group-hover:text-neutral-200">
                  {step.tag}
                </span>
              </div>

              <!-- Step Title -->
              <h3 class="text-lg sm:text-xl font-bold text-white mb-2.5 tracking-tight group-hover:text-amber-400 transition-colors leading-snug">
                {step.title}
              </h3>

              <!-- Step Description -->
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-light">
                {step.description}
              </p>
            </div>

            <!-- Bottom Progress Sub-indicator -->
            <div class="pt-5 mt-6 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-neutral-500 group-hover:text-neutral-400 transition-colors">
              <span>Stage {step.step} of 04</span>
              <span class="w-1.5 h-1.5 rounded-full bg-neutral-700 group-hover:bg-amber-400 transition-colors"></span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Architectural Action Strip -->
    <div class="mt-10 pt-8 border-t border-line text-center">
      <a 
        href={(home as any).pipelineLinkHref || "/contact"} 
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/5 border border-line hover:border-amber-500/50 hover:bg-white/10 text-xs font-mono uppercase tracking-widest text-neutral-300 hover:text-white transition-all shadow-lg"
      >
        <span>{(home as any).pipelineLinkLabel || "Discuss Your Timeline →"}</span>
      </a>
    </div>

  </section>

</Layout>
