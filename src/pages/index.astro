---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Filmeditrun.co.uk - Cinematic Creatives">
    <Navbar />

    <main class="pt-20">
        <!-- Hero Section -->
        <section class="relative h-[calc(100vh-5rem)] min-h-[600px] flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 z-0 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-t from-darkBg via-darkBg/60 to-black/40 z-10"></div>
                <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-blue-900/20 via-darkBg/80 to-darkBg z-0"></div>
                <div class="absolute inset-0 opacity-40 bg-[url('https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?q=80&w=1920&auto=format&fit=crop')] bg-cover bg-center transform scale-105"></div>
            </div>

            <div class="relative z-20 max-w-5xl mx-auto px-6 text-center space-y-8">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-card border border-accentBlue/30 text-accentBlue text-sm font-semibold tracking-wider uppercase">
                    <i class="fa-solid fa-video"></i> 4 Flagship Services • Media-Rich Asset Preview Blocks
                </div>
                <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tight uppercase leading-none">
                    Cinematic <span class="text-transparent bg-clip-text bg-gradient-to-r from-accentBlue to-blue-500">Creatives</span>
                </h1>
                <p class="max-w-2xl mx-auto text-xl md:text-2xl text-mutedText font-light">
                    Lightning-fast static performance. Start simple with 4 foundational services featuring associated video and photo reference assets.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
                    <a href="/services" class="w-full sm:w-auto glow-button px-8 py-4 rounded-xl font-bold text-darkBg text-lg tracking-wide flex items-center justify-center gap-3">
                        <span>Explore 4 Core Services</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a href="/contact" class="w-full sm:w-auto glass-card px-8 py-4 rounded-xl font-bold text-white text-lg tracking-wide hover:bg-white/15 transition-colors flex items-center justify-center gap-3">
                        <i class="fa-solid fa-envelope text-accentBlue"></i>
                        <span>Get Custom Quote</span>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
