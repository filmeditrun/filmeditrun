                    <strong id="modal-turnaround" class="text-white text-base">3-5 Days</strong>
                </div>
                <div>
                    <span class="text-mutedText block uppercase text-xs">Primary Deliverable</span>
                    <strong id="modal-deliverable" class="text-white text-base">4K ProRes</strong>
                </div>
            </div>
            <div class="flex items-center justify-end gap-4 pt-2">
                <button onclick="closeServiceModal()" class="glass-card px-6 py-3 rounded-xl font-bold text-white hover:bg-white/15">Close</button>
                <button id="modal-book-btn" onclick="" class="glow-button px-8 py-3 rounded-xl font-bold text-darkBg">Book This Service</button>
            </div>
