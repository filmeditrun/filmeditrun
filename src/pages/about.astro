---
// =====================================================================
// ABOUT / STUDIO MANIFESTO PAGE: THE DIRECTOR'S CUT
// Content source: src/content/pages/about.json (Managed via TinaCMS)
// =====================================================================
import Layout from '../layouts/Layout.astro';
import aboutPage from '../content/pages/about.json';
import aboutSlider from '../content/pages/slider.json';

import AboutHero from '../components/about/AboutHero.astro';
import TeamSlider from '../components/about/TeamSlider.astro';
import AboutApproach from '../components/about/AboutApproach.astro';
import ScriptTimeline from '../components/about/ScriptTimeline.astro';
import AboutCta from '../components/about/AboutCta.astro';

interface SlideItem {
  name: string;
  bio?: string;
  avatar?: string;
  videoLoop?: string;
  badge?: string;
}

interface SliderConfig {
  heading?: string;
  tag?: string;
  description?: string;
  slides?: SlideItem[];
}

const sliderData = aboutSlider as SliderConfig;
// Custom schema for About / Manifesto Page
const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": aboutPage.seoTitle,
  "description": aboutPage.seoDescription,
  "mainEntity": {
    "@type": "VideoProductionCompany",
    "name": "FilmEditRun",
    "url": "https://filmeditrun.co.uk",
    "slogan": "Picture, Sound, and Story",
    "description": aboutPage.manifestoLead,
    "knowsAbout": [
      "Multi-Camera Live Filming",
      "Conference Video Production",
      "Commercial Post-Production",
      "Colour Grading & Sound Design"
    ]
  }
};
---

<Layout
  title={aboutPage.seoTitle}
  description={aboutPage.seoDescription}
  jsonLd={aboutSchema}
  fullBleed={true}
>

  <!-- 1. The Hero / Manifesto Section -->
  <AboutHero
    tag={(aboutPage as any).heroTag || (aboutPage as any).tag || "STUDIO ETHOS"}
    headline={aboutPage.headline}
    manifestoLead={aboutPage.manifestoLead}
    manifestoQuote={aboutPage.manifestoQuote}
    manifestoAuthor={aboutPage.manifestoAuthor}
    heroBackgroundType={(aboutPage as any).heroBackgroundType}
    heroVideoPath={aboutPage.heroVideoPath}
    heroImagePath={(aboutPage as any).heroImagePath}
    heroGradientDirection={(aboutPage as any).heroGradientDirection}
    heroGradientColor1={(aboutPage as any).heroGradientColor1}
    heroGradientColor2={(aboutPage as any).heroGradientColor2}
    heroFrostedGlass={(aboutPage as any).heroFrostedGlass}
  />


  <!-- 2. Production Crew & Showcase Slider -->
  <TeamSlider
    slider={sliderData}
    heading={sliderData.heading}
    tag={sliderData.tag}
    description={sliderData.description}
    slides={sliderData.slides}
  />

  <!-- 3. Studio Approach (Centered Editorial Statement - Zero-Card Rhythm) -->
  <AboutApproach
    tag={(aboutPage as any).approachTag}
    heading={(aboutPage as any).approachHeading}
    body={(aboutPage as any).approachBody}
    primaryLinkLabel={(aboutPage as any).approachPrimaryLinkLabel}
    primaryLinkHref={(aboutPage as any).approachPrimaryLinkHref}
    secondaryLinkLabel={(aboutPage as any).approachSecondaryLinkLabel}
    secondaryLinkHref={(aboutPage as any).approachSecondaryLinkHref}
  />

  <!-- 4. Studio Evolutionary Timeline & Milestone Reel -->
  {(aboutPage as any).milestones && (aboutPage as any).milestones.length > 0 && (
    <ScriptTimeline
      timelineHeading={(aboutPage as any).timelineHeading || "Studio Evolution & *Milestones*"}
      timelineTag={(aboutPage as any).timelineTag || "STUDIO TIMELINE"}
      timelineDescription={(aboutPage as any).timelineDescription}
      milestones={(aboutPage as any).milestones}
    />
  )}

  <!-- 5. Bottom Closer Call-To-Action (Atmospheric Dark Gray Closer) -->
  <AboutCta
    ctaTag={(aboutPage as any).ctaTag}
    ctaHeading={aboutPage.ctaHeading}
    ctaText={aboutPage.ctaText}
    ctaButtonLabel={aboutPage.ctaButtonLabel}
    ctaButtonLink={aboutPage.ctaButtonLink}
    ctaSecondaryButtonLabel={(aboutPage as any).ctaSecondaryButtonLabel}
    ctaSecondaryButtonLink={(aboutPage as any).ctaSecondaryButtonLink}
    ctaTrustSignals={(aboutPage as any).ctaTrustSignals}
  />
</Layout>
