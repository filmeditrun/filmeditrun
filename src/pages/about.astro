---
// =====================================================================
// ABOUT / STUDIO MANIFESTO PAGE — THE DIRECTOR'S CUT
// Content source: src/content/pages/about.json (Managed via TinaCMS)
// =====================================================================
import Layout from '../layouts/Layout.astro';
import aboutPage from '../content/pages/about.json';
import aboutSlider from '../content/pages/slider.json';

import AboutHero from '../components/about/AboutHero.astro';
import TeamSlider from '../components/about/TeamSlider.astro';
import ScriptTimeline from '../components/about/ScriptTimeline.astro';
import BtsGallery from '../components/about/BtsGallery.astro';
import AboutCta from '../components/about/AboutCta.astro';

interface SlideItem {
  name: string;
  bio?: string;
  avatar?: string;
  videoLoop?: string;
  badge?: string;
}

interface SliderConfig {
  heading?: string;
  tag?: string;
  description?: string;
  slides?: SlideItem[];
}

const sliderData = aboutSlider as SliderConfig;
// Custom schema for About / Manifesto Page
const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": aboutPage.seoTitle,
  "description": aboutPage.seoDescription,
  "mainEntity": {
    "@type": "VideoProductionCompany",
    "name": "FilmEditRun",
    "url": "https://filmeditrun.co.uk",
    "slogan": "Picture, Sound, and Story",
    "description": aboutPage.manifestoLead,
    "knowsAbout": [
      "Multi-Camera Live Filming",
      "Conference Video Production",
      "Commercial Post-Production",
      "Color Grading & Sound Design"
    ]
  }
};
---

<Layout
  title={aboutPage.seoTitle}
  description={aboutPage.seoDescription}
  jsonLd={aboutSchema}
  fullBleed={true}
>

  <!-- 1. The Hero / Manifesto Section -->
  <AboutHero
    headline={aboutPage.headline}
    manifestoLead={aboutPage.manifestoLead}
    manifestoQuote={aboutPage.manifestoQuote}
    manifestoAuthor={aboutPage.manifestoAuthor}
    heroVideoPath={aboutPage.heroVideoPath}
    heroFrostedGlass={(aboutPage as any).heroFrostedGlass}
  />


  <!-- 3. Production Crew & Showcase Slider -->
  <TeamSlider
    slider={sliderData}
    heading={sliderData.heading}
    tag={sliderData.tag}
    description={sliderData.description}
    slides={sliderData.slides}
  />

  <!-- 4. Behind The Scenes (BTS) Production Gallery & Lightbox -->
  <BtsGallery
    btsHeading={aboutPage.btsHeading}
    btsTag={aboutPage.btsTag}
    btsDescription={aboutPage.btsDescription}
    btsItems={aboutPage.btsItems}
  />

  <!-- 5. The Interactive Script Revision / Milestones Timeline -->
  <ScriptTimeline
    timelineHeading={aboutPage.timelineHeading}
    timelineTag={aboutPage.timelineTag}
    timelineDescription={aboutPage.timelineDescription}
    milestones={aboutPage.milestones}
  />

  <!-- 6. Bottom Closer Call-To-Action -->
  <AboutCta
    ctaHeading={aboutPage.ctaHeading}
    ctaText={aboutPage.ctaText}
    ctaButtonLabel={aboutPage.ctaButtonLabel}
    ctaButtonLink={aboutPage.ctaButtonLink}
  />
</Layout>
