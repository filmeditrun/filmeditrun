---
// =====================================================================
// CAMBRIDGE LANDING PAGE (Managed via TinaCMS in src/content/pages/cambridge.json)
// =====================================================================
import Layout from '../layouts/Layout.astro';
import cambridge from '../content/pages/cambridge.json';
---

<Layout title={cambridge.seoTitle} description={cambridge.seoDescription}>
  
  <!-- 1. PLUGS LOCAL BUSINESS SCHEMA DIRECTLY INTO YOUR HEAD COMPONENT -->
  <Fragment slot="head">
    <link rel="canonical" href={cambridge.canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={cambridge.canonicalURL} />
    <meta property="og:title" content={cambridge.seoTitle} />
    <meta property="og:description" content={cambridge.seoDescription} />

    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "FilmEditRun Cambridge",
      "description": "Corporate video production and multi-camera event filming based in Cambridge, UK.",
      "url": "https://filmeditrun.co.uk/cambridge",
      "areaServed": {
        "@type": "City",
        "name": "Cambridge"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Cambridge",
        "addressRegion": "Cambridgeshire",
        "addressCountry": "GB"
      }
    }
    </script>
  </Fragment>

  <!-- Hero Section -->
  <header class="relative w-full pt-16 pb-24 px-6 max-w-5xl mx-auto text-center">
    <span class="text-xs uppercase tracking-[0.3em] text-amber-500 font-mono font-bold block mb-4">{cambridge.heroTag}</span>
    <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white leading-none mb-6">
      {cambridge.heroHeadingPrefix} <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">{cambridge.heroHeadingHighlight}</span>
    </h1>
    <p class="text-neutral-400 max-w-2xl mx-auto text-lg leading-relaxed mb-10">
      {cambridge.heroSubtitle}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href={cambridge.heroCtaLink} class="w-full sm:w-auto bg-amber-500 text-neutral-950 font-bold px-8 py-4 rounded-xl text-base hover:bg-amber-400 transition-all shadow-xl shadow-amber-500/10">
        {cambridge.heroCtaLabel}
      </a>
    </div>
  </header>

  <!-- Local Hub Context Section -->
  <section class="max-w-5xl mx-auto px-6 py-20 border-t border-neutral-900">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="text-xs uppercase tracking-widest text-amber-500 font-mono block mb-2">{cambridge.expertiseTag}</span>
        <h2 class="text-3xl font-bold tracking-tight text-white mb-4">{cambridge.expertiseHeading}</h2>
        <p class="text-neutral-400 leading-relaxed mb-6">
          {cambridge.expertiseDescription}
        </p>
        <ul class="space-y-3 text-neutral-300 text-sm font-mono">
          {cambridge.expertiseBullets.map((bullet) => (
            <li class="flex items-center gap-2">✓ {bullet}</li>
          ))}
        </ul>
      </div>
      <div class="bg-neutral-900 border border-neutral-800 p-8 rounded-2xl">
        <h3 class="text-xl font-bold text-white mb-3">{cambridge.cardTitle}</h3>
        <p class="text-neutral-400 text-sm leading-relaxed mb-4">
          {cambridge.cardBody}
        </p>
        <a href={cambridge.cardLinkHref} class="text-amber-500 font-mono text-sm hover:underline inline-flex items-center gap-1">
          {cambridge.cardLinkLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Cambridge FAQ Section -->
  <section class="max-w-4xl mx-auto px-6 py-20 border-t border-neutral-900">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-white mb-10 text-center">{cambridge.faqHeading}</h2>
    
    <div class="space-y-6">
      {cambridge.faqs.map((faq) => (
        <div class="bg-neutral-900/50 border border-neutral-800 p-6 rounded-xl">
          <h3 class="text-lg font-semibold text-white mb-2">{faq.question}</h3>
          <p class="text-neutral-400 text-sm leading-relaxed">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="max-w-4xl mx-auto px-6 py-20 text-center border-t border-neutral-900">
    <h2 class="text-3xl font-bold text-white mb-4">{cambridge.bottomCtaHeading}</h2>
    <p class="text-neutral-400 mb-8 max-w-lg mx-auto">{cambridge.bottomCtaBody}</p>
    <a href={cambridge.bottomCtaLink} class="w-full sm:w-auto bg-amber-500 text-neutral-950 font-bold px-8 py-4 rounded-xl hover:bg-amber-400 transition-all inline-block shadow-lg shadow-amber-500/10">
      {cambridge.bottomCtaLabel}
    </a>
  </section>
</Layout>
