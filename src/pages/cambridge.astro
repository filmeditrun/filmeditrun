---
// =====================================================================
// CAMBRIDGE LANDING PAGE (Managed via TinaCMS in src/content/pages/cambridge.json)
// =====================================================================
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import rawCambridge from '../content/pages/cambridge.json';

interface CambridgeData {
  seoTitle: string;
  seoDescription: string;
  canonicalURL?: string;
  heroTag?: string;
  heroHeadingPrefix?: string;
  heroHeadingHighlight?: string;
  heroSubtitle?: string;
  heroCtaLabel?: string;
  heroCtaLink?: string;
  displayAs?: "local-video" | "link-video" | "image" | "none";
  localVideoPath?: string;
  cloudVideoUrl?: string;
  imagePath?: string;
  expertiseTag?: string;
  expertiseHeading?: string;
  expertiseDescription?: string;
  expertiseBullets?: string[];
  cardTitle?: string;
  cardBody?: string;
  cardLinkLabel?: string;
  cardLinkHref?: string;
  lookbookTag?: string;
  lookbookHeroImage?: string;
  lookbookHeroBadge?: string;
  lookbookDetail1Image?: string;
  lookbookDetail1Badge?: string;
  lookbookDetail2Image?: string;
  lookbookDetail2Badge?: string;
  faqHeading?: string;
  faqs?: Array<{ question: string; answer: string }>;
  bottomCtaHeading?: string;
  bottomCtaBody?: string;
  bottomCtaLabel?: string;
  bottomCtaLink?: string;
}

const cambridge = rawCambridge as CambridgeData;

const displayAs = cambridge.displayAs || "local-video";
const localVideoPath = cambridge.localVideoPath || "/showreel.mp4";
const cloudVideoUrl = cambridge.cloudVideoUrl || "";
const imagePath = cambridge.imagePath || "/og-image.jpg";
const siteUrl = "https://filmeditrun.co.uk";
const ogImage = imagePath.startsWith("http") ? imagePath : `${siteUrl}${imagePath}`;
const expertiseBullets = cambridge.expertiseBullets ?? [];
const faqs = cambridge.faqs ?? [];
const lookbookTag = cambridge.lookbookTag || "Field Dispatches // Cambridge";
const lookbookHeroImage = cambridge.lookbookHeroImage || "/og-image.jpg";
const lookbookHeroBadge = cambridge.lookbookHeroBadge || "Cambridge Science Park • Multi-Cam Keynote";
const lookbookDetail1Image = cambridge.lookbookDetail1Image || "/og-image.jpg";
const lookbookDetail1Badge = cambridge.lookbookDetail1Badge || "Historic Colleges • Symposia & Panels";
const lookbookDetail2Image = cambridge.lookbookDetail2Image || "/og-image.jpg";
const lookbookDetail2Badge = cambridge.lookbookDetail2Badge || "The Bradfield Centre • Executive Interviews";

// Specific LocalBusiness, FAQPage & BreadcrumbList Schema for Cambridge
const cambridgeSchemas: Record<string, any>[] = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "FilmEditRun Cambridge",
    "description": "Corporate video production and multi-camera event filming based in Cambridge, UK.",
    "url": "https://filmeditrun.co.uk/cambridge/",
    "areaServed": {
      "@type": "City",
      "name": "Cambridge"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Cambridge",
      "addressRegion": "Cambridgeshire",
      "addressCountry": "GB"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Cambridge Production Hub",
        "item": "https://filmeditrun.co.uk/cambridge/"
      }
    ]
  }
];

if (faqs.length > 0) {
  cambridgeSchemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  });
}
---

<Layout
  title={cambridge.seoTitle}
  description={cambridge.seoDescription}
  canonical={cambridge.canonicalURL || "https://filmeditrun.co.uk/cambridge/"}
  ogImage={ogImage}
  jsonLd={cambridgeSchemas}
  fullBleed={true}
>

  <div class="w-full relative z-10 bg-ink min-h-screen">

    <!-- ============================================================== -->
    <!-- 1. CINEMATIC HERO BANNER (Matches Services Subpage Lighting)   -->
    <!-- ============================================================== -->
    <header data-cinema-darkroom class="relative w-full pt-32 pb-20 sm:pt-40 sm:pb-28 overflow-hidden border-b border-white/10 select-none">
      
      <!-- Video / Photo Media Backdrop Layer (Clear, vibrant background) -->
      <div class="absolute inset-0 z-0 bg-neutral-950 pointer-events-none overflow-hidden">
        <!-- Master Cinematic ND Filter (Guaranteed AA Contrast Across Video Feeds) -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/60 to-black/90 z-10 pointer-events-none" aria-hidden="true"></div>

        {/* Video Background (Local or Cloud) */}
        {(displayAs === "local-video" || displayAs === "link-video") && (
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={imagePath}
            class="absolute inset-0 w-full h-full object-cover opacity-90 sm:opacity-95 z-0"
          >
            <source
              src={displayAs === "local-video" ? localVideoPath : cloudVideoUrl}
              type="video/mp4"
            />
          </video>
        )}

        {/* Static Image Background */}
        {displayAs === "image" && (
          <img
            src={imagePath}
            alt={cambridge.seoTitle}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover opacity-80 sm:opacity-85 z-0"
          />
        )}
      </div>

      <!-- Main Banner Content -->
      <div class="relative z-20 max-w-6xl mx-auto px-6">
        
        <!-- Studio Category Eyebrow Badge (TinaCMS Editable) -->
        <div class="mb-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono uppercase tracking-widest font-semibold backdrop-blur-md bg-amber-500/10 border border-amber-500/25 text-amber-400 shadow-sm shadow-amber-500/10 select-none">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
            <span>{cambridge.heroTag || "Cambridge Production Hub"}</span>
          </div>
        </div>

        <!-- Large Title -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white keep-white tracking-tight leading-[1.08] mb-6 max-w-4xl">
          {cambridge.heroHeadingPrefix} <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">{cambridge.heroHeadingHighlight}</span>
        </h1>

        <!-- Value Proposition / Introductory Paragraph -->
        <p class="text-base sm:text-lg lg:text-xl text-neutral-300 font-normal leading-relaxed max-w-3xl mb-8">
          {cambridge.heroSubtitle}
        </p>

        <!-- Primary Action -->
        <div>
          <a
            href={cambridge.heroCtaLink}
            class="inline-block bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold px-8 py-3.5 rounded-xl text-base transition-all shadow-xl shadow-amber-500/20 hover:scale-[1.02] text-center"
          >
            {cambridge.heroCtaLabel} &rarr;
          </a>
        </div>

      </div>

    </header>

    <!-- Local Hub Context Section -->
    <section class="max-w-6xl mx-auto px-6 py-24 sm:py-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono block mb-2">{cambridge.expertiseTag}</span>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-4 leading-tight">{cambridge.expertiseHeading}</h2>
          <p class="text-neutral-400 leading-relaxed mb-6 font-light">
            {cambridge.expertiseDescription}
          </p>
          {expertiseBullets.length > 0 && (
            <ul class="space-y-3 text-neutral-300 text-sm font-mono">
              {expertiseBullets.map((bullet) => (
                <li class="flex items-center gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0"></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div class="bg-neutral-900/80 border border-neutral-800 p-8 sm:p-10 rounded-2xl shadow-xl">
          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">{cambridge.cardTitle}</h3>
          <p class="text-neutral-400 text-sm sm:text-base leading-relaxed mb-6 font-light">
            {cambridge.cardBody}
          </p>
          <a href={cambridge.cardLinkHref} class="group inline-flex items-center gap-2 text-amber-500 hover:text-amber-400 font-mono text-sm font-medium transition-colors">
            <span>{cambridge.cardLinkLabel?.replace(/[➔→]\s*$/, '') || "View Selected Works"}</span>
            <span class="group-hover:translate-x-1 transition-transform font-bold">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
    <section class="max-w-6xl mx-auto px-6 py-16 sm:py-20 border-t border-neutral-900">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
          {lookbookTag}
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 sm:gap-6 items-stretch">
        <!-- Large Left Hero Frame (3 of 5 cols) -->
        <div class="lg:col-span-3 group relative rounded-xl sm:rounded-2xl overflow-hidden border border-neutral-800 bg-neutral-950 shadow-2xl transition-all duration-300 hover:border-amber-500/60 min-h-[300px] sm:min-h-[420px]">
          <img
            src={lookbookHeroImage}
            alt={lookbookHeroBadge}
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            loading="lazy"
          />
          {lookbookHeroBadge && (
            <div class="absolute bottom-3.5 left-3.5 px-3 py-1.5 rounded-lg bg-neutral-950/85 backdrop-blur-md border border-white/10 text-[11px] font-mono text-neutral-300 uppercase tracking-wider flex items-center gap-2 shadow-lg">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              <span>{lookbookHeroBadge}</span>
            </div>
          )}
        </div>

        <!-- Stacked Right Detail Frames (2 of 5 cols) -->
        <div class="lg:col-span-2 flex flex-col gap-4 sm:gap-6">
          <div class="group relative rounded-xl sm:rounded-2xl overflow-hidden border border-neutral-800 bg-neutral-950 shadow-2xl transition-all duration-300 hover:border-amber-500/60 aspect-[16/10] sm:aspect-[16/9] flex-1">
            <img
              src={lookbookDetail1Image}
              alt={lookbookDetail1Badge}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            {lookbookDetail1Badge && (
              <div class="absolute bottom-3 left-3 px-2.5 py-1 rounded-lg bg-neutral-950/85 backdrop-blur-md border border-white/10 text-[10px] font-mono text-neutral-300 uppercase tracking-wider flex items-center gap-1.5 shadow-lg">
                <span class="w-1 h-1 rounded-full bg-amber-400"></span>
                <span>{lookbookDetail1Badge}</span>
              </div>
            )}
          </div>

          <div class="group relative rounded-xl sm:rounded-2xl overflow-hidden border border-neutral-800 bg-neutral-950 shadow-2xl transition-all duration-300 hover:border-amber-500/60 aspect-[16/10] sm:aspect-[16/9] flex-1">
            <img
              src={lookbookDetail2Image}
              alt={lookbookDetail2Badge}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            {lookbookDetail2Badge && (
              <div class="absolute bottom-3 left-3 px-2.5 py-1 rounded-lg bg-neutral-950/85 backdrop-blur-md border border-white/10 text-[10px] font-mono text-neutral-300 uppercase tracking-wider flex items-center gap-1.5 shadow-lg">
                <span class="w-1 h-1 rounded-full bg-amber-400"></span>
                <span>{lookbookDetail2Badge}</span>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Cambridge FAQ Section -->
    {faqs.length > 0 && (
      <section class="max-w-4xl mx-auto px-6 py-20 border-t border-neutral-900">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-white mb-10 text-center">{cambridge.faqHeading}</h2>
        
        <div class="space-y-6">
          {faqs.map((faq) => (
            <div class="bg-neutral-900/50 border border-neutral-800 p-6 rounded-xl">
              <h3 class="text-lg font-semibold text-white mb-2">{faq.question}</h3>
              <p class="text-neutral-400 text-sm leading-relaxed font-light">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Bottom CTA -->
    <CtaSection
      tag="Cambridge Production Hub"
      heading={cambridge.bottomCtaHeading || "Planning a shoot in *Cambridge*?"}
      description={cambridge.bottomCtaBody}
      primaryButtonLabel={cambridge.bottomCtaLabel || "Discuss Your Cambridge Project →"}
      primaryButtonLink={cambridge.bottomCtaLink || "/contact"}
      secondaryButtonLabel="Explore London Hub →"
      secondaryButtonLink="/london"
      trustSignals={[
        "Historic College Filming Experience",
        "Cambridge Science Park Fast Dispatch",
        "24–48h Highlight Reel Turnaround"
      ]}
    />

  </div>
</Layout>
