---
// =====================================================================
// CAMBRIDGE LANDING PAGE (Optimized for Local SEO)
// =====================================================================
import Layout from '../layouts/Layout.astro';

const title = "Corporate Video Production & Event Filming Cambridge | FilmEditRun";
const description = "Premier corporate video production, multi-camera conference coverage, and brand filmmaking across Cambridge Science Park, university colleges, and local tech hubs.";
const canonicalURL = "https://filmeditrun.co.uk/cambridge";
---

<Layout title={title} description={description}>
  
  <!-- 1. PLUGS LOCAL BUSINESS SCHEMA DIRECTLY INTO YOUR HEAD COMPONENT -->
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "FilmEditRun Cambridge",
      "description": "Corporate video production and multi-camera event filming based in Cambridge, UK.",
      "url": "https://filmeditrun.co.uk/cambridge",
      "areaServed": {
        "@type": "City",
        "name": "Cambridge"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Cambridge",
        "addressRegion": "Cambridgeshire",
        "addressCountry": "GB"
      }
    }
    </script>
  </Fragment>

  <!-- Hero Section -->
  <!-- Note: pt-36 is kept here to give clean structural spacing beneath the fixed nav element -->
  <header class="relative w-full pt-36 pb-24 px-6 max-w-5xl mx-auto text-center">
    <span class="text-xs uppercase tracking-[0.3em] text-amber-500 font-mono font-bold block mb-4">Cambridge Production Hub</span>
    <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white leading-none mb-6">
      Corporate Video Production in <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">Cambridge.</span>
    </h1>
    <p class="text-neutral-400 max-w-2xl mx-auto text-lg leading-relaxed mb-10">
      Specialist single and multi-camera event video coverage, conference filming, and brand storytelling for Cambridge’s thriving tech sector, universities, and commercial enterprises.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href="/contact" class="w-full sm:w-auto bg-amber-500 text-neutral-950 font-bold px-8 py-4 rounded-xl text-md hover:bg-amber-400 transition-all shadow-xl shadow-amber-500/10">
        Discuss Your Cambridge Project
      </a>
    </div>
  </header>

  <!-- Local Hub Context Section -->
  <section class="max-w-5xl mx-auto px-6 py-20 border-t border-neutral-900">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="text-xs uppercase tracking-widest text-amber-500 font-mono block mb-2">Local Expertise</span>
        <h2 class="text-3xl font-bold tracking-tight text-white mb-4">Filming Across Cambridge’s Key Innovation Hubs</h2>
        <p class="text-neutral-400 leading-relaxed mb-6">
          Whether you are hosting a keynote panel at the <strong class="text-neutral-200">Cambridge Science Park</strong>, producing marketing content near <strong class="text-neutral-200">The Bradfield Centre</strong>, or recording academic symposia across historic university colleges, our team brings discrete, professional production pipelines tailored to local venues.
        </p>
        <ul class="space-y-3 text-neutral-300 text-sm font-mono">
          <li class="flex items-center gap-2">✓ Multi-camera live switching & recording</li>
          <li class="flex items-center gap-2">✓ Corporate interviews & leadership profiles</li>
          <li class="flex items-center gap-2">✓ Fast turnaround highlight reels for social media</li>
        </ul>
      </div>
      <div class="bg-neutral-900 border border-neutral-800 p-8 rounded-2xl">
        <h3 class="text-xl font-bold text-white mb-3">Why Cambridge Brands Choose Us</h3>
        <p class="text-neutral-400 text-sm leading-relaxed mb-4">
          Cambridge companies demand technical precision, clean audio capture, and cinematic pacing. We combine high-end cinema gear with streamlined editing workflows to deliver assets that resonate with global investors and local audiences alike.
        </p>
        <a href="/work" class="text-amber-500 font-mono text-sm hover:underline inline-flex items-center gap-1">
          View our selected works ➔
        </a>
      </div>
    </div>
  </section>

  <!-- Cambridge FAQ Section -->
  <section class="max-w-4xl mx-auto px-6 py-20 border-t border-neutral-900">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-white mb-10 text-center">Frequently Asked Questions</h2>
    
    <div class="space-y-6">
      <div class="bg-neutral-900/50 border border-neutral-800 p-6 rounded-xl">
        <h3 class="text-lg font-semibold text-white mb-2">Do you provide multi-camera event filming in Cambridge?</h3>
        <p class="text-neutral-400 text-sm leading-relaxed">Yes, we specialize in multi-camera setups for corporate conferences, hybrid events, and panel discussions throughout Cambridge and surrounding areas.</p>
      </div>

      <div class="bg-neutral-900/50 border border-neutral-800 p-6 rounded-xl">
        <h3 class="text-lg font-semibold text-white mb-2">Are you familiar with filming restrictions at Cambridge venues?</h3>
        <p class="text-neutral-400 text-sm leading-relaxed">Absolutely. We are experienced in working within strict venue guidelines across science parks, conference centers, and historic institutional properties with minimal footprint and maximum discretion.</p>
      </div>

      <div class="bg-neutral-900/50 border border-neutral-800 p-6 rounded-xl">
        <h3 class="text-lg font-semibold text-white mb-2">What is your typical turnaround time for conference highlights?</h3>
        <p class="text-neutral-400 text-sm leading-relaxed">For fast-turnaround event highlights or social media cutdowns, we can deliver initial drafts within 24 to 48 hours post-event.</p>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="max-w-4xl mx-auto px-6 py-20 text-center border-t border-neutral-900">
    <h2 class="text-3xl font-bold text-white mb-4">Ready to Film in Cambridge?</h2>
    <p class="text-neutral-400 mb-8 max-w-lg mx-auto">Get in touch to discuss your upcoming project timeline, technical requirements, and production scope.</p>
    <a href="/contact" class="w-full sm:w-auto bg-amber-500 text-neutral-950 font-bold px-8 py-4 rounded-xl hover:bg-amber-400 transition-all inline-block shadow-lg shadow-amber-500/10">
      Get a Quote
    </a>
  </section>
</Layout>
