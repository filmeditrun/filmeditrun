---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import { projects } from '../data/projects';
import workPage from '../content/pages/work.json';

const isEmbeddableVideo = (url: string) => url.includes('player.vimeo.com/video/');

const buildVimeoUrl = (baseUrl: string, params: Record<string, string>) => {
  const separator = baseUrl.includes('?') ? (baseUrl.endsWith('?') ? '' : '&') : '?';
  return `${baseUrl}${separator}${new URLSearchParams(params).toString()}`;
};

// Featured hero project is the primary showreel (first project in order)
const featuredProject = projects[0] || {
  id: "featured",
  title: "Featured Production Reel",
  client: "FilmEditRun",
  category: "Commercials",
  runtime: "0:45",
  description: "High-octane commercial production and cinematic visual storytelling.",
  videoUrl: "https://player.vimeo.com/video/828757840",
  thumbnail: "/og-image.jpg",
  backgroundStyle: "video",
  brightnessStyle: "bright",
};

// Archive projects feed into the scalable Bento Grid
const archiveProjects = projects;

// Extract unique categories dynamically for filtering pills
const categories = Array.from(new Set(archiveProjects.map((p) => p.category).filter(Boolean)));

// Hero Video & Poster configuration (Defaults to local /showreel.mp4 for instant 0ms dark playback)
const heroVideoPath = (workPage as any).heroVideoPath || "/showreel.mp4";
const heroPosterPath = (workPage as any).heroPosterPath || featuredProject.thumbnail || "/og-image.jpg";
const isLocalHeroVideo = Boolean(heroVideoPath && (heroVideoPath.endsWith('.mp4') || heroVideoPath.endsWith('.webm') || heroVideoPath.startsWith('/')));

// Archive section visibility (controlled via TinaCMS)
const showArchive = (workPage as any).showArchive !== false;
const modalProjects = showArchive ? archiveProjects : [featuredProject];

const featuredVimeoBgUrl = !isLocalHeroVideo && isEmbeddableVideo(heroVideoPath || featuredProject.videoUrl)
  ? buildVimeoUrl(heroVideoPath || featuredProject.videoUrl, { background: "1", autoplay: "1", loop: "1", muted: "1", dnt: "1", transparent: "1" })
  : "";

const parseHeading = (text: string) => {
  if (!text) return "";
  if (text.includes('*')) {
    return text.replace(/\*(.*?)\*/g, '<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">$1</span>');
  }
  return text;
};

// Schema.org VideoObject for Google & AI Video search carousels
const workVideoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": featuredProject.title,
  "description": featuredProject.description,
  "thumbnailUrl": [
    featuredProject.thumbnail.startsWith("http")
      ? featuredProject.thumbnail
      : `https://filmeditrun.co.uk${featuredProject.thumbnail}`
  ],
  "uploadDate": `${new Date().getFullYear()}-01-15T08:00:00+00:00`,
  "contentUrl": featuredProject.videoUrl,
  "embedUrl": featuredProject.videoUrl
};
---

<Layout
  title={workPage.seoTitle}
  description={workPage.seoDescription}
  ogImage={featuredProject.thumbnail}
  jsonLd={workVideoSchema}
  fullBleed={true}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://player.vimeo.com" />
    <link rel="preconnect" href="https://i.vimeocdn.com" />
  </Fragment>
  
  <!-- Ambient Deep Radian Shadow Mesh Background Overlay -->
  <div class="fixed inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(245,158,11,0.03),transparent_60%)] pointer-events-none z-0"></div>

  <!-- Fullscreen Parallax Capture Container -->
  <div class="w-full relative z-10 bg-ink">
    
    <!-- ============================================================== -->
    <!-- ============================================================== -->
    <!-- 1. FEATURED SHOWREEL HERO SECTION (Standardized Cinema Banner) -->
    <!-- ============================================================== -->
    <header 
      data-cinema-darkroom
      class="relative w-full pt-32 pb-20 sm:pt-40 sm:pb-28 overflow-hidden border-b border-white/10 select-none"
    >
      <!-- Media Backdrop Layer (Full-bleed, Zero White Flash) -->
      <div class="absolute inset-0 z-0 bg-[#0a0a0c] pointer-events-none w-full h-full overflow-hidden">
        <!-- Master Cinematic ND Filter (Guaranteed AA Contrast Across Video Feeds) -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/60 to-black/90 z-10 pointer-events-none" aria-hidden="true"></div>

        <!-- Ambient Amber Spotlight Glow at Top Center -->
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[40rem] sm:w-[56rem] h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none z-10" aria-hidden="true"></div>

        <!-- 1. Permanent Dark Baseline Poster -->
        <img 
          src={heroPosterPath} 
          alt={featuredProject.title} 
          loading="eager" 
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover z-0 opacity-100 bg-[#0a0a0c]" 
        />

        <!-- 2. Video Backdrop: Instant Local HTML5 Video or Shielded Transparent Vimeo -->
        {isLocalHeroVideo ? (
          <video 
            autoplay 
            muted 
            loop 
            playsinline 
            preload="auto"
            poster={heroPosterPath}
            class="absolute inset-0 w-full h-full object-cover z-0 opacity-90 sm:opacity-95"
          >
            <source src={heroVideoPath} type="video/mp4" />
          </video>
        ) : featuredVimeoBgUrl ? (
          <iframe 
            src={featuredVimeoBgUrl}
            title={`${featuredProject.title} background reel`}
            class="hero-vimeo-backdrop absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[177.78vh] min-w-full h-[56.25vw] min-h-full object-cover pointer-events-none z-0"
            allow="autoplay; fullscreen" 
            allowtransparency="true"
            style="background-color: transparent !important;"
            referrerpolicy="strict-origin-when-cross-origin"
            loading="eager"
          />
        ) : null}
      </div>

      <!-- Main Banner Content -->
      <div class="relative z-20 max-w-6xl mx-auto px-6">
        
        <!-- Eyebrow Category Tag (Site-Wide Standard) -->
        <div class="inline-flex items-center gap-2 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
            {workPage.headerTag || "SELECTED PORTFOLIO"}
          </span>
        </div>

        <!-- Large Title with Asterisk Gradient Support -->
        <h1 
          class="text-4xl sm:text-6xl lg:text-7xl font-black text-white keep-white tracking-tight leading-[1.08] mb-6 max-w-4xl"
          set:html={parseHeading(workPage.heading)}
        />

        <!-- Value Proposition / Introductory Paragraph -->
        <p class="text-base sm:text-lg lg:text-xl text-neutral-300 font-normal leading-relaxed max-w-3xl mb-8">
          {workPage.description}
        </p>

        <!-- Primary Action Row -->
        <div class="flex flex-wrap items-center gap-4">
          <button 
            type="button"
            data-open-dialog={`dialog-modal-${featuredProject.id}`}
            class="hero-reel-btn group inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold text-base hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xl shadow-amber-500/20 cursor-pointer outline-none"
            aria-label="Watch Featured Showreel"
          >
            <!-- Play Icon -->
            <svg class="w-4 h-4 fill-current translate-x-0.5" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
            <span>{workPage.videoButtonLabel || "Watch Featured Showreel"}</span>
            <span class="font-mono text-xs opacity-80 font-normal tracking-wider">({featuredProject.runtime || "0:45"})</span>
          </button>

          {showArchive && (
            <a 
              href="#archive"
              class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-white/5 border border-line hover:border-amber-500/40 hover:bg-white/10 text-base font-medium text-white transition-all text-center"
            >
              <span>{workPage.scrollIndicatorText || "Browse Selected Films ↓"}</span>
            </a>
          )}
        </div>

      </div>
    </header>

    <!-- ============================================================== -->
    <!-- 2. SCALABLE BENTO GRID ARCHIVE & CATEGORY FILTER SECTION       -->
    <!-- ============================================================== -->
    {showArchive && (
      <section id="archive" class="max-w-7xl mx-auto px-6 pt-16 pb-24 sm:pb-32 scroll-mt-20">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-white/10">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
              {workPage.archiveTag}
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white" set:html={parseHeading(workPage.archiveHeading)} />
        </div>
        <p class="text-neutral-400 max-w-md text-sm sm:text-base leading-relaxed font-light">
          {workPage.archiveDescription}
        </p>
      </div>

      <!-- 1. Pure CSS Category Filter Radio Inputs (Zero-JS) -->
      <input
        type="radio"
        name="work_category_filter"
        id="filter-all"
        value="all"
        class="sr-only"
        checked
      />
      {categories.map((category) => (
        <input
          type="radio"
          name="work_category_filter"
          id={`filter-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          value={category}
          class="sr-only"
        />
      ))}

      <!-- Category Filter Tabs / Pills -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 pt-8 pb-12" id="filter-bar">
        <label 
          for="filter-all"
          id="label-filter-all"
          class="filter-pill min-h-[40px] inline-flex items-center justify-center px-4.5 py-2 sm:px-4 sm:py-2 rounded-full font-mono text-xs uppercase tracking-wider transition-all cursor-pointer select-none border border-white/10 bg-neutral-900/80 text-neutral-400 hover:text-white hover:bg-neutral-800 active:scale-95 [touch-action:manipulation]"
        >
          {workPage.filterAllLabel}
        </label>
        {categories.map((category) => {
          const filterSlug = category.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          return (
            <label 
              for={`filter-${filterSlug}`}
              id={`label-filter-${filterSlug}`}
              class="filter-pill min-h-[40px] inline-flex items-center justify-center px-4.5 py-2 sm:px-4 sm:py-2 rounded-full font-mono text-xs uppercase tracking-wider transition-all cursor-pointer select-none border border-white/10 bg-neutral-900/80 text-neutral-400 hover:text-white hover:bg-neutral-800 active:scale-95 [touch-action:manipulation]"
            >
              {category}
            </label>
          );
        })}
      </div>

      <!-- Bento Grid Archive Container -->
      <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6 sm:gap-8">
        {archiveProjects.map((project, index) => {
          // Visual Rhythm: alternate wide (7-col) and compact (5-col) bento cards
          const isWide = (index % 4 === 0 || index % 4 === 3);
          const colSpanClass = isWide ? "lg:col-span-7" : "lg:col-span-5";
          const categorySlug = (project.category || '').toLowerCase().replace(/[^a-z0-9]+/g, '-');

          return (
            <article 
              data-project-card
              data-category={categorySlug}
              data-open-dialog={`dialog-modal-${project.id}`}
              data-cinema-darkroom="true"
              class:list={[
                "project-card group relative aspect-[16/10] sm:aspect-16/9 rounded-2xl overflow-hidden bg-[#0c0c11] border border-white/10 hover:border-amber-500/60 transition-all duration-500 cursor-pointer shadow-xl hover:shadow-2xl hover:shadow-amber-500/10 hover:-translate-y-1.5 select-none",
                colSpanClass
              ]}
            >
              <!-- 1. FULL-BLEED WIDESCREEN MEDIA (Cinema Aspect Ratio) -->
              <img 
                src={project.thumbnail} 
                alt={project.title} 
                loading="lazy" 
                decoding="async" 
                class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-transform duration-700 ease-out" 
              />

              <!-- Resting Subtle Scrim (Provides crisp contrast for bottom typography) -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent pointer-events-none transition-opacity duration-500" aria-hidden="true"></div>

              <!-- Darkening Hover Overlay -->
              <div class="absolute inset-0 bg-black/40 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>

              <!-- Top Runtime Badge (Discreet glass pill in top-right corner) -->
              {project.runtime && (
                <div class="absolute top-4 right-4 sm:top-5 sm:right-5 z-20 pointer-events-none">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-neutral-950/80 backdrop-blur-md border border-white/10 text-[10px] font-mono tracking-wider text-neutral-300 group-hover:text-white transition-colors">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                    {project.runtime}
                  </span>
                </div>
              )}

              <!-- Dead-Center Amber Play Cue (Soft Glass Resting, Luminous Bloom on Hover) -->
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-20">
                <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-neutral-950/75 border border-white/20 backdrop-blur-md text-white flex items-center justify-center shadow-xl group-hover:bg-gradient-to-r group-hover:from-amber-400 group-hover:to-amber-500 group-hover:border-transparent group-hover:text-neutral-950 group-hover:scale-110 group-hover:shadow-2xl group-hover:shadow-amber-500/30 transition-all duration-300 ease-out">
                  <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-current translate-x-0.5" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              </div>

              <!-- Grounded Bottom Content: Client Eyebrow + Bold Title ONLY (Zero Clutter) -->
              <figcaption class="absolute inset-x-0 bottom-0 p-6 sm:p-7 flex flex-col justify-end pointer-events-none z-20">
                <div class="transform transition-transform duration-300 group-hover:-translate-y-1">
                  {project.client && (
                    <span class="text-xs uppercase tracking-widest font-mono text-amber-500/90 group-hover:text-amber-400 transition-colors duration-300 font-semibold mb-1.5 block">
                      {project.client}
                    </span>
                  )}
                  <h3 class="text-xl sm:text-2xl lg:text-3xl font-black text-white keep-white tracking-tight leading-snug drop-shadow-md">
                    {project.title}
                  </h3>
                </div>
              </figcaption>
            </article>
          );
        })}
      </div>

    </section>
    )}

    <!-- ============================================================== -->
    <!-- 3. FINAL STUDIO COMMISSIONING CTA                              -->
    <!-- ============================================================== -->
    <CtaSection
      tag="Commission a Production"
      heading="Have an upcoming shoot or *conference brief*?"
      description="Whether you need multi-camera coverage in London, an executive brand story in Cambridge, or fast post-production turnaround, let’s talk through your dates and deliverables."
      primaryButtonLabel="Start Project Brief →"
      primaryButtonLink="/contact"
      secondaryButtonLabel="Explore Services & Specs"
      secondaryButtonLink="/services"
      trustSignals={[
        "24h Proposal Turnaround",
        "Cambridge & London Hubs",
        "Direct Filmmaker Collaboration"
      ]}
    />

    <!-- ============================================================== -->
    <!-- 4. NATIVE HTML5 THEATER MODAL DIALOGS                          -->
    <!-- ============================================================== -->
    {modalProjects.map((project) => (
      <dialog 
        id={`dialog-modal-${project.id}`} 
        class="fixed inset-0 m-auto w-full max-w-5xl bg-transparent p-4 sm:p-6 backdrop:bg-neutral-950/95 border-0 outline-none overflow-visible open:animate-theater-in z-50 focus:outline-none focus-visible:outline-none"
      >
        <div class="relative w-full max-w-5xl mx-auto flex flex-col">
          <!-- Native Close Trigger Bar -->
          <div class="flex justify-end pb-3">
            <form method="dialog">
              <button class="text-neutral-400 hover:text-white text-xs font-mono flex items-center gap-2 bg-neutral-900 border border-neutral-800 px-4 py-2 rounded-xl transition-colors cursor-pointer shadow-2xl">
                {workPage.closeModalLabel}
              </button>
            </form>
          </div>
          
          <!-- Exact 16:9 Presentation Player Container (100% Borderless, Zero Artifact Seam) -->
          <div class="theater-player-frame relative w-full aspect-video rounded-2xl overflow-hidden bg-black border-0 outline-none">
            <iframe 
              data-src={isEmbeddableVideo(project.videoUrl) ? buildVimeoUrl(project.videoUrl, { autoplay: "1", muted: "0", dnt: "1", title: "0", byline: "0", portrait: "0", transparent: "0" }) : ""}
              title={`${project.title} full player`}
              class="w-full h-full border-0 outline-none block bg-black" 
              frameborder="0"
              tabindex="-1"
              allow="autoplay; fullscreen; picture-in-picture" 
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
        </div>
      </dialog>
    ))}
  </div>
</Layout>

<!-- =========================================================================
     ZERO-JS CSS FILTER ENGINE: NATIVE :has() CARD DISPLAY & PILL STATES
     ========================================================================= -->
<style is:global>
  /* Active filter pill states driven purely by radio :checked (Adapts dynamically to all 3 grades) */
  html:has(#filter-all:checked) #label-filter-all {
    background: var(--color-accent) !important;
    color: var(--color-ink, #0a0a0c) !important;
    font-weight: 700 !important;
    box-shadow: 0 10px 25px -5px var(--color-accent-glow, rgba(232, 197, 71, 0.3)) !important;
    border-color: transparent !important;
  }

  /* Dynamically style active pills for each category */
  html:has(#filter-commercials:checked) #label-filter-commercials,
  html:has(#filter-brand-films:checked) #label-filter-brand-films,
  html:has(#filter-documentary:checked) #label-filter-documentary,
  html:has(#filter-music-video:checked) #label-filter-music-video,
  html:has(#filter-corporate:checked) #label-filter-corporate,
  html:has(#filter-events:checked) #label-filter-events {
    background: var(--color-accent) !important;
    color: var(--color-ink, #0a0a0c) !important;
    font-weight: 700 !important;
    box-shadow: 0 10px 25px -5px var(--color-accent-glow, rgba(232, 197, 71, 0.3)) !important;
    border-color: transparent !important;
  }

  /* Smooth hardware-accelerated transitions on project cards */
  [data-project-card] {
    transform: translateZ(0);
    transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1), transform 300ms cubic-bezier(0.16, 1, 0.3, 1), border-color 300ms ease;
  }

  /* Pure CSS Filtering: Hide cards that don't match selected category */
  html:has(#filter-commercials:checked) [data-project-card]:not([data-category="commercials"]),
  html:has(#filter-brand-films:checked) [data-project-card]:not([data-category="brand-films"]),
  html:has(#filter-documentary:checked) [data-project-card]:not([data-category="documentary"]),
  html:has(#filter-music-video:checked) [data-project-card]:not([data-category="music-video"]),
  html:has(#filter-corporate:checked) [data-project-card]:not([data-category="corporate"]),
  html:has(#filter-events:checked) [data-project-card]:not([data-category="events"]) {
    display: none !important;
  }

  /* Pure CSS Zero-JS Smooth Reveal for Fallback Embedded Vimeo Background */
  @keyframes cinemaHeroFadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }
  .hero-vimeo-backdrop {
    opacity: 0;
    animation: cinemaHeroFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.2s forwards;
  }
</style>

<!-- Zero-JS Modal Video Controller (Only unmounts iframe to stop background audio on close) -->
<script>
  // Open dialog and mount iframe src on demand
  document.querySelectorAll<HTMLElement>('[data-open-dialog]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const dialogId = trigger.dataset.openDialog;
      if (!dialogId) return;
      const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
      const iframe = dialog?.querySelector('iframe');
      if (iframe && iframe.dataset.src && !iframe.src) {
        iframe.src = iframe.dataset.src;
      }
      dialog?.showModal();
    });
  });

  // Stop video playback on close by unmounting src
  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog) => {
    dialog.addEventListener('close', () => {
      const iframe = dialog.querySelector('iframe');
      if (iframe) iframe.removeAttribute('src');
    });
  });
</script>
