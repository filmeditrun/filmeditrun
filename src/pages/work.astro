---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
import workPage from '../content/pages/work.json';

const isEmbeddableVideo = (url: string) => url.includes('player.vimeo.com/video/');

const buildVimeoUrl = (baseUrl: string, params: Record<string, string>) => {
  const separator = baseUrl.includes('?') ? (baseUrl.endsWith('?') ? '' : '&') : '?';
  return `${baseUrl}${separator}${new URLSearchParams(params).toString()}`;
};

// Featured hero project is the primary showreel (first project in order)
const featuredProject = projects[0] || {
  id: "featured",
  title: "Featured Production Reel",
  client: "FilmEditRun",
  category: "Commercials",
  runtime: "0:45",
  description: "High-octane commercial production and cinematic visual storytelling.",
  videoUrl: "https://player.vimeo.com/video/828757840",
  thumbnail: "/og-image.jpg",
  backgroundStyle: "video",
  brightnessStyle: "bright",
};

// Archive projects feed into the scalable Bento Grid
const archiveProjects = projects;

// Extract unique categories dynamically for filtering pills
const categories = Array.from(new Set(archiveProjects.map((p) => p.category).filter(Boolean)));

const featuredVimeoBgUrl = isEmbeddableVideo(featuredProject.videoUrl)
  ? buildVimeoUrl(featuredProject.videoUrl, { background: "1", autoplay: "1", loop: "1", muted: "1", dnt: "1" })
  : "";

const parseHeading = (text: string) => {
  if (!text) return "";
  if (text.includes('*')) {
    return text.replace(/\*(.*?)\*/g, '<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">$1</span>');
  }
  const parts = text.split(' ');
  if (parts.length > 1) {
    const lastWord = parts.pop();
    return `${parts.join(' ')} <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">${lastWord}</span>`;
  }
  return text;
};

// Schema.org VideoObject for Google & AI Video search carousels
const workVideoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": featuredProject.title,
  "description": featuredProject.description,
  "thumbnailUrl": [
    featuredProject.thumbnail.startsWith("http")
      ? featuredProject.thumbnail
      : `https://filmeditrun.co.uk${featuredProject.thumbnail}`
  ],
  "uploadDate": "2024-01-01T08:00:00+00:00",
  "contentUrl": featuredProject.videoUrl,
  "embedUrl": featuredProject.videoUrl
};
---

<Layout
  title={workPage.seoTitle}
  description={workPage.seoDescription}
  ogImage={featuredProject.thumbnail}
  jsonLd={workVideoSchema}
  fullBleed={true}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://player.vimeo.com" />
    <link rel="preconnect" href="https://i.vimeocdn.com" />
  </Fragment>
  
  <!-- Ambient Deep Radian Shadow Mesh Background Overlay -->
  <div class="fixed inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(245,158,11,0.03),transparent_60%)] pointer-events-none z-0"></div>

  <!-- Fullscreen Parallax Capture Container -->
  <div class="w-full relative z-10 bg-ink">
    
    <!-- ============================================================== -->
    <!-- 1. FEATURED SHOWREEL HERO SECTION (MATCHES HOMEPAGE HEIGHT)    -->
    <!-- ============================================================== -->
    <!-- ============================================================== -->
    <!-- 1. FEATURED SHOWREEL HERO SECTION (CONCEPT 2: DEAD-CENTER PREMIERE) -->
    <!-- ============================================================== -->
    <section 
      data-cinema-darkroom
      class="relative w-full min-h-[100dvh] pt-20 flex flex-col justify-between p-6 sm:p-12 overflow-hidden border-b border-neutral-900/60 select-none"
    >
      <!-- Automated Backdrop Manager Layer (Full-bleed 100vh, Zero Muddy Gradient) -->
      <div class="absolute inset-0 z-0 bg-black pointer-events-none w-full h-full overflow-hidden">
        <!-- Minimal Top Scrim for Navbar Contrast Only (90% of screen has zero overlay) -->
        <div class="absolute top-0 inset-x-0 h-28 bg-gradient-to-b from-black/70 to-transparent z-10 pointer-events-none" aria-hidden="true"></div>

        {/* Video Backdrop: 100% Crisp, Pure Cinematography */}
        {featuredProject.videoUrl.endsWith('.mp4') || featuredProject.videoUrl.startsWith('/') ? (
          <video 
            autoplay 
            muted 
            loop 
            playsinline 
            preload="metadata"
            poster={featuredProject.thumbnail}
            class="absolute inset-0 w-full h-full object-cover z-0 opacity-100"
          >
            <source src={featuredProject.videoUrl} type="video/mp4" />
          </video>
        ) : featuredProject.backgroundStyle === "video" && featuredVimeoBgUrl ? (
          <iframe 
            src={featuredVimeoBgUrl}
            title={`${featuredProject.title} background reel`}
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[177.78vh] min-w-full h-[56.25vw] min-h-full object-cover pointer-events-none z-0 opacity-100 transition-all duration-500"
            allow="autoplay; fullscreen" 
            referrerpolicy="strict-origin-when-cross-origin"
            loading="eager"
          />
        ) : (
          <img 
            src={featuredProject.thumbnail} 
            alt={featuredProject.title} 
            loading="eager" 
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover opacity-100 z-0" 
          />
        )}
      </div>

      <!-- Spacer to balance vertical centering with navbar height -->
      <div class="h-10 sm:h-16"></div>

      <!-- DEAD-CENTER "WATCH OUR REEL" BUTTON -->
      <div class="relative z-30 flex-1 flex flex-col items-center justify-center text-center px-4 my-auto">
        <button 
          type="button"
          data-open-dialog={`dialog-modal-${featuredProject.id}`}
          class="hero-reel-btn group inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-mono font-bold text-sm uppercase tracking-wider hover:scale-[1.03] active:scale-[0.98] transition-all shadow-2xl shadow-amber-500/20 cursor-pointer outline-none"
          aria-label="Watch our reel"
        >
          <!-- Play Icon -->
          <svg class="w-4 h-4 fill-current translate-x-0.5" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
          <span>Watch our reel</span>
          <span class="transform group-hover:translate-x-1 transition-transform duration-300" aria-hidden="true">&rarr;</span>
        </button>
      </div>

      <!-- Minimal Bottom Scroll Cue Anchored at Bottom Center -->
      <div class="relative z-30 pb-4 sm:pb-6 flex justify-center">
        <a 
          href="#archive"
          class="group inline-flex flex-col items-center gap-1.5 text-neutral-400 hover:text-white font-mono text-[10px] uppercase tracking-[0.25em] transition-colors"
          aria-label="Scroll to Project Archive"
        >
          <span class="opacity-70 group-hover:opacity-100 transition-opacity">Explore Archive</span>
          <span class="w-7 h-7 rounded-full border border-white/10 group-hover:border-amber-500/50 flex items-center justify-center text-amber-500 group-hover:text-amber-400 animate-bounce text-xs bg-neutral-950/60 backdrop-blur-sm">
            &darr;
          </span>
        </a>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- 2. SCALABLE BENTO GRID ARCHIVE & CATEGORY FILTER SECTION       -->
    <!-- ============================================================== -->
    <section id="archive" class="max-w-7xl mx-auto px-6 py-24 sm:py-32 scroll-mt-20">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-white/10">
        <div>
          <span class="text-xs uppercase tracking-[0.25em] text-amber-500 font-mono font-bold block mb-3">
            {workPage.archiveTag}
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white">
            {workPage.archiveHeading}
          </h2>
        </div>
        <p class="text-neutral-400 max-w-md text-sm sm:text-base leading-relaxed">
          {workPage.archiveDescription}
        </p>
      </div>

      <!-- 1. Pure CSS Category Filter Radio Inputs (Zero-JS) -->
      <input
        type="radio"
        name="work_category_filter"
        id="filter-all"
        value="all"
        class="sr-only"
        checked
      />
      {categories.map((category) => (
        <input
          type="radio"
          name="work_category_filter"
          id={`filter-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          value={category}
          class="sr-only"
        />
      ))}

      <!-- Category Filter Tabs / Pills -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 pt-8 pb-12" id="filter-bar">
        <label 
          for="filter-all"
          id="label-filter-all"
          class="filter-pill min-h-[40px] inline-flex items-center justify-center px-4.5 py-2 sm:px-4 sm:py-2 rounded-full font-mono text-xs uppercase tracking-wider transition-all cursor-pointer select-none border border-white/10 bg-neutral-900/80 text-neutral-400 hover:text-white hover:bg-neutral-800 active:scale-95 [touch-action:manipulation]"
        >
          {workPage.filterAllLabel}
        </label>
        {categories.map((category) => {
          const filterSlug = category.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          return (
            <label 
              for={`filter-${filterSlug}`}
              id={`label-filter-${filterSlug}`}
              class="filter-pill min-h-[40px] inline-flex items-center justify-center px-4.5 py-2 sm:px-4 sm:py-2 rounded-full font-mono text-xs uppercase tracking-wider transition-all cursor-pointer select-none border border-white/10 bg-neutral-900/80 text-neutral-400 hover:text-white hover:bg-neutral-800 active:scale-95 [touch-action:manipulation]"
            >
              {category}
            </label>
          );
        })}
      </div>

      <!-- Bento Grid Archive Container -->
      <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6 sm:gap-8">
        {archiveProjects.map((project, index) => {
          // Visual Rhythm: alternate wide (7-col) and compact (5-col) bento cards
          const isWide = (index % 4 === 0 || index % 4 === 3);
          const colSpanClass = isWide ? "lg:col-span-7" : "lg:col-span-5";
          const categorySlug = (project.category || '').toLowerCase().replace(/[^a-z0-9]+/g, '-');

          return (
            <article 
              data-project-card
              data-category={categorySlug}
              data-open-dialog={`dialog-modal-${project.id}`}
              class:list={[
                "project-card group relative rounded-2xl overflow-hidden bg-neutral-900/90 border border-neutral-800 hover:border-amber-500/50 transition-all duration-300 cursor-pointer flex flex-col justify-between shadow-xl hover:shadow-2xl hover:shadow-amber-500/5 hover:-translate-y-1.5",
                colSpanClass
              ]}
            >
              <!-- 1. TOP CONTENT CONTAINER (Text on Top for Instant Reading) -->
              <div class="p-6 pb-5 sm:p-7 sm:pb-6 flex flex-col justify-between flex-1">
                <!-- Client Eyebrow Tag -->
                <span class="text-xs uppercase tracking-widest font-mono text-neutral-400 group-hover:text-amber-400 transition-colors duration-300 font-semibold mb-2 block">
                  {project.client}
                </span>

                <!-- Bold Project Title (Zero Clutter) -->
                <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight group-hover:text-amber-400 transition-colors duration-300 leading-snug">
                  {project.title}
                </h3>
              </div>

              <!-- 2. BOTTOM WIDESCREEN MEDIA WINDOW (16:9 Cinema Aspect Ratio) -->
              <div class="relative w-full aspect-16/9 overflow-hidden bg-black select-none border-t border-neutral-800/80">
                <img 
                  src={project.thumbnail} 
                  alt={project.title} 
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-out" 
                />

                <!-- Dead-Center Amber Play Cue (Soft Glass Resting, Luminous Bloom on Hover) -->
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-20">
                  <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-neutral-950/75 border border-white/20 backdrop-blur-md text-white flex items-center justify-center shadow-xl group-hover:bg-gradient-to-r group-hover:from-amber-400 group-hover:to-amber-500 group-hover:border-transparent group-hover:text-neutral-950 group-hover:scale-110 group-hover:shadow-2xl group-hover:shadow-amber-500/30 transition-all duration-300 ease-out">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-current translate-x-0.5" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>

    </section>

    <!-- ============================================================== -->
    <!-- 3. NATIVE HTML5 THEATER MODAL DIALOGS                          -->
    <!-- ============================================================== -->
    {archiveProjects.map((project) => (
      <dialog 
        id={`dialog-modal-${project.id}`} 
        class="fixed inset-0 m-auto w-full max-w-5xl bg-transparent p-4 sm:p-6 backdrop:bg-neutral-950/95 border-0 outline-none overflow-visible open:animate-theater-in z-50 focus:outline-none focus-visible:outline-none"
      >
        <div class="relative w-full max-w-5xl mx-auto flex flex-col">
          <!-- Native Close Trigger Bar -->
          <div class="flex justify-end pb-3">
            <form method="dialog">
              <button class="text-neutral-400 hover:text-white text-xs font-mono flex items-center gap-2 bg-neutral-900 border border-neutral-800 px-4 py-2 rounded-xl transition-colors cursor-pointer shadow-2xl">
                {workPage.closeModalLabel}
              </button>
            </form>
          </div>
          
          <!-- Exact 16:9 Presentation Player Container (100% Borderless, Zero Artifact Seam) -->
          <div class="theater-player-frame relative w-full aspect-video rounded-2xl overflow-hidden bg-black border-0 outline-none">
            <iframe 
              data-src={isEmbeddableVideo(project.videoUrl) ? buildVimeoUrl(project.videoUrl, { autoplay: "1", muted: "0", dnt: "1", title: "0", byline: "0", portrait: "0", transparent: "0" }) : ""}
              title={`${project.title} full player`}
              class="w-full h-full border-0 outline-none block bg-black" 
              frameborder="0"
              tabindex="-1"
              allow="autoplay; fullscreen; picture-in-picture" 
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
        </div>
      </dialog>
    ))}
  </div>
</Layout>

<!-- =========================================================================
     ZERO-JS CSS FILTER ENGINE: NATIVE :has() CARD DISPLAY & PILL STATES
     ========================================================================= -->
<style is:global>
  /* Active filter pill states driven purely by radio :checked (Adapts dynamically to all 3 grades) */
  html:has(#filter-all:checked) #label-filter-all {
    background: var(--color-accent) !important;
    color: var(--color-ink, #0a0a0c) !important;
    font-weight: 700 !important;
    box-shadow: 0 10px 25px -5px var(--color-accent-glow, rgba(232, 197, 71, 0.3)) !important;
    border-color: transparent !important;
  }

  /* Dynamically style active pills for each category */
  html:has(#filter-commercials:checked) #label-filter-commercials,
  html:has(#filter-brand-films:checked) #label-filter-brand-films,
  html:has(#filter-documentary:checked) #label-filter-documentary,
  html:has(#filter-music-video:checked) #label-filter-music-video,
  html:has(#filter-corporate:checked) #label-filter-corporate,
  html:has(#filter-events:checked) #label-filter-events {
    background: var(--color-accent) !important;
    color: var(--color-ink, #0a0a0c) !important;
    font-weight: 700 !important;
    box-shadow: 0 10px 25px -5px var(--color-accent-glow, rgba(232, 197, 71, 0.3)) !important;
    border-color: transparent !important;
  }

  /* Smooth hardware-accelerated transitions on project cards */
  [data-project-card] {
    transform: translateZ(0);
    transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1), transform 300ms cubic-bezier(0.16, 1, 0.3, 1), border-color 300ms ease;
  }

  /* Pure CSS Filtering: Hide cards that don't match selected category */
  html:has(#filter-commercials:checked) [data-project-card]:not([data-category="commercials"]),
  html:has(#filter-brand-films:checked) [data-project-card]:not([data-category="brand-films"]),
  html:has(#filter-documentary:checked) [data-project-card]:not([data-category="documentary"]),
  html:has(#filter-music-video:checked) [data-project-card]:not([data-category="music-video"]),
  html:has(#filter-corporate:checked) [data-project-card]:not([data-category="corporate"]),
  html:has(#filter-events:checked) [data-project-card]:not([data-category="events"]) {
    display: none !important;
  }


</style>

<!-- Zero-JS Modal Video Controller (Only unmounts iframe to stop background audio on close) -->
<script>
  // Open dialog and mount iframe src on demand
  document.querySelectorAll<HTMLElement>('[data-open-dialog]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const dialogId = trigger.dataset.openDialog;
      if (!dialogId) return;
      const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
      const iframe = dialog?.querySelector('iframe');
      if (iframe && iframe.dataset.src && !iframe.src) {
        iframe.src = iframe.dataset.src;
      }
      dialog?.showModal();
    });
  });

  // Stop video playback on close by unmounting src
  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog) => {
    dialog.addEventListener('close', () => {
      const iframe = dialog.querySelector('iframe');
      if (iframe) iframe.removeAttribute('src');
    });
  });
</script>
