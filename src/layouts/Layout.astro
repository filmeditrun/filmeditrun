---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeDock from "../components/ThemeDock.astro";
import SEO from "../components/seo/SEO.astro";
import { siteConfig } from "../data/siteConfig";
import "@fontsource-variable/dm-sans";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  fullBleed?: boolean;
}

const {
  title = "FilmEditRun",
  description = "Corporate and creative video production. Picture, sound, and story.",
  canonical,
  ogImage,
  ogType,
  noindex,
  jsonLd,
  fullBleed = false,
} = Astro.props;

const defaultTheme = siteConfig.defaultTheme || "dark-noir";
const enableThemeSwitcher = siteConfig.enableThemeSwitcher !== false;

const darkNoirTitle = siteConfig.darkNoirTitle || "Dark Noir";
const darkNoirAccent = siteConfig.darkNoirAccentColor || "#e8c547";
const highKeyTitle = siteConfig.highKeyTitle || "High-Key Light";
const highKeyAccent = siteConfig.highKeyAccentColor || "#e11d48";
const highKeyBg = siteConfig.highKeyBgColor || "#ffffff";
const supernovaTitle = siteConfig.supernovaTitle || "Supernova";
const supernovaAccent = siteConfig.supernovaAccentColor || "#9013FE";
const supernovaSecondary = siteConfig.supernovaSecondaryColor || "#0377FF";
---

<!doctype html>
<html lang="en" data-theme={defaultTheme} class={defaultTheme === "high-key" ? "light" : "dark"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- UNIFIED HIGH-OCTANE SEO & AI SEARCH ENGINE (Structured Data, OpenGraph, Canonical) -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
    />

    <!-- DYNAMIC CMS THEME COLOR TOKENS INJECTION -->
    <style define:vars={{ darkNoirAccent, highKeyAccent, highKeyBg, supernovaAccent, supernovaSecondary }}>
      :root,
      html[data-theme="dark-noir"],
      html:has(#theme-choice-dark-noir:checked) {
        --color-accent: var(--darkNoirAccent);
        --color-amber-400: var(--darkNoirAccent);
        --color-amber-500: var(--darkNoirAccent);
      }
      html[data-theme="high-key"],
      html:has(#theme-choice-high-key:checked) {
        --color-ink: var(--highKeyBg);
        --color-ink-soft: var(--highKeyBg);
        --color-neutral-950: var(--highKeyBg);
        --color-neutral-900: var(--highKeyBg);
        --color-accent: var(--highKeyAccent);
        --color-amber-500: var(--highKeyAccent);
        --color-amber-400: var(--highKeyAccent);
      }
      html[data-theme="supernova"],
      html:has(#theme-choice-supernova:checked) {
        --color-accent: var(--supernovaAccent);
        --color-amber-300: var(--supernovaAccent);
        --color-amber-400: var(--supernovaAccent);
        --color-amber-500: var(--supernovaAccent);
        --color-amber-600: var(--supernovaSecondary);
        --supernova-secondary: var(--supernovaSecondary);
      }
    </style>

    <!-- CRITICAL ZERO-FOUC CINEMATIC THEME ENGINE LOADER -->
    <script is:inline define:vars={{ defaultTheme }}>
      (function () {
        try {
          var stored = localStorage.getItem("antigravity_theme");
          var activeTheme = stored || defaultTheme || "dark-noir";
          document.documentElement.setAttribute("data-theme", activeTheme);
          if (activeTheme === "high-key") {
            document.documentElement.classList.remove("dark");
            document.documentElement.classList.add("light");
          } else {
            document.documentElement.classList.remove("light");
            document.documentElement.classList.add("dark");
          }
        } catch (e) {
          document.documentElement.setAttribute("data-theme", defaultTheme || "dark-noir");
        }
      })();
    </script>

    <!-- CRITICAL ADDITION: This accepts custom page schemas like the Cambridge JSON-LD -->
    <slot name="head" />

    <noscript>
      <style>
        .animated-accent-underline {
          background-size: 100% 3px !important;
        }
        .animated-accent-line {
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen bg-ink text-paper font-sans antialiased flex flex-col">
    <Header />
    <main class:list={["flex-1", !fullBleed && "pt-20"]}>
      <slot />
    </main>
    <Footer />
    {enableThemeSwitcher && (
      <ThemeDock
        defaultTheme={defaultTheme}
        title={siteConfig.themeSwitcherTitle}
        darkNoirTitle={darkNoirTitle}
        darkNoirAccent={darkNoirAccent}
        highKeyTitle={highKeyTitle}
        highKeyAccent={highKeyAccent}
        highKeyBg={highKeyBg}
        supernovaTitle={supernovaTitle}
        supernovaAccent={supernovaAccent}
        supernovaSecondary={supernovaSecondary}
      />
    )}

    <!-- ACCENT LINE DRAW CONTROLLER (Smooth left-to-right draw when scrolled into view) -->
    <script is:inline>
      (function () {
        function initAccentLines() {
          var elements = document.querySelectorAll('.animated-accent-underline:not(.is-visible), .animated-accent-line:not(.is-visible)');
          if (!elements.length) return;

          if ('IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function (entries, obs) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  obs.unobserve(entry.target);
                }
              });
            }, {
              threshold: 0.15,
              rootMargin: '0px 0px -40px 0px'
            });

            elements.forEach(function (el) {
              observer.observe(el);
            });
          } else {
            elements.forEach(function (el) {
              el.classList.add('is-visible');
            });
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initAccentLines);
        } else {
          initAccentLines();
        }
      })();
    </script>
  </body>
</html>
