---
// 1. RESTORE YOUR LOGO CONFIG DATA FROM NAVBAR
import { siteConfig } from '../data/siteConfig';

// ==========================================
// ACTIVE PAGE DETECTION & LINKS
// ==========================================
const pathname = Astro.url.pathname;

const defaultLinks = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/work", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const links = siteConfig.navLinks && siteConfig.navLinks.length > 0
  ? siteConfig.navLinks
  : defaultLinks;

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
// ==========================================
---

<!-- Cinematic Studio Navbar Wrapper -->
<header class="fixed inset-x-0 top-0 z-50 h-20 border-b border-white/10 bg-ink/80 backdrop-blur-2xl">
  <!-- 1. Pure CSS Checkbox Hack for Mobile Menu Toggle (Zero-JS) -->
  <input
    type="checkbox"
    id="mobile-nav-toggle"
    class="peer/nav sr-only"
    aria-hidden="true"
    autocomplete="off"
  />

  <div class="mx-auto flex h-full max-w-7xl items-center justify-between px-6">
    
    <!-- 2. Dynamic Logo Switcher -->
    <a href="/" class="flex items-center gap-3 group">
      {siteConfig.useImageLogo ? (
        <img 
          src={siteConfig.logoImagePath} 
          alt={siteConfig.siteName} 
          loading="eager"
          decoding="async"
          class="h-8 w-auto object-contain group-hover:opacity-90 transition-opacity" 
        />
      ) : (
        <span class="text-xl font-bold tracking-tight text-white font-sans group-hover:text-amber-400 transition-colors">
          {siteConfig.logoText}
        </span>
      )}
    </a>

    <!-- 3. Accessible Label Button (Acts as Toggle for #mobile-nav-toggle) -->
    <label
      for="mobile-nav-toggle"
      class="group md:hidden relative p-2.5 rounded-lg text-neutral-400 hover:text-white hover:bg-white/5 active:scale-95 transition-all cursor-pointer touch-manipulation select-none"
      aria-label="Toggle Navigation Menu"
    >
      <!-- Hamburger Icon (Visible by default, hidden when checked) -->
      <svg
        class="h-6 w-6 block peer-checked/nav:hidden transition-transform duration-200 group-hover:scale-105"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>

      <!-- Close (X) Icon (Hidden by default, shown when checked) -->
      <svg
        class="h-6 w-6 hidden peer-checked/nav:block transition-transform duration-200 group-hover:rotate-90 text-amber-400"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </label>

    <!-- 4. Navigation Links: Hidden by default on mobile, revealed via peer-checked/nav -->
    <nav 
      id="nav-links"
      class="hidden peer-checked/nav:flex absolute top-full left-0 right-0 bg-ink/95 backdrop-blur-2xl border-b border-white/10 p-6 flex-col gap-2.5 text-base tracking-wide shadow-2xl overscroll-contain md:static md:flex md:flex-row md:items-center md:gap-1 md:text-[13px] md:border-none md:p-0 md:bg-transparent md:shadow-none transition-all duration-300 select-none" 
      aria-label="Primary"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-xl px-5 py-3.5 transition-all active:scale-[0.98] [touch-action:manipulation] md:rounded-full md:px-4 md:py-1.5 md:active:scale-100",
              isActive(link.href)
                ? "bg-gradient-to-r from-amber-400 to-amber-600 text-neutral-950 font-bold shadow-md shadow-amber-500/20"
                : "text-neutral-300 hover:text-white hover:bg-white/5 active:bg-white/10",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

  </div>
</header>
