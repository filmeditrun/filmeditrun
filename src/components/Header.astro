---
// 1. RESTORE YOUR LOGO CONFIG DATA FROM NAVBAR
import { siteConfig } from '../data/siteConfig';

// ==========================================
// ACTIVE PAGE DETECTION & LINKS
// ==========================================
const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/work", label: "Work" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
// ==========================================
---

<!-- Cinematic Studio Navbar Wrapper -->
<header class="fixed inset-x-0 top-0 z-50 border-b border-neutral-800/80 bg-neutral-950/75 backdrop-blur-2xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between flex-wrap md:flex-nowrap px-6 py-4">
    
    <!-- 2. DYNAMIC LOGO SWITCHER FROM NAVBAR RESTORED HERE -->
    <a href="/" class="flex items-center gap-3 group">
      {siteConfig.useImageLogo ? (
        <img 
          src={siteConfig.logoImagePath} 
          alt={siteConfig.siteName} 
          class="h-8 w-auto object-contain group-hover:opacity-90 transition-opacity" 
        />
      ) : (
        <span class="text-xl font-bold tracking-wider text-white font-mono group-hover:text-amber-400 transition-colors">
          {siteConfig.logoText}
        </span>
      )}
      
      <!-- Studio Subtext Component -->
      <span class="hidden text-[10px] uppercase tracking-[0.3em] text-neutral-400 lg:inline">
        Picture &bull; Sound &bull; Story
      </span>
    </a>

    <!-- Hamburger Button (Mobile Toggle) -->
    <button 
      id="mobile-menu-toggle" 
      class="md:hidden p-2 rounded-md text-neutral-400 hover:text-white hover:bg-neutral-900 focus:outline-none transition-colors"
      aria-label="Toggle Navigation Menu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Navigation Links with Active Highlighting -->
    <nav 
      id="nav-links"
      class="hidden absolute top-[69px] left-0 right-0 bg-neutral-950/95 border-b border-neutral-800 p-6 flex flex-col gap-4 text-base tracking-wide md:static md:flex md:flex-row md:items-center md:gap-1 md:text-[13px] md:border-none md:p-0 md:bg-transparent" 
      aria-label="Primary"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-full px-4 py-2 transition-colors md:py-1.5",
              isActive(link.href)
                ? "bg-neutral-100 text-neutral-950 font-semibold"
                : "text-neutral-400 hover:text-neutral-100",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

  </div>
</header>

<!-- JavaScript Toggle Logic -->
<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const navLinks = document.getElementById('nav-links');

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
    navLinks?.classList.toggle('hidden');
  });
</script>
