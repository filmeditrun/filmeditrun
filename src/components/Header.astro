---
// 1. RESTORE YOUR LOGO CONFIG DATA FROM NAVBAR
import { siteConfig } from '../data/siteConfig';

// ==========================================
// ACTIVE PAGE DETECTION & LINKS
// ==========================================
const pathname = Astro.url.pathname;

const defaultLinks = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/work", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const links = siteConfig.navLinks && siteConfig.navLinks.length > 0
  ? siteConfig.navLinks
  : defaultLinks;

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
// ==========================================
---

<!-- Cinematic Studio Navbar Wrapper -->
<header class="fixed inset-x-0 top-0 z-50 h-20 border-b border-line bg-ink/80 backdrop-blur-2xl">
  <!-- 1. Pure CSS Checkbox Hack for Mobile Menu Toggle (Zero-JS) -->
  <input
    type="checkbox"
    id="mobile-nav-toggle"
    class="peer/nav sr-only"
    aria-hidden="true"
    autocomplete="off"
  />

  <div class="mx-auto flex h-full max-w-7xl items-center justify-between px-6">
    
    <!-- 2. Dynamic Logo Switcher -->
    <a href="/" class="flex items-center gap-3 group">
      {siteConfig.useImageLogo ? (
        <img 
          src={siteConfig.logoImagePath} 
          alt={siteConfig.siteName} 
          loading="eager"
          decoding="async"
          class="h-8 w-auto object-contain group-hover:opacity-90 transition-opacity" 
        />
      ) : (
        <span class="text-xl font-bold tracking-tight text-white font-sans group-hover:text-amber-400 transition-colors">
          {siteConfig.logoText}
        </span>
      )}
    </a>

    <!-- 3. Accessible Label Button (Acts as Toggle for #mobile-nav-toggle) -->
    <label
      for="mobile-nav-toggle"
      class="group md:hidden relative p-2.5 rounded-lg text-neutral-400 hover:text-white hover:bg-white/5 active:scale-95 transition-all cursor-pointer touch-manipulation select-none"
      aria-label="Toggle Navigation Menu"
    >
      <!-- Hamburger Icon (Visible by default, hidden when checked) -->
      <svg
        class="h-6 w-6 block nav-hamburger-icon transition-transform duration-200 group-hover:scale-105"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>

      <!-- Close (X) Icon (Hidden by default, shown when checked) -->
      <svg
        class="h-6 w-6 hidden nav-close-icon transition-transform duration-200 group-hover:rotate-90 text-amber-400"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </label>

    <!-- 4. Navigation Links: Hidden by default on mobile, revealed when #mobile-nav-toggle is checked -->
    <nav 
      id="nav-links"
      class="hidden absolute top-full left-0 right-0 bg-ink/95 backdrop-blur-2xl border-b border-line p-6 flex-col gap-1.5 text-base tracking-wide shadow-2xl overscroll-contain md:static md:flex md:flex-row md:items-center md:gap-2 md:text-[13px] md:border-none md:p-0 md:bg-transparent md:shadow-none transition-all duration-300 select-none" 
      aria-label="Primary"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "group relative flex items-center transition-all duration-200 [touch-action:manipulation]",
              // Mobile vertical drawer layout
              "px-4 py-3 rounded-r-lg border-l-2 active:scale-[0.99]",
              // Desktop horizontal layout
              "md:rounded-none md:border-l-0 md:px-3 md:py-2 md:active:scale-100",
              isActive(link.href)
                ? "border-amber-400 bg-white/[0.04] text-white font-medium"
                : "border-transparent text-neutral-400 hover:text-white hover:bg-white/[0.02] md:hover:bg-transparent",
            ]}
          >
            <span>{link.label}</span>
            <!-- Desktop animated gradient underline -->
            <span
              class:list={[
                "hidden md:block absolute bottom-0 left-3 right-3 h-[2px] rounded-full transition-transform duration-300 ease-out origin-left",
                "bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600",
                isActive(link.href)
                  ? "scale-x-100"
                  : "scale-x-0 group-hover:scale-x-100",
              ]}
              aria-hidden="true"
            />
          </a>
        ))
      }
    </nav>

  </div>
</header>

<style>
  header:has(#mobile-nav-toggle:checked) #nav-links {
    display: flex !important;
  }
  header:has(#mobile-nav-toggle:checked) .nav-hamburger-icon {
    display: none !important;
  }
  header:has(#mobile-nav-toggle:checked) .nav-close-icon {
    display: block !important;
  }
</style>
