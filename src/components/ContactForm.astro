<!-- Contact Form (Wired for Netlify Forms) -->
<form id="multi-step-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" onsubmit="handleFormSubmit(event)">
    <!-- Hidden input for Netlify bot protection -->
    <input type="hidden" name="form-name" value="contact" />
    <p class="hidden">
        <label>Don't fill this out if you're human: <input name="bot-field" /></label>
    </p>

    <!-- Step 1: Name & Email -->
    <div class="form-step active space-y-6" data-step="1">
        <div class="space-y-2">
            <span class="text-accentBlue text-sm font-bold tracking-widest uppercase">Step 01 / 04</span>
            <h3 class="text-2xl md:text-3xl font-bold">What is your name and email?</h3>
        </div>
        <div class="space-y-4 pt-4">
            <div>
                <label class="block text-sm font-medium text-mutedText mb-2">Your Name *</label>
                <input type="text" id="input-name" name="name" required placeholder="e.g. Alex Harrison" class="w-full bg-darkBg border border-white/10 rounded-xl px-4 py-3.5 text-white focus:outline-none focus:border-accentBlue">
            </div>
            <div>
                <label class="block text-sm font-medium text-mutedText mb-2">Email Address *</label>
                <input type="email" id="input-email" name="email" required placeholder="alex@company.com" class="w-full bg-darkBg border border-white/10 rounded-xl px-4 py-3.5 text-white focus:outline-none focus:border-accentBlue">
            </div>
        </div>
        <div class="flex justify-end pt-6">
            <button type="button" onclick="nextStep(2)" class="glow-button px-8 py-3.5 rounded-xl font-bold text-darkBg flex items-center gap-2">
                <span>Next Step</span> <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>
    </div>

    <!-- Step 2: Service Selection -->
    <div class="form-step hidden space-y-6" data-step="2">
        <div class="space-y-2">
            <span class="text-accentBlue text-sm font-bold tracking-widest uppercase">Step 02 / 04</span>
            <h3 class="text-2xl md:text-3xl font-bold">What service do you need?</h3>
        </div>
        <div class="pt-4 space-y-4">
            <label class="block text-sm font-medium text-mutedText mb-2">Selected Service *</label>
            <input type="text" id="input-service-selected" name="service" value="Commercial & Brand Filming" class="w-full bg-darkBg border border-accentBlue rounded-xl px-4 py-3.5 text-accentBlue font-bold focus:outline-none">
        </div>
        <div class="flex justify-between pt-6">
            <button type="button" onclick="prevStep(1)" class="glass-card px-6 py-3.5 rounded-xl font-bold text-white hover:bg-white/15">Back</button>
            <button type="button" onclick="nextStep(3)" class="glow-button px-8 py-3.5 rounded-xl font-bold text-darkBg">Next Step</button>
        </div>
    </div>

    <!-- Step 3: Project Brief -->
    <div class="form-step hidden space-y-6" data-step="3">
        <div class="space-y-2">
            <span class="text-accentBlue text-sm font-bold tracking-widest uppercase">Step 03 / 04</span>
            <h3 class="text-2xl md:text-3xl font-bold">Tell us about your project brief</h3>
        </div>
        <div class="pt-4">
            <textarea id="input-brief" name="brief" rows="5" required placeholder="Describe your vision, goals, and timeline..." class="w-full bg-darkBg border border-white/10 rounded-xl p-4 text-white focus:outline-none focus:border-accentBlue resize-none"></textarea>
        </div>
        <div class="flex justify-between pt-6">
            <button type="button" onclick="prevStep(2)" class="glass-card px-6 py-3.5 rounded-xl font-bold text-white">Back</button>
            <button type="button" onclick="nextStep(4)" class="glow-button px-8 py-3.5 rounded-xl font-bold text-darkBg">Next Step</button>
        </div>
    </div>

    <!-- Step 4: Review & GDPR Consent -->
    <div class="form-step hidden space-y-6" data-step="4">
        <div class="space-y-2">
            <span class="text-accentBlue text-sm font-bold tracking-widest uppercase">Step 04 / 04</span>
            <h3 class="text-2xl md:text-3xl font-bold">Final Review & Consent</h3>
        </div>
        <div class="pt-4 space-y-6">
            <div class="glass-card p-4 rounded-xl space-y-2 text-sm text-mutedText">
                <div class="flex justify-between"><strong class="text-white">Name:</strong> <span id="review-name">-</span></div>
                <div class="flex justify-between"><strong class="text-white">Email:</strong> <span id="review-email">-</span></div>
                <div class="flex justify-between"><strong class="text-white">Service:</strong> <span id="review-service">-</span></div>
            </div>
            <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" id="input-gdpr" name="gdpr" required class="mt-1 w-5 h-5 accent-accentBlue rounded bg-darkBg border-white/10">
                <span class="text-sm text-mutedText">I consent to storing my data in accordance with GDPR and privacy guidelines. *</span>
            </label>
        </div>
        <div class="flex justify-between pt-6">
            <button type="button" onclick="prevStep(3)" class="glass-card px-6 py-3.5 rounded-xl font-bold text-white">Back</button>
            <button type="submit" class="glow-button px-8 py-3.5 rounded-xl font-bold text-darkBg">Submit Brief</button>
        </div>
    </div>
</form>

<!-- Success Message Container -->
<div id="form-success" class="hidden text-center py-12 space-y-6">
    <div class="w-20 h-20 bg-accentBlue/20 text-accentBlue rounded-full flex items-center justify-center text-4xl mx-auto border border-accentBlue">
        <i class="fa-solid fa-check"></i>
    </div>
    <h3 class="text-3xl font-extrabold uppercase">Brief Received Successfully!</h3>
    <p class="text-mutedText">Thank you! Our cinematic team will review your project and get back to you within 24 hours.</p>
    <button onclick="resetContactForm()" class="glow-button px-8 py-3 rounded-xl font-bold text-darkBg">Send Another Brief</button>
</div>