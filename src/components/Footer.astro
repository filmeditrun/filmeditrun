---
import { siteConfig } from '../data/siteConfig';

interface ServiceEntry {
  order: string;
  title: string;
  link?: string;
  slug?: string;
}

// Dynamically import all services from TinaCMS collection
const serviceFiles = import.meta.glob<ServiceEntry>('../content/services/*.json', {
  eager: true,
  import: 'default',
});

const services = Object.values(serviceFiles)
  .sort((a, b) => a.order.localeCompare(b.order, undefined, { numeric: true }))
  .map((s) => ({
    title: s.title,
    href: s.link || `/services/${s.slug}`,
  }));

const navLinks = [
  { label: "Home", href: "/" },
  { label: "Services Overview", href: "/services" },
  { label: "Work Archive", href: "/work" },
  { label: "Contact", href: "/contact" }
];
---

<footer class="bg-neutral-950 border-t border-neutral-900 text-neutral-400 py-16 px-6">
  <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10 sm:gap-12">
    
    <!-- Brand Column -->
    <div class="sm:col-span-2">
      <a href="/" class="block mb-4 group">
        {siteConfig.useImageLogo ? (
          <img src={siteConfig.logoImagePath} alt={siteConfig.siteName} class="h-6 w-auto object-contain" />
        ) : (
          <span class="text-xl font-bold tracking-wider text-white font-mono group-hover:text-amber-400 transition-colors">
            {siteConfig.logoText}
          </span>
        )}
      </a>
      <p class="text-sm text-neutral-400 max-w-sm leading-relaxed mb-6 font-light">
        Professional single and multi-camera event filming, corporate video production, and high-end editing workflows.
      </p>
      <p class="text-xs font-mono text-neutral-600">
        &copy; {new Date().getFullYear()} {siteConfig.siteName}. All rights reserved.
      </p>
    </div>

    <!-- Navigation Column -->
    <div>
      <h4 class="text-white font-mono text-xs uppercase tracking-widest mb-4">Navigation</h4>
      <ul class="space-y-3 text-sm">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="hover:text-amber-500 transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Services Column (SEO Internal Links) -->
    <div>
      <h4 class="text-white font-mono text-xs uppercase tracking-widest mb-4">Services</h4>
      <ul class="space-y-3 text-sm">
        {services.map((service) => (
          <li>
            <a href={service.href} class="hover:text-amber-500 transition-colors">
              {service.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Location Column (SEO Internal Links) -->
    <div>
      <h4 class="text-white font-mono text-xs uppercase tracking-widest mb-4">Location</h4>
      <ul class="space-y-3 text-sm">
        <li>
          <a href="/cambridge" class="hover:text-amber-500 transition-colors flex items-center gap-1.5">
            Cambridge <span class="text-xs text-amber-500 font-mono">📍</span>
          </a>
        </li>
      </ul>
    </div>

  </div>
</footer>

