---
import { siteConfig } from '../data/siteConfig';
import footerData from '../content/settings/footer.json';

interface ServiceEntry {
  order: string;
  title: string;
  link?: string;
  slug?: string;
}

// Dynamically import all services from TinaCMS collection
const serviceFiles = import.meta.glob<ServiceEntry>('../content/services/*.json', {
  eager: true,
  import: 'default',
});

const services = Object.values(serviceFiles)
  .sort((a, b) => a.order.localeCompare(b.order, undefined, { numeric: true }))
  .map((s) => ({
    title: s.title,
    href: s.link || `/services/${s.slug}`,
  }));

const defaultStudioLinks = [
  { label: "Selected Work", href: "/work" },
  { label: "Services Directory", href: "/services" },
  { label: "Studio Manifesto", href: "/about" },
  { label: "Production Archive", href: "/work#archive" },
  { label: "Start a Project Brief", href: "/contact" },
];

const defaultFooter = {
  studioTagline: "Independent video production studio and post-house. On-location filming and commercial editorial across Cambridge, London, and nationwide.",
  commissionButtonLabel: "Commission a Production",
  commissionButtonLink: "/contact",
  capabilitiesHeading: "Services",
  servicesLinkLabel: "All Services →",
  servicesLinkUrl: "/services",
  studioHeading: "Studio",
  studioLinks: defaultStudioLinks,
  presenceHeading: "Locations",
  cambridgeTitle: "Cambridge Studio",
  cambridgeSubtitle: "Silicon Fen & Cambridge Science Parks",
  cambridgeLink: "/cambridge",
  londonTitle: "London Base",
  londonSubtitle: "Corporate HQs, Summit Stages & Central Venues",
  londonLink: "/london",
  worldwideTitle: "UK-Wide Deployments",
  worldwideSubtitle: "On-location field production nationwide",
  directHeading: "Direct",
  inquiriesLabel: "Project Intake",
  inquiriesActionText: "Start a Project Brief →",
  inquiriesActionLink: "/contact",
  productionHubLabel: "Production Hubs",
  productionHub: "Cambridge • London, UK",
  studioStatusLabel: "Studio Status",
  studioStatus: "Accepting Commissions",
  copyrightTagline: "Picture, sound, and story.",
  backToTopLabel: "Back to top",
};

const footer = Object.assign({}, defaultFooter, footerData);

const navigationLinks = footer.studioLinks && footer.studioLinks.length > 0
  ? footer.studioLinks
  : defaultStudioLinks;
---

<footer data-cinema-darkroom="true" class="bg-neutral-950 border-t border-neutral-900 text-neutral-400 pt-16 pb-12 px-6">
  <div class="max-w-7xl mx-auto space-y-12">
    
    <!-- ============================================================== -->
    <!-- 1. TOP TIER: BRAND IDENTITY & DIRECT COMMISSION ACTION         -->
    <!-- ============================================================== -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 pb-10 border-b border-white/10">
      
      <!-- Brand Logo & Scope Statement -->
      <div class="space-y-3 max-w-xl">
        <a href="/" class="block group">
          {siteConfig.useImageLogo ? (
            <img src={siteConfig.logoImagePath} alt={siteConfig.siteName} loading="lazy" decoding="async" class="h-7 w-auto object-contain" />
          ) : (
            <span class="text-2xl sm:text-3xl font-black tracking-tight text-white font-sans group-hover:text-amber-400 transition-colors">
              {siteConfig.logoText}
            </span>
          )}
        </a>
        <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-light">
          {footer.studioTagline}
        </p>
      </div>

      <!-- Top Actions: Status Badge & Commission Button -->
      <div class="shrink-0 flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <!-- Live Studio Status Indicator -->
        <div class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-lg bg-white/[0.03] border border-white/10 text-xs font-mono text-neutral-300">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
          </span>
          <span class="text-neutral-400">{footer.studioStatusLabel || "Studio Status"}:</span>
          <span class="text-emerald-400 font-medium">{footer.studioStatus || "Accepting Commissions"}</span>
        </div>

        <!-- Commission a Production Button -->
        <a 
          href={footer.commissionButtonLink || "/contact"} 
          class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-lg bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold text-xs uppercase tracking-wider transition-all duration-200 group shadow-lg shadow-amber-500/10 hover:scale-[1.02]"
        >
          <span>{footer.commissionButtonLabel}</span>
          <span class="group-hover:translate-x-1 transition-transform font-bold">&rarr;</span>
        </a>
      </div>

    </div>

    <!-- ============================================================== -->
    <!-- 2. MIDDLE TIER: 4 BALANCED ARCHITECTURAL COLUMNS               -->
    <!-- ============================================================== -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 pb-4">
      
      <!-- Column 1: CAPABILITIES (Dynamically grows as TinaCMS adds services) -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <h4 class="text-white font-mono text-xs uppercase tracking-widest font-semibold">
            {footer.capabilitiesHeading}
          </h4>
        </div>
        <ul class="space-y-2.5 text-sm font-light">
          {services.map((service) => (
            <li>
              <a href={service.href} class="text-neutral-300 hover:text-amber-400 transition-colors block">
                {service.title}
              </a>
            </li>
          ))}
        </ul>
        <div class="pt-1">
          <a href={footer.servicesLinkUrl || "/services"} class="group inline-flex items-center gap-1.5 text-xs font-mono text-amber-500 hover:text-amber-400 tracking-wider transition-colors">
            <span>{footer.servicesLinkLabel ? footer.servicesLinkLabel.replace(/[→➔]/g, '').trim() : "All Services & Specs"}</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Column 2: STUDIO NAVIGATION -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-white/30"></span>
          <h4 class="text-white font-mono text-xs uppercase tracking-widest font-semibold">
            {footer.studioHeading}
          </h4>
        </div>
        <ul class="space-y-2.5 text-sm font-light">
          {navigationLinks.map((link) => (
            <li>
              <a href={link.href} class="text-neutral-300 hover:text-amber-400 transition-colors block">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: LOCATIONS & PRESENCE -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-white/30"></span>
          <h4 class="text-white font-mono text-xs uppercase tracking-widest font-semibold">
            {footer.presenceHeading}
          </h4>
        </div>
        <ul class="space-y-3.5 text-sm font-light">
          <li>
            <a href={footer.cambridgeLink || "/cambridge"} class="hover:text-amber-400 transition-colors block group">
              <span class="font-medium text-white group-hover:text-amber-400 block transition-colors">
                {footer.cambridgeTitle || "Cambridge Studio"}
              </span>
              <span class="text-xs text-neutral-500 block">
                {footer.cambridgeSubtitle}
              </span>
            </a>
          </li>
          <li>
            <a href={(footer as any).londonLink || "/london"} class="hover:text-amber-400 transition-colors block group">
              <span class="font-medium text-white group-hover:text-amber-400 block transition-colors">
                {footer.londonTitle || "London Base"}
              </span>
              <span class="text-xs text-neutral-500 block">
                {footer.londonSubtitle}
              </span>
            </a>
          </li>
          <li>
            <div class="block">
              <span class="font-medium text-neutral-300 block">
                {footer.worldwideTitle || "UK-Wide Deployments"}
              </span>
              <span class="text-xs text-neutral-500 block">
                {footer.worldwideSubtitle}
              </span>
            </div>
          </li>
        </ul>
      </div>

      <!-- Column 4: DIRECT PROJECT INTAKE & HUBS -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <h4 class="text-white font-mono text-xs uppercase tracking-widest font-semibold">
            {footer.directHeading || "Direct"}
          </h4>
        </div>
        <div class="space-y-3.5 text-xs font-mono">
          <div>
            <span class="text-neutral-400 block uppercase tracking-wider mb-1">
              {footer.inquiriesLabel || "Project Intake"}
            </span>
            <a 
              href={footer.inquiriesActionLink || "/contact"} 
              class="group inline-flex items-center gap-1.5 text-neutral-200 hover:text-amber-400 transition-colors text-sm font-sans font-medium"
            >
              <span>{footer.inquiriesActionText ? footer.inquiriesActionText.replace(/[→➔]/g, '').trim() : "Start a Project Brief"}</span>
              <span class="text-amber-400 group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>
          <div>
            <span class="text-neutral-400 block uppercase tracking-wider mb-1">
              {footer.productionHubLabel || "Production Hubs"}
            </span>
            <span class="text-neutral-300 block">{footer.productionHub || "Cambridge • London, UK"}</span>
          </div>
          <div>
            <span class="text-neutral-400 block uppercase tracking-wider mb-1">
              Field Coverage
            </span>
            <span class="text-neutral-300 block">On-location shoots UK-wide</span>
          </div>
          <div>
            <span class="text-neutral-400 block uppercase tracking-wider mb-1">
              Response Time
            </span>
            <span class="text-emerald-400 block">Direct response within 24 hours</span>
          </div>
        </div>
      </div>

    </div>

    <!-- ============================================================== -->
    <!-- 2.5 CITATION & BACKLINK PROFILES STRIP (LOCAL SEO & ENTITY REPUTATION) -->
    <!-- ============================================================== -->
    {siteConfig.backlinkProfiles && siteConfig.backlinkProfiles.filter(p => p.showInFooter !== false).length > 0 && (
      <div class="border-t border-neutral-900/80 pt-8 pb-2 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs font-mono">
        <div class="flex items-center gap-2 text-neutral-400">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <span class="uppercase tracking-widest text-[11px] font-semibold text-neutral-300">Verified Profiles & Citations:</span>
        </div>
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          {siteConfig.backlinkProfiles.filter(p => p.showInFooter !== false).map((profile) => (
            <a
              href={profile.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/[0.04] border border-white/10 hover:border-amber-500/40 hover:bg-white/[0.08] hover:text-white text-neutral-300 transition-all duration-200 group text-xs font-mono"
            >
              <span>{profile.name}</span>
              {profile.badgeText && (
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-amber-400 group-hover:border-amber-500/30">
                  {profile.badgeText}
                </span>
              )}
              <span class="text-neutral-500 group-hover:text-amber-400 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 text-[10px] leading-none">
                ↗
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- ============================================================== -->
    <!-- 3. BOTTOM TIER: COLOPHON & BACK TO TOP                         -->
    <!-- ============================================================== -->
    <div class="border-t border-neutral-900 pt-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs font-mono text-neutral-400">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <p>
          &copy; {new Date().getFullYear()} {siteConfig.legalName || siteConfig.siteName}. {footer.copyrightTagline} All rights reserved.
        </p>
        {siteConfig.addressLocality && (
          <span class="hidden sm:inline text-neutral-400">
            {siteConfig.addressLocality}, {siteConfig.addressRegion || siteConfig.addressCountry}
          </span>
        )}
        <span class="hidden sm:inline text-neutral-700">•</span>
        <a href="/privacy" class="hover:text-amber-400 transition-colors">
          Privacy & Cookie Policy
        </a>
      </div>
      <a href="#top" class="hover:text-amber-400 transition-colors flex items-center gap-1.5 shrink-0">
        <span>{footer.backToTopLabel || "Back to top"}</span>
        <span>&uarr;</span>
      </a>
    </div>

  </div>
</footer>
