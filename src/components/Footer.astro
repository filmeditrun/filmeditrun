---
import { siteConfig } from '../data/siteConfig';

const navLinks = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Work", href: "/work" },
  { label: "Contact", href: "/contact" }
];
---

<footer class="bg-neutral-950 border-t border-neutral-900 text-neutral-400 py-16 px-6">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12">
    
    <!-- Brand Column -->
    <div class="md:col-span-2">
      <a href="/" class="block mb-4 group">
        {siteConfig.useImageLogo ? (
          <img src={siteConfig.logoImagePath} alt={siteConfig.siteName} class="h-6 w-auto object-contain" />
        ) : (
          /* FIX: Updated typography spacing to perfectly mirror your new responsive header style */
          <span class="text-xl font-bold tracking-wider text-white font-mono group-hover:text-amber-400 transition-colors">
            {siteConfig.logoText}
          </span>
        )}
      </a>
      <p class="text-sm text-neutral-400 max-w-sm leading-relaxed mb-6">
        Professional single and multi-camera event filming, corporate video production, and high-end editing workflows.
      </p>
      <p class="text-xs font-mono text-neutral-600">
        &copy; {new Date().getFullYear()} {siteConfig.siteName}. All rights reserved.
      </p>
    </div>

    <!-- Quick Links Column -->
    <div>
      <h4 class="text-white font-mono text-xs uppercase tracking-widest mb-4">Navigation</h4>
      <ul class="space-y-3 text-sm">
        {navLinks.map((link) => (
          <li><a href={link.href} class="hover:text-amber-500 transition-colors">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Service Areas Column (SEO Internal Links) -->
    <div>
      <h4 class="text-white font-mono text-xs uppercase tracking-widest mb-4">Service Areas</h4>
      <ul class="space-y-3 text-sm">
        <li><a href="/cambridge" class="hover:text-amber-500 transition-colors flex items-center gap-1.5">Cambridge <span class="text-xs text-amber-500 font-mono">📍</span></a></li>
        <!-- You can easily add more cities here later (e.g. London, Norwich, etc.) -->
      </ul>
    </div>

  </div>
</footer>
