---
import { parseHeroHeading as parseHeading } from '../../utils/headingParser';

interface Props {
  tag?: string;
  heading?: string;
  body?: string;
  primaryLinkLabel?: string;
  primaryLinkHref?: string;
  secondaryLinkLabel?: string;
  secondaryLinkHref?: string;
}

const {
  tag = "OUR APPROACH",
  heading = "Calm leadership. *Direct collaboration.*",
  body = "With FilmEditRun, we listen to your brief, direct the narrative, and cut the story. Direct communication, honest guidance, and zero translation loss.",
  primaryLinkLabel = "Explore Work →",
  primaryLinkHref = "/work",
  secondaryLinkLabel = "Explore Services →",
  secondaryLinkHref = "/services",
} = Astro.props;
---

<!-- Subtle Fading Cinema Top Divider -->
<div class="h-[1px] w-full max-w-5xl mx-auto bg-gradient-to-r from-transparent via-amber-500/20 to-transparent" aria-hidden="true"></div>

<!-- Breathable Centered Editorial Breather (Cardless UI Pattern) -->
<section class="max-w-4xl mx-auto px-6 py-20 sm:py-28 text-center select-none">
  {tag && (
    <div class="inline-flex items-center gap-2 mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
      <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
        {tag}
      </span>
    </div>
  )}

  <h2 
    class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white mb-6 leading-tight select-text" 
    set:html={parseHeading(heading)} 
  />

  <p class="text-neutral-400 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed mb-10 font-light select-text">
    {body}
  </p>

  <div class="flex flex-wrap justify-center items-center gap-6 sm:gap-8 font-mono text-xs uppercase tracking-widest">
    {primaryLinkLabel && primaryLinkHref && (
      <a 
        href={primaryLinkHref} 
        class="text-amber-500 hover:text-amber-400 transition-colors inline-flex items-center gap-1.5 font-bold"
      >
        <span>{primaryLinkLabel}</span>
      </a>
    )}
    {secondaryLinkLabel && secondaryLinkHref && (
      <a 
        href={secondaryLinkHref} 
        class="text-neutral-400 hover:text-white transition-colors inline-flex items-center gap-1.5"
      >
        <span>{secondaryLinkLabel}</span>
      </a>
    )}
  </div>
</section>

<!-- Subtle Fading Cinema Bottom Divider -->
<div class="h-[1px] w-full max-w-5xl mx-auto bg-gradient-to-r from-transparent via-line to-transparent" aria-hidden="true"></div>

