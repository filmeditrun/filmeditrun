---
import CtaSection from '../CtaSection.astro';

interface Props {
  ctaTag?: string;
  ctaHeading: string;
  ctaText: string;
  ctaButtonLabel: string;
  ctaButtonLink: string;
  ctaSecondaryButtonLabel?: string;
  ctaSecondaryButtonLink?: string;
  ctaTrustSignals?: string[];
}

const {
  ctaTag,
  ctaHeading,
  ctaText,
  ctaButtonLabel,
  ctaButtonLink,
  ctaSecondaryButtonLabel,
  ctaSecondaryButtonLink,
  ctaTrustSignals = [
    "Direct Filmmaker Access",
    "Clear, Transparent Scope",
    "Cambridge & London Studio Hubs"
  ],
} = Astro.props;
---

<CtaSection
  tag={ctaTag}
  heading={ctaHeading}
  description={ctaText}
  primaryButtonLabel={ctaButtonLabel}
  primaryButtonLink={ctaButtonLink}
  secondaryButtonLabel={ctaSecondaryButtonLabel}
  secondaryButtonLink={ctaSecondaryButtonLink}
  trustSignals={ctaTrustSignals}
/>
