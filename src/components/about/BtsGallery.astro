---
interface BtsItem {
  title: string;
  category: string;
  image?: string;
  caption?: string;
  aspectRatio?: string;
}

interface Props {
  btsHeading: string;
  btsTag?: string;
  btsDescription?: string;
  btsItems: BtsItem[];
}

const {
  btsHeading,
  btsTag = "BEHIND THE SCENES",
  btsDescription,
  btsItems = [],
} = Astro.props;
---

<section class="py-20 md:py-32 border-b border-neutral-900 bg-neutral-950/60" id="bts-gallery">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Clean Section Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      {btsTag && (
        <span class="text-xs uppercase tracking-[0.25em] text-amber-500 font-mono font-bold block mb-3">
          {btsTag}
        </span>
      )}
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-4">
        {btsHeading}
      </h2>
      {btsDescription && (
        <p class="text-neutral-400 text-base sm:text-lg leading-relaxed font-light">
          {btsDescription}
        </p>
      )}
    </div>

    <!-- Clean, Photo-First Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {btsItems.map((item, index) => (
        <a
          href={`#bts-preview-${index}`}
          class="bts-card group relative block w-full text-left rounded-2xl border border-neutral-800 bg-neutral-900/40 overflow-hidden hover:border-amber-500/40 hover:shadow-2xl hover:shadow-amber-500/5 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
          aria-label={`Preview behind the scenes image: ${item.title}`}
        >
          <!-- Media Frame -->
          <div class="relative w-full aspect-16/10 overflow-hidden bg-neutral-950 select-none">
            <img
              src={item.image || "/og-image.jpg"}
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
              decoding="async"
            />
            
            <!-- Category Tag Pill (Top Left) -->
            <div class="absolute top-4 left-4 z-10">
              <span class="hud-pill px-3 py-1 rounded-full text-[11px] font-mono tracking-wider uppercase text-neutral-300 group-hover:text-amber-500 transition-colors font-medium">
                {item.category}
              </span>
            </div>

            <!-- Inspect Icon (Top Right on Hover) -->
            <div class="absolute top-4 right-4 z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <span class="hud-pill w-8 h-8 rounded-full flex items-center justify-center text-white text-xs shadow-lg">
                &nearr;
              </span>
            </div>
          </div>

          <!-- Clean Minimal Title Bar -->
          <div class="p-5 sm:p-6 border-t border-neutral-800/80 bg-neutral-950/80 flex items-center justify-between gap-4">
            <h3 class="text-base sm:text-lg font-bold text-white tracking-tight group-hover:text-amber-500 transition-colors">
              {item.title}
            </h3>
            <span class="text-xs font-mono text-neutral-500 tracking-wider shrink-0 font-medium">
              0{index + 1}
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<!-- =========================================================================
     ZERO-JS LIGHTBOX OVERLAYS VIA CSS :target (100% NATIVE, ZERO CLIENT JAVASCRIPT)
     ========================================================================= -->
{btsItems.map((item, index) => (
  <aside
    id={`bts-preview-${index}`}
    class="bts-lightbox-modal fixed inset-0 z-[100] bg-neutral-950/95 backdrop-blur-2xl flex items-center justify-center p-4 sm:p-8 select-none"
    role="dialog"
    aria-modal="true"
    aria-label={`${item.title} image preview`}
  >
    <!-- Background Backdrop click-to-close link -->
    <a
      href="#bts-gallery"
      class="absolute inset-0 z-0 bg-transparent cursor-default"
      aria-label="Close image preview"
      tabindex="-1"
    ></a>

    <div class="relative z-10 max-w-5xl w-full bg-neutral-900 border border-neutral-800 rounded-2xl overflow-hidden shadow-2xl flex flex-col animate-theater-in">
      <!-- Modal Top Bar -->
      <div class="px-6 py-4 border-b border-neutral-800 bg-neutral-950 flex items-center justify-between text-xs font-mono">
        <div class="flex items-center gap-3">
          <span class="px-2.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/30 uppercase tracking-wider text-[11px]">
            {item.category}
          </span>
          <span class="text-neutral-500 tracking-wider">
            0{index + 1} // 0{btsItems.length}
          </span>
        </div>

        <!-- Close Button (Direct link back to section anchor) -->
        <a
          href="#bts-gallery"
          class="text-neutral-400 hover:text-white px-3 py-1 rounded bg-neutral-800 hover:bg-neutral-700 transition-colors tracking-widest text-[11px] uppercase font-mono cursor-pointer flex items-center gap-1.5"
          aria-label="Close Preview"
        >
          <span>✕</span> CLOSE
        </a>
      </div>

      <!-- Modal Image Container -->
      <div class="relative bg-black flex items-center justify-center max-h-[70vh] overflow-hidden">
        <img
          src={item.image || "/og-image.jpg"}
          alt={item.title}
          class="w-full h-full max-h-[70vh] object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Modal Caption Bottom Bar -->
      <div class="p-6 bg-neutral-950 border-t border-neutral-800">
        <h4 class="text-xl font-bold text-white mb-1">
          {item.title}
        </h4>
        {item.caption && (
          <p class="text-sm text-neutral-400 font-light leading-relaxed">
            {item.caption}
          </p>
        )}
      </div>
    </div>
  </aside>
))}

<style is:global>
  /* Zero-JS Lightbox: Hidden by default, displayed smoothly when URL matches #bts-preview-* */
  .bts-lightbox-modal {
    display: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms ease;
  }

  .bts-lightbox-modal:target {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }
</style>
