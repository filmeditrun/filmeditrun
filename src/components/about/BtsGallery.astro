---
interface BtsItem {
  title: string;
  category: string;
  image?: string;
  caption?: string;
  aspectRatio?: string;
}

interface Props {
  btsHeading: string;
  btsTag?: string;
  btsDescription?: string;
  btsItems: BtsItem[];
}

const {
  btsHeading,
  btsTag = "BEHIND THE SCENES",
  btsDescription,
  btsItems = [],
} = Astro.props;

// Asterisk gradient heading parser
const parseHeading = (text: string) => {
  if (!text) return "";
  if (text.includes('*')) {
    return text.replace(/\*(.*?)\*/g, '<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600">$1</span>');
  }
  return text;
};
---

<section class="max-w-7xl mx-auto px-6 py-20 sm:py-28 border-t border-line" id="bts-gallery">
  
  <!-- Standardized Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-14 border-b border-line pb-8">
    <div>
      {btsTag && (
        <div class="flex items-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
            {btsTag}
          </span>
        </div>
      )}
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight" set:html={parseHeading(btsHeading)} />
      {btsDescription && (
        <p class="text-neutral-400 text-sm sm:text-base max-w-xl mt-3 font-light leading-relaxed">
          {btsDescription}
        </p>
      )}
    </div>
  </div>

  <!-- Photo-First Cinema Figures Grid (Clean Full Photo at Rest, Title Revealed on Hover) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
    {btsItems.map((item, index) => (
      <a
        href={`#bts-preview-${index}`}
        data-cinema-darkroom="true"
        class="group relative block aspect-[16/10] sm:aspect-16/9 rounded-2xl overflow-hidden bg-black border border-white/10 shadow-2xl transition-all duration-300 hover:border-amber-500/60 cursor-pointer focus:outline-none"
        aria-label={`Preview behind the scenes image: ${item.title}`}
      >
        <!-- Photo with smooth hover zoom (Full clarity at rest) -->
        <img
          src={item.image || "/og-image.jpg"}
          alt={item.title}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />

        <!-- Smooth darkening scrim on hover / tap only -->
        <div 
          class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-400 ease-out"
          aria-hidden="true"
        ></div>

        <!-- Title only: Revealed on hover / tap (Matching Our Team visual DNA) -->
        <figcaption class="absolute inset-x-0 bottom-0 p-6 sm:p-8 pointer-events-none z-10">
          <div class="transform translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-400 ease-out">
            {item.category && (
              <span class="text-xs uppercase tracking-widest font-mono text-amber-500 font-semibold mb-1 block">
                {item.category}
              </span>
            )}
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-black text-white keep-white tracking-tight leading-snug drop-shadow-lg">
              {item.title}
            </h3>
          </div>
        </figcaption>
      </a>
    ))}
  </div>

</section>

<!-- =========================================================================
     ZERO-JS LIGHTBOX OVERLAYS VIA CSS :target (100% NATIVE, ZERO CLIENT JAVASCRIPT)
     ========================================================================= -->
{btsItems.map((item, index) => (
  <aside
    id={`bts-preview-${index}`}
    class="bts-lightbox-modal fixed inset-0 z-[100] bg-neutral-950/95 backdrop-blur-2xl flex items-center justify-center p-4 sm:p-8 select-none"
    role="dialog"
    aria-modal="true"
    aria-label={`${item.title} image preview`}
  >
    <!-- Background Backdrop click-to-close link -->
    <a
      href="#bts-gallery"
      class="absolute inset-0 z-0 bg-transparent cursor-default"
      aria-label="Close image preview"
      tabindex="-1"
    ></a>

    <div class="relative z-10 max-w-5xl w-full bg-neutral-900 border border-white/10 rounded-2xl overflow-hidden shadow-2xl flex flex-col animate-theater-in">
      <!-- Modal Top Bar -->
      <div class="px-6 py-4 border-b border-neutral-800 bg-neutral-950 flex items-center justify-between text-xs font-mono">
        <div class="flex items-center gap-3">
          <span class="px-2.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/30 uppercase tracking-wider text-[11px]">
            {item.category}
          </span>
          <span class="text-neutral-500 tracking-wider">
            0{index + 1} // 0{btsItems.length}
          </span>
        </div>

        <!-- Close Button (Direct link back to section anchor) -->
        <a
          href="#bts-gallery"
          class="text-neutral-400 hover:text-white px-3 py-1 rounded bg-neutral-800 hover:bg-neutral-700 transition-colors tracking-widest text-[11px] uppercase font-mono cursor-pointer flex items-center gap-1.5"
          aria-label="Close Preview"
        >
          <span>✕</span> CLOSE
        </a>
      </div>

      <!-- Modal Image Container -->
      <div class="relative bg-black flex items-center justify-center max-h-[70vh] overflow-hidden">
        <img
          src={item.image || "/og-image.jpg"}
          alt={item.title}
          class="w-full h-full max-h-[70vh] object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Modal Caption Bottom Bar -->
      <div class="p-6 bg-neutral-950 border-t border-neutral-800">
        <h4 class="text-xl font-bold text-white mb-1">
          {item.title}
        </h4>
        {item.caption && (
          <p class="text-sm text-neutral-400 font-light leading-relaxed">
            {item.caption}
          </p>
        )}
      </div>
    </div>
  </aside>
))}

<style is:global>
  /* Zero-JS Lightbox: Hidden by default, displayed smoothly when URL matches #bts-preview-* */
  .bts-lightbox-modal {
    display: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms ease;
  }

  .bts-lightbox-modal:target {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }
</style>
