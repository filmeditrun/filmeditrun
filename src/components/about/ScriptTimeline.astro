---
interface Milestone {
  year: string;
  title: string;
  description: string;
  draftLabel?: string;
  takeNumber?: string;
  badge?: string;
}

interface Props {
  timelineHeading: string;
  timelineTag?: string;
  timelineDescription?: string;
  milestones: Milestone[];
}

const {
  timelineHeading,
  timelineTag = "STUDIO TIMELINE",
  timelineDescription,
  milestones = [],
} = Astro.props;

// Asterisk animated accent underline heading parser
const parseHeading = (text: string) => {
  if (!text) return "";
  if (text.includes('*')) {
    return text.replace(/\*(.*?)\*/g, '<span class="animated-accent-underline">$1</span>');
  }
  return text;
};
---

<section class="max-w-7xl mx-auto px-6 py-16 sm:py-24 border-t border-line" id="timeline-section">
  
  <!-- Centered Section Header -->
  <div class="mb-12 sm:mb-16 border-b border-line pb-8 text-center max-w-3xl mx-auto">
    {timelineTag && (
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
          {timelineTag}
        </span>
      </div>
    )}
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight" set:html={parseHeading(timelineHeading)} />
    {timelineDescription && (
      <p class="text-neutral-400 text-sm sm:text-base max-w-2xl mt-3 font-light leading-relaxed mx-auto">
        {timelineDescription}
      </p>
    )}
  </div>

  <!-- Studio Evolution Spine & Cards -->
  <div class="relative max-w-3xl mx-auto pt-2">
    
    <!-- Central/Left Spine Track -->
    <div class="absolute left-4 sm:left-6 top-3 bottom-6 w-px bg-gradient-to-b from-amber-500 via-line to-transparent" aria-hidden="true"></div>

    <!-- Timeline Items -->
    <div class="space-y-3.5 sm:space-y-4">
      {milestones.map((item, idx) => (
        <div class="relative pl-10 sm:pl-16 group">
          
          <!-- Timeline Node -->
          <div class="absolute left-4 sm:left-6 top-6 sm:top-6 -translate-x-1/2 w-3.5 h-3.5 rounded-full border-2 border-line bg-neutral-950 group-hover:border-amber-400 group-hover:bg-amber-400/20 transition-all duration-300 flex items-center justify-center shadow-md">
            <span class="w-1 h-1 rounded-full bg-neutral-600 group-hover:bg-amber-400 transition-colors"></span>
          </div>

          <!-- Milestone Compact Architectural Card -->
          <div class="py-4 px-5 sm:py-4.5 sm:px-6 rounded-xl border border-neutral-800/80 bg-neutral-950/70 hover:bg-neutral-950/95 hover:border-amber-500/50 transition-all duration-300 shadow-lg hover:shadow-xl hover:shadow-amber-500/10 hover:-translate-y-0.5 backdrop-blur-sm">
            
            <!-- Horizontal Year & Title Row -->
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1.5">
              <span class="text-base sm:text-lg font-black text-amber-400 font-mono tracking-tight group-hover:text-amber-300 transition-colors">
                {item.year}
              </span>
              <span class="text-neutral-600 text-xs font-mono select-none" aria-hidden="true">&bull;</span>
              <h3 class="text-base sm:text-lg font-bold text-white tracking-tight group-hover:text-amber-400 transition-colors leading-snug">
                {item.title}
              </h3>
            </div>

            <!-- Narrative / Description (Punchy 1-Liner) -->
            <p class="text-neutral-400 text-xs sm:text-sm leading-relaxed font-light">
              {item.description}
            </p>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

