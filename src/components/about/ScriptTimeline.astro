---
interface Milestone {
  year: string;
  draftLabel: string;
  takeNumber?: string;
  title: string;
  description: string;
  badge?: string;
}

interface Props {
  timelineHeading: string;
  timelineTag?: string;
  timelineDescription?: string;
  milestones: Milestone[];
}

const {
  timelineHeading,
  timelineTag = "STUDIO TIMELINE",
  timelineDescription,
  milestones = [],
} = Astro.props;

// Asterisk gradient heading parser
const parseHeading = (text: string) => {
  if (!text) return "";
  if (text.includes('*')) {
    return text.replace(/\*(.*?)\*/g, '<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600">$1</span>');
  }
  return text;
};
---

<section class="max-w-7xl mx-auto px-6 py-20 sm:py-28 border-t border-line" id="timeline-section">
  
  <!-- Standardized Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-14 border-b border-line pb-8">
    <div>
      {timelineTag && (
        <div class="flex items-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
            {timelineTag}
          </span>
        </div>
      )}
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight" set:html={parseHeading(timelineHeading)} />
      {timelineDescription && (
        <p class="text-neutral-400 text-sm sm:text-base max-w-xl mt-3 font-light leading-relaxed">
          {timelineDescription}
        </p>
      )}
    </div>
  </div>

  <!-- Studio Evolution Spine & Cards -->
  <div class="relative max-w-4xl mx-auto pt-4">
    
    <!-- Central/Left Spine Track -->
    <div class="absolute left-4 sm:left-8 top-4 bottom-8 w-px bg-gradient-to-b from-amber-500 via-line to-transparent" aria-hidden="true"></div>

    <!-- Timeline Items -->
    <div class="space-y-8 sm:space-y-12">
      {milestones.map((item, idx) => (
        <div class="relative pl-12 sm:pl-20 group">
          
          <!-- Timeline Node -->
          <div class="absolute left-4 sm:left-8 top-2 -translate-x-1/2 w-4 h-4 rounded-full border-2 border-line bg-neutral-950 group-hover:border-amber-400 group-hover:bg-amber-400/20 transition-all duration-300 flex items-center justify-center shadow-lg">
            <span class="w-1.5 h-1.5 rounded-full bg-neutral-600 group-hover:bg-amber-400 transition-colors"></span>
          </div>

          <!-- Milestone Architectural Card -->
          <div class="p-6 sm:p-8 rounded-xl sm:rounded-2xl border border-line bg-neutral-900/40 hover:border-amber-500/60 hover:bg-neutral-900/70 transition-all duration-300 shadow-xl hover:-translate-y-1">
            
            <!-- Top Metadata Row -->
            <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-4 border-b border-white/5 text-xs font-mono">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-amber-400 font-semibold tracking-wider uppercase text-[10px]">
                  {item.draftLabel}
                </span>
                {item.badge && (
                  <span class="text-neutral-500 uppercase tracking-widest text-[10px] hidden sm:inline">
                    [{item.badge}]
                  </span>
                )}
              </div>

              <div class="flex items-center gap-3">
                {item.takeNumber && (
                  <span class="text-neutral-500 text-[11px]">{item.takeNumber}</span>
                )}
                <span class="text-xl sm:text-2xl font-black text-white font-mono tracking-tight group-hover:text-amber-400 transition-colors">
                  {item.year}
                </span>
              </div>
            </div>

            <!-- Main Title -->
            <h3 class="text-lg sm:text-xl font-bold text-white tracking-tight mb-2.5 group-hover:text-amber-400 transition-colors leading-snug">
              {item.title}
            </h3>

            <!-- Narrative / Description -->
            <p class="text-neutral-400 text-xs sm:text-sm leading-relaxed font-light">
              {item.description}
            </p>

            <!-- Bottom Sub-Indicator -->
            <div class="pt-4 mt-5 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-neutral-500 group-hover:text-neutral-400 transition-colors">
              <span>Milestone 0{idx + 1} of 0{milestones.length}</span>
              <span class="w-1.5 h-1.5 rounded-full bg-neutral-700 group-hover:bg-amber-400 transition-colors"></span>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

