---
import { parseSectionHeading as parseHeading } from '../../utils/headingParser';

interface SlideItem {
  name: string;
  formalRole?: string;
  bio?: string;
  avatar?: string;
  videoLoop?: string;
  badge?: string;
}

interface SliderData {
  heading?: string;
  tag?: string;
  description?: string;
  slides?: SlideItem[];
}

interface Props {
  slider?: SliderData;
  heading?: string;
  tag?: string;
  description?: string;
  slides?: SlideItem[];
  teamHeading?: string;
  teamTag?: string;
  teamDescription?: string;
  teamMembers?: SlideItem[];
}

const {
  slider,
  heading = slider?.heading,
  tag = slider?.tag,
  description = slider?.description,
  slides = slider?.slides,
  teamHeading = heading || "The Crew & BTS",
  teamTag = tag,
  teamDescription = description,
  teamMembers = slides || [],
} = Astro.props;

const totalSlides = teamMembers.length;
const hasMultipleSlides = totalSlides > 1;
---

<section class="py-20 md:py-32 border-b border-neutral-900 bg-neutral-950" id="team-section">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Standardized Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16">
      <div class="max-w-3xl">
        {teamTag && (
          <span class="text-xs uppercase tracking-[0.25em] text-amber-500 font-mono font-bold block mb-3">
            {teamTag}
          </span>
        )}
        <h2 
          class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-4"
          set:html={parseHeading(teamHeading)}
        />
        {teamDescription && (
          <p class="text-neutral-400 text-base sm:text-lg leading-relaxed font-light">
            {teamDescription}
          </p>
        )}
      </div>

      <!-- Header Right: Slider Navigation Controls (Shown only when 2+ slides exist) -->
      {hasMultipleSlides && (
        <div class="flex items-center gap-3 self-start md:self-auto shrink-0 bg-neutral-900/80 border border-neutral-800 rounded-full px-4 py-2 backdrop-blur-md shadow-lg">
          <span id="slider-counter" class="text-xs font-mono font-semibold tracking-widest text-neutral-400 select-none">
            <span class="text-amber-500 font-bold" id="slider-current-num">01</span>
            <span class="text-neutral-600 mx-1">/</span>
            <span>{String(totalSlides).padStart(2, '0')}</span>
          </span>
          <div class="h-3.5 w-px bg-neutral-800"></div>
          <div class="flex items-center gap-1.5">
            <button
              type="button"
              id="crew-prev-btn"
              aria-label="Previous slide"
              class="w-8 h-8 rounded-full bg-neutral-800 hover:bg-neutral-700 hover:text-amber-400 text-neutral-200 flex items-center justify-center transition-all active:scale-90 focus:outline-none focus:ring-1 focus:ring-amber-500"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <button
              type="button"
              id="crew-next-btn"
              aria-label="Next slide"
              class="w-8 h-8 rounded-full bg-neutral-800 hover:bg-neutral-700 hover:text-amber-400 text-neutral-200 flex items-center justify-center transition-all active:scale-90 focus:outline-none focus:ring-1 focus:ring-amber-500"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      )}
    </div>

    <!-- Main Cinematic Video Showcase: Full Photo at rest, Title reveals on hover/tap -->
    {hasMultipleSlides ? (
      /* Multi-Slide Mode: Smooth Horizontal Scroll-Snap Track */
      <div
        id="crew-slider-track"
        class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar rounded-2xl sm:rounded-3xl pb-2 focus:outline-none"
        tabindex="0"
        role="region"
        aria-label="Production Crew & BTS Slider"
      >
        {teamMembers.map((member, index) => (
          <div
            class="crew-slide w-full shrink-0 snap-center relative aspect-[16/10] sm:aspect-16/9 rounded-2xl sm:rounded-3xl overflow-hidden border border-neutral-800 bg-black shadow-2xl group cursor-pointer focus:outline-none transition-all duration-300 hover:border-amber-500/60 focus:border-amber-500/60"
            data-slide-index={index}
            tabindex="0"
          >
            <!-- Full-Card Media (Video or Image) -->
            {member.videoLoop ? (
              <video
                loop
                muted
                playsinline
                autoplay
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 group-focus:scale-105"
              >
                <source src={member.videoLoop} type="video/mp4" />
              </video>
            ) : member.avatar ? (
              <img
                src={member.avatar}
                alt={member.name}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 group-focus:scale-105"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center bg-neutral-950 text-neutral-700 font-mono text-2xl font-bold">
                FILMEDITRUN
              </div>
            )}

            <!-- Smooth darkening scrim on hover / tap only -->
            <div 
              class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-400 ease-out"
              aria-hidden="true"
            ></div>

            <!-- Title, Badge & Bio: Revealed on hover / tap -->
            <figcaption class="absolute inset-x-0 bottom-0 p-6 sm:p-10 pointer-events-none z-10 bg-transparent">
              <div class="transform translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-400 ease-out max-w-2xl">
                {member.badge && (
                  <span class="inline-block px-2.5 py-1 rounded-md bg-amber-500/20 border border-amber-500/30 text-amber-400 text-[10px] sm:text-xs font-mono uppercase tracking-wider font-semibold mb-2 sm:mb-3 backdrop-blur-md">
                    {member.badge}
                  </span>
                )}
                <h3 class="text-xl sm:text-3xl md:text-4xl font-black text-white keep-white tracking-tight drop-shadow-lg leading-tight">
                  {member.name}
                </h3>
              </div>
            </figcaption>
          </div>
        ))}
      </div>
    ) : teamMembers.length > 0 ? (
      /* Single-Card Mode: Full Photo at rest, Title reveals on hover/tap */
      <div 
        tabindex="0"
        role="region"
        aria-label={teamMembers[0].name}
        class="relative aspect-[16/10] sm:aspect-16/9 w-full rounded-2xl sm:rounded-3xl overflow-hidden border border-neutral-800 bg-black shadow-2xl group cursor-pointer focus:outline-none transition-all duration-300 hover:border-amber-500/60 focus:border-amber-500/60"
      >
        <!-- Full-Card Media (Video or Image) -->
        {teamMembers[0].videoLoop ? (
          <video
            loop
            muted
            playsinline
            autoplay
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 group-focus:scale-105"
          >
            <source src={teamMembers[0].videoLoop} type="video/mp4" />
          </video>
        ) : teamMembers[0].avatar ? (
          <img
            src={teamMembers[0].avatar}
            alt={teamMembers[0].name}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 group-focus:scale-105"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="absolute inset-0 flex items-center justify-center bg-neutral-950 text-neutral-700 font-mono text-2xl font-bold">
            FILMEDITRUN
          </div>
        )}

        <!-- Smooth darkening scrim on hover / tap only -->
        <div 
          class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-400 ease-out"
          aria-hidden="true"
        ></div>

        <!-- Title, Badge & Bio: Revealed on hover / tap -->
        <figcaption class="absolute inset-x-0 bottom-0 p-6 sm:p-10 pointer-events-none z-10 bg-transparent">
          <div class="transform translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-400 ease-out max-w-2xl">
            {teamMembers[0].badge && (
              <span class="inline-block px-2.5 py-1 rounded-md bg-amber-500/20 border border-amber-500/30 text-amber-400 text-[10px] sm:text-xs font-mono uppercase tracking-wider font-semibold mb-2 sm:mb-3 backdrop-blur-md">
                {teamMembers[0].badge}
              </span>
            )}
            <h3 class="text-xl sm:text-3xl md:text-4xl font-black text-white keep-white tracking-tight drop-shadow-lg leading-tight">
              {teamMembers[0].name}
            </h3>
          </div>
        </figcaption>
      </div>
    ) : null}

    <!-- Bottom Indicator Dots (Rendered only when 2+ slides exist) -->
    {hasMultipleSlides && (
      <div class="flex items-center justify-center gap-2 mt-6" id="crew-slider-dots">
        {teamMembers.map((_, index) => (
          <button
            type="button"
            class={`crew-slider-dot h-1.5 rounded-full transition-all duration-300 focus:outline-none focus:ring-1 focus:ring-amber-500 ${
              index === 0 ? "w-6 bg-amber-500" : "w-1.5 bg-neutral-700 hover:bg-neutral-500"
            }`}
            data-target-index={index}
            aria-label={`Go to slide ${index + 1}`}
          />
        ))}
      </div>
    )}

  </div>
</section>

<script>
  function setupCrewSlider() {
    const track = document.getElementById("crew-slider-track") as HTMLDivElement | null;
    const prevBtn = document.getElementById("crew-prev-btn") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("crew-next-btn") as HTMLButtonElement | null;
    const currentNum = document.getElementById("slider-current-num") as HTMLSpanElement | null;
    const dots = document.querySelectorAll(".crew-slider-dot") as NodeListOf<HTMLButtonElement>;
    const slides = document.querySelectorAll(".crew-slide") as NodeListOf<HTMLDivElement>;

    if (!track || slides.length <= 1) return;

    let activeIndex = 0;

    function updateActiveUI(index: number) {
      if (index === activeIndex) return;
      activeIndex = index;

      if (currentNum) {
        currentNum.textContent = String(index + 1).padStart(2, "0");
      }

      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.className = "crew-slider-dot h-1.5 rounded-full transition-all duration-300 focus:outline-none focus:ring-1 focus:ring-amber-500 w-6 bg-amber-500";
        } else {
          dot.className = "crew-slider-dot h-1.5 rounded-full transition-all duration-300 focus:outline-none focus:ring-1 focus:ring-amber-500 w-1.5 bg-neutral-700 hover:bg-neutral-500";
        }
      });
    }

    function scrollToSlide(index: number) {
      if (!track || !slides[index]) return;
      const targetSlide = slides[index];
      const targetLeft = targetSlide.offsetLeft - track.offsetLeft;
      track.scrollTo({ left: targetLeft, behavior: "smooth" });
      updateActiveUI(index);
    }

    nextBtn?.addEventListener("click", () => {
      const nextIndex = (activeIndex + 1) % slides.length;
      scrollToSlide(nextIndex);
    });

    prevBtn?.addEventListener("click", () => {
      const prevIndex = (activeIndex - 1 + slides.length) % slides.length;
      scrollToSlide(prevIndex);
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => {
        scrollToSlide(idx);
      });
    });

    // Track scroll listener to update dots/counter on manual swipe or scroll
    let scrollTimeout: NodeJS.Timeout | number;
    track.addEventListener("scroll", () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        if (!track) return;
        const scrollLeft = track.scrollLeft;
        const slideWidth = track.clientWidth;
        const calculatedIndex = Math.min(
          slides.length - 1,
          Math.max(0, Math.round(scrollLeft / slideWidth))
        );
        updateActiveUI(calculatedIndex);
      }, 60);
    }, { passive: true });

    // Keyboard navigation when slider track has focus
    track.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        const nextIndex = (activeIndex + 1) % slides.length;
        scrollToSlide(nextIndex);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        const prevIndex = (activeIndex - 1 + slides.length) % slides.length;
        scrollToSlide(prevIndex);
      }
    });
  }

  setupCrewSlider();
  document.addEventListener("astro:page-load", setupCrewSlider);
</script>
