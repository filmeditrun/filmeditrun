---
interface Props {
  tag?: string;
  headline: string;
  manifestoLead: string;
  manifestoQuote?: string;
  manifestoAuthor?: string;
  heroBackgroundType?: "video" | "image" | "gradient" | string;
  heroVideoPath?: string;
  heroImagePath?: string;
  heroGradientDirection?: string;
  heroGradientColor1?: string;
  heroGradientColor2?: string;
  heroFrostedGlass?: "none" | "very-subtle" | "subtle" | "medium" | "strong" | string;
}

const {
  tag,
  headline,
  manifestoLead,
  manifestoQuote,
  manifestoAuthor,
  heroBackgroundType = "video",
  heroVideoPath,
  heroImagePath = "/og-image.jpg",
  heroGradientDirection = "to bottom right",
  heroGradientColor1 = "#180d2b",
  heroGradientColor2 = "#09090c",
  heroFrostedGlass = "very-subtle",
} = Astro.props;

// Parse headline: support asterisks for gradient highlight, or fallback to period split
const parseHeadline = (text: string) => {
  if (!text) return "";
  if (text.includes("*")) {
    return text.replace(/\*(.*?)\*/g, '<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">$1</span>');
  }
  const dotIndex = text.indexOf('. ');
  if (dotIndex !== -1) {
    const prefix = text.slice(0, dotIndex + 1);
    const accent = text.slice(dotIndex + 2);
    return `<span class="block mb-2">${prefix}</span><span class="block text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">${accent}</span>`;
  }
  return text;
};

const ndDensityMap: Record<string, string> = {
  none: "opacity-0",
  "very-subtle": "opacity-60",
  subtle: "opacity-75",
  medium: "opacity-85",
  strong: "opacity-95",
};
const ndDensityClass = ndDensityMap[heroFrostedGlass] ?? "opacity-80";

// Fallback logic for background type
const bgType = heroBackgroundType || (heroVideoPath ? "video" : "gradient");
const isRadial = heroGradientDirection === "radial";
const gradientStyle = isRadial
  ? `background: radial-gradient(circle at center, ${heroGradientColor1} 0%, ${heroGradientColor2} 100%);`
  : `background: linear-gradient(${heroGradientDirection}, ${heroGradientColor1} 0%, ${heroGradientColor2} 100%);`;
---

<section data-cinema-darkroom class="relative overflow-hidden pt-28 pb-20 sm:pt-36 md:pt-40 md:pb-32 border-b border-neutral-900 select-none">
  <!-- Media Backdrop Layer (Video, Image, or Dual-Tone Gradient) -->
  <div class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden bg-black">
    <!-- Master Cinematic Directional ND Filter (Unified Site-Wide Standard) -->
    <div 
      class:list={[
        "absolute inset-0 bg-gradient-to-b from-black/50 via-black/60 to-black/90 z-10 pointer-events-none transition-opacity duration-500",
        ndDensityClass
      ]} 
      aria-hidden="true"
    />

    {/* 1. Video Background */}
    {bgType === "video" && heroVideoPath && (
      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster={heroImagePath}
        class="w-full h-full object-cover opacity-90 sm:opacity-95 z-0"
      >
        <source src={heroVideoPath} type="video/mp4" />
      </video>
    )}

    {/* 2. Static Photograph / Image Background */}
    {bgType === "image" && heroImagePath && (
      <img
        src={heroImagePath}
        alt={headline || "FilmEditRun Studio"}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover opacity-85 sm:opacity-90 z-0"
      />
    )}

    {/* 3. Dual-Tone Gradient Background */}
    {bgType === "gradient" && (
      <div
        class="w-full h-full z-0"
        style={gradientStyle}
        aria-hidden="true"
      />
    )}
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-6">
    <!-- Eyebrow Tag -->
    <div class="inline-flex items-center gap-2 mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
      <span class="text-xs uppercase tracking-widest text-amber-500 font-mono font-semibold">
        {tag || "STUDIO ETHOS"}
      </span>
    </div>

    <!-- Large Title with Asterisk Gradient Support -->
    <h1 
      class="text-4xl sm:text-6xl xl:text-7xl font-black tracking-tight text-white keep-white leading-[1.08] mb-8 max-w-4xl text-balance"
      set:html={parseHeadline(headline)}
    />

    <!-- Hero Lead Hook / Value Proposition -->
    <p class="text-base sm:text-lg lg:text-xl text-neutral-300 font-normal leading-relaxed tracking-[-0.01em] max-w-2xl mb-10 keep-white">
      {manifestoLead}
    </p>

    <!-- Quick Jump Navigation Pills -->
    <div class="flex flex-wrap items-center gap-4 pt-2 font-mono text-xs">
      <a
        href="#team-section"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold uppercase tracking-wider transition-all shadow-xl shadow-amber-500/10 hover:scale-[1.02]"
      >
        <span>Meet The Crew</span>
        <span class="text-sm font-sans">&darr;</span>
      </a>
      <a
        href="/services"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/5 border border-line hover:border-amber-500/50 hover:bg-white/10 uppercase tracking-wider text-white transition-all shadow-lg"
      >
        <span>Explore Services &rarr;</span>
      </a>
    </div>
  </div>
</section>
