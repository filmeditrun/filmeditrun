---
interface Props {
  headline: string;
  manifestoLead: string;
  manifestoQuote?: string;
  manifestoAuthor?: string;
  heroVideoPath?: string;
  heroFrostedGlass?: "none" | "very-subtle" | "subtle" | "medium" | "strong" | string;
}

const {
  headline,
  manifestoLead,
  manifestoQuote,
  manifestoAuthor,
  heroVideoPath,
  heroFrostedGlass = "very-subtle",
} = Astro.props;

// Split headline into prefix statement and highlighted accent if period present
const dotIndex = headline.indexOf('. ');
const hasSplit = dotIndex !== -1;
const headlinePrefix = hasSplit ? headline.slice(0, dotIndex + 1) : headline;
const headlineAccent = hasSplit ? headline.slice(dotIndex + 2) : '';

const ndDensityMap: Record<string, string> = {
  none: "opacity-0",
  "very-subtle": "opacity-60",
  subtle: "opacity-75",
  medium: "opacity-85",
  strong: "opacity-95",
};
const ndDensityClass = ndDensityMap[heroFrostedGlass] ?? "opacity-80";
---

<section data-cinema-darkroom class="relative overflow-hidden pt-28 pb-20 sm:pt-36 md:pt-40 md:pb-32 border-b border-neutral-900 select-none">
  <!-- Clear, Bright Video Background with Master Cinematic ND Filter -->
  {heroVideoPath && (
    <div class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden bg-black">
      <!-- Master Cinematic Directional ND Filter (Unified Site-Wide Standard) -->
      <div 
        class:list={[
          "absolute inset-0 bg-gradient-to-b from-black/50 via-black/60 to-black/90 z-10 pointer-events-none transition-opacity duration-500",
          ndDensityClass
        ]} 
        aria-hidden="true"
      />

      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        class="w-full h-full object-cover opacity-90 sm:opacity-95 z-0"
      >
        <source src={heroVideoPath} type="video/mp4" />
      </video>
    </div>
  )}

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: The Main Punchline & Quick Navigation (7 cols) -->
      <div class="lg:col-span-7">
        <!-- Eyebrow Tag -->
        <div class="inline-flex items-center gap-2 mb-6">
          <span class="h-px w-8 bg-amber-500"></span>
          <span class="text-xs uppercase tracking-[0.25em] text-amber-500 font-mono font-bold">
            Studio Manifesto
          </span>
        </div>

        <!-- 2-Tone Editorial Display Title -->
        <h1 class="text-4xl sm:text-6xl xl:text-7xl font-black tracking-tight text-white keep-white leading-[1.06] mb-8">
          <span class="block text-white keep-white mb-2">{headlinePrefix}</span>
          {headlineAccent && (
            <span class="block text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">
              {headlineAccent}
            </span>
          )}
        </h1>

        <!-- Manifesto Lead Hook -->
        <p class="text-lg sm:text-xl text-neutral-200 font-light leading-relaxed max-w-2xl mb-10 keep-white">
          {manifestoLead}
        </p>

        <!-- Quick Jump Navigation Pills -->
        <div class="flex flex-wrap items-center gap-3 pt-2 font-mono text-xs">
          <a
            href="#team-section"
            class="px-5 py-3 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 text-neutral-950 font-bold hover:from-amber-300 hover:to-amber-500 transition-all shadow-lg shadow-amber-500/15 flex items-center gap-2 hover:scale-[1.02]"
          >
            <span>Production Showcase</span>
            <span class="text-sm font-sans">↓</span>
          </a>
          <a
            href="/work"
            class="px-5 py-3 rounded-xl border border-white/15 bg-neutral-950/70 backdrop-blur-md text-neutral-300 hover:text-white hover:border-amber-500/50 transition-all"
          >
            Watch Work &rarr;
          </a>
        </div>
      </div>

      <!-- Right Column: Featured Studio Creed Glass Card (5 cols) -->
      {manifestoQuote && (
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl border border-white/12 bg-neutral-950/80 backdrop-blur-2xl p-8 sm:p-10 shadow-[0_25px_60px_rgba(0,0,0,0.85)] overflow-hidden">
            <!-- Subtle Gold Accent Light in Top Corner -->
            <div class="absolute -top-12 -right-12 w-40 h-40 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Slate Header Metadata Bar -->
            <div class="flex items-center justify-between pb-6 mb-6 border-b border-white/10 text-xs font-mono">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                <span class="font-bold tracking-wider text-white uppercase text-[11px]">STUDIO CREED</span>
              </div>
              <span class="text-[10px] tracking-widest text-neutral-500 uppercase">
                DIRECTOR&apos;S CUT
              </span>
            </div>

            <!-- Editorial Quote Content -->
            <div class="relative mb-6">
              <span class="text-4xl sm:text-5xl text-amber-500/40 font-serif leading-none select-none block -mb-4">
                &ldquo;
              </span>
              <blockquote class="text-base sm:text-lg text-neutral-100 font-light leading-relaxed italic pl-3 border-l-2 border-amber-500/40">
                {manifestoQuote}
              </blockquote>
            </div>

            <!-- Quote Author / Attribution Footer -->
            <div class="pt-6 border-t border-white/10 flex items-center justify-between text-xs font-mono">
              {manifestoAuthor && (
                <div class="flex items-center gap-2 text-amber-400 font-semibold uppercase tracking-wider text-[11px]">
                  <span>{manifestoAuthor}</span>
                </div>
              )}
              <span class="text-neutral-500 text-[10px] uppercase tracking-widest hidden sm:inline">
                TAKE 01 // 24 FPS
              </span>
            </div>
          </div>
        </div>
      )}

    </div>
  </div>
</section>
