---
import { parseHeroHeading } from '../../utils/headingParser';

interface Props {
  tag?: string;
  headline: string;
  manifestoLead: string;
  heroBackgroundType?: "video" | "image" | "gradient" | string;
  heroVideoPath?: string;
  heroImagePath?: string;
  heroGradientDirection?: string;
  heroGradientColor1?: string;
  heroGradientColor2?: string;
  heroFrostedGlass?: "none" | "very-subtle" | "subtle" | "medium" | "strong" | string;
}

const {
  tag,
  headline,
  manifestoLead,
  heroBackgroundType = "video",
  heroVideoPath,
  heroImagePath = "/og-image.jpg",
  heroGradientDirection = "to bottom right",
  heroGradientColor1 = "#180d2b",
  heroGradientColor2 = "#09090c",
  heroFrostedGlass = "very-subtle",
} = Astro.props;

const ndDensityMap: Record<string, string> = {
  none: "opacity-0",
  "very-subtle": "opacity-60",
  subtle: "opacity-75",
  medium: "opacity-85",
  strong: "opacity-95",
};
const ndDensityClass = ndDensityMap[heroFrostedGlass] ?? "opacity-80";

// Fallback logic for background type
const bgType = heroBackgroundType || (heroVideoPath ? "video" : "gradient");
const isRadial = heroGradientDirection === "radial";
const gradientStyle = isRadial
  ? `background: radial-gradient(circle at center, ${heroGradientColor1} 0%, ${heroGradientColor2} 100%);`
  : `background: linear-gradient(${heroGradientDirection}, ${heroGradientColor1} 0%, ${heroGradientColor2} 100%);`;
---

<header data-cinema-darkroom class="relative w-full pt-28 pb-14 sm:pt-36 sm:pb-24 lg:pt-40 lg:pb-28 sm:min-h-[600px] lg:min-h-[640px] flex flex-col justify-center overflow-hidden border-b border-white/10 select-none">
  <!-- Media Backdrop Layer (Video, Image, or Dual-Tone Gradient) -->
  <div class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden bg-black">
    <!-- Master Cinematic Directional ND Filter (Unified Site-Wide Standard) -->
    <div 
      class:list={[
        "absolute inset-0 bg-gradient-to-b from-black/50 via-black/60 to-black/90 z-10 pointer-events-none transition-opacity duration-500",
        ndDensityClass
      ]} 
      aria-hidden="true"
    />

    <!-- Ambient Amber Spotlight Glow at Top Center -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[40rem] sm:w-[56rem] h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none z-10" aria-hidden="true"></div>

    {/* 1. Video Background */}
    {bgType === "video" && heroVideoPath && (
      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster={heroImagePath}
        class="absolute inset-0 w-full h-full object-cover opacity-90 sm:opacity-95 z-0"
      >
        <source src={heroVideoPath} type="video/mp4" />
      </video>
    )}

    {/* 2. Static Photograph / Image Background */}
    {bgType === "image" && heroImagePath && (
      <img
        src={heroImagePath}
        alt={headline || "FilmEditRun Studio"}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover opacity-85 sm:opacity-90 z-0"
      />
    )}

    {/* 3. Dual-Tone Gradient Background */}
    {bgType === "gradient" && (
      <div
        class="absolute inset-0 w-full h-full z-0"
        style={gradientStyle}
        aria-hidden="true"
      />
    )}
  </div>

  <div class="relative z-20 max-w-6xl mx-auto px-6 w-full">
    <!-- Studio Category Eyebrow Badge -->
    <div class="mb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono uppercase tracking-widest font-semibold backdrop-blur-md bg-amber-500/10 border border-amber-500/25 text-amber-400 shadow-sm shadow-amber-500/10 select-none">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span>{tag || "STUDIO ETHOS"}</span>
      </div>
    </div>

    <!-- Large Title with Asterisk Gradient Support -->
    <h1 
      class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white keep-white leading-[1.08] mb-6 max-w-4xl text-balance"
      set:html={parseHeroHeading(headline)}
    />

    <!-- Hero Lead Hook / Value Proposition -->
    <p class="text-base sm:text-lg lg:text-xl text-neutral-300 font-normal leading-relaxed tracking-[-0.01em] max-w-2xl mb-8 keep-white">
      {manifestoLead}
    </p>

    <!-- Primary & Secondary Navigation Actions -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
      <a
        href="#team-section"
        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-neutral-950 font-bold text-base transition-all shadow-xl shadow-amber-500/20 hover:scale-[1.02] text-center"
      >
        <span>Meet The Crew</span>
        <span class="text-lg leading-none">&darr;</span>
      </a>
      <a
        href="/services"
        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-white/5 border border-white/15 hover:border-amber-500/50 hover:bg-white/10 text-white font-medium text-base transition-all shadow-lg text-center"
      >
        <span>Explore Services &rarr;</span>
      </a>
    </div>
  </div>
</header>
